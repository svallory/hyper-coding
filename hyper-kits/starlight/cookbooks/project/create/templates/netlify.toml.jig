---
to: "{{ kebabCase :: name }}/netlify.toml"
---
[build]
  command = "bun run build"
  publish = "dist-docs"

[[headers]]
  for = "/llms.txt"
  [headers.values]
    Content-Type = "text/plain; charset=utf-8"

[[headers]]
  for = "/llms-full.txt"
  [headers.values]
    Content-Type = "text/plain; charset=utf-8"
