---
to: "{{ kebabCase :: name }}/package.json"
---
{
  "name": "{{ kebabCase :: name }}-docs",
  "version": "1.0.0",
  "description": "Documentation site for {{ name }}",
  "type": "module",
  "scripts": {
    "build": "astro build",
    "dev": "astro dev",
    "preview": "astro preview",
    "astro": "astro"
  },
  "packageManager": "bun",
  "dependencies": {
    "astro-d2": "^0.10.0",
    "starlight-image-zoom": "^0.14.1",
    "starlight-links-validator": "^0.21.0",
    "starlight-llms-txt": "^0.8.0"
@if(!autoSidebar)
    ,"starlight-sidebar-topics": "^0.7.1"
@endif
@if(typedoc)
    ,"starlight-typedoc": "^0.21.5"
@endif
@if(openapi)
    ,"starlight-openapi": "^0.24.0"
@endif
@if(keyboard)
    ,"starlight-kbd": "^0.4.0"
@endif
@if(autoSidebar)
    ,"starlight-auto-sidebar": "^0.2.0"
@endif
@if(scrollToTop)
    ,"starlight-scroll-to-top": "^1.0.1"
@endif
@if(changelogs)
    ,"starlight-changelogs": "^0.5.0"
@endif
@if(obsidian)
    ,"starlight-obsidian": "^0.12.1"
@endif
@if(pageActions)
    ,"starlight-page-actions": "^0.5.0"
@endif
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.38.2",
    "@astrojs/tailwind": "^6.0.2",
    "astro": "^6.1.3",
    "tailwindcss": "^4.2.2"
@if(typedoc)
    ,"typedoc": "^0.28.18",
    "typedoc-plugin-markdown": "^4.11.0"
@endif
  },
  "engines": {
    "node": ">=22"
  }
}
