{
	"hooks": {
		"SessionEnd": [
			{
				"matcher": "logout",
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hyper-hook.sh\" hyper-drive-session-end.sh",
						"timeout": 60
					}
				]
			},
			{
				"matcher": "prompt_input_exit",
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hyper-hook.sh\" hyper-drive-session-end.sh",
						"timeout": 60
					}
				]
			},
			{
				"matcher": "other",
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hyper-hook.sh\" hyper-drive-session-end.sh",
						"timeout": 60
					}
				]
			}
		],
		"SessionStart": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hyper-hook.sh\" hyper-context.sh",
						"timeout": 5
					}
				]
			}
		],
		"PostToolUse": [
			{
				"matcher": "Edit|Write|NotebookEdit",
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hyper-hook.sh\" hyper-check.sh",
						"timeout": 90
					}
				]
			},
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "/bin/sh \"${CLAUDE_PLUGIN_ROOT}/scripts/hyper-hook.sh\" hyper-deps.sh",
						"timeout": 10
					}
				]
			}
		]
	}
}
