#!/usr/bin/env bash
# landverdict FILE — SHIP_LOOP_AFTER_LOOKUP seam for ship-loop: writes $LANDVERDICT_SRC to FILE when FILE is
# not there yet and its base name is $LANDVERDICT_NAME. It lands a verdict in the window between the
# driver's two looks at a stage in flight.
[[ "$(basename "$1")" == "${LANDVERDICT_NAME:-}" && ! -e "$1" ]] || exit 0
cp "${LANDVERDICT_SRC:?}" "$1.tmp" && mv "$1.tmp" "$1"
