#!/usr/bin/env bash
# stub-agent STATE_DIR SCRIPT_DIR — plays every agent of a ship-loop test.
#
# ship-loop appends one line to <verdict>.json.sent each time it prompts an agent
# for that verdict file, and deletes the verdict first. This stub watches those
# markers: when a verdict file has more prompts than answers and does not exist, it
# writes it from SCRIPT_DIR:
#   SCRIPT_DIR/<verdict>.json.<N>   the Nth answer for that file, else
#   SCRIPT_DIR/<verdict>.json       every answer
# A scripted file that does not exist yet means the agent is "still working": the
# stub waits, so a test can add the file later. SCRIPT_DIR/<verdict>.json.hook, when
# executable, runs just before the answer is written (it plays the agent's side
# effects: commits, resolving a rebase). Run it in the background and kill it when
# the scenario ends.
state="${1:?state dir}" script="${2:?script dir}"
mkdir -p "$script/.done"
inode() { stat -c %i "$1" 2>/dev/null || stat -f %i "$1"; }
# put <file> <text> — atomic, so a reader never sees a half-written counter
put() { printf '%s\n' "$2" >"$1.tmp.$$" && mv -f "$1.tmp.$$" "$1"; }
# Two counters per verdict file, both under .done/: <b> is how many answers were given (it picks the
# scripted <b>.N), <b>.seen is the identity of the .sent marker (its inode and its first line) and the number
# of its lines already answered. A marker that was archived, deleted or recreated has another identity, so its
# prompts count from zero again; none is lost. The first line counts because a recreated file can reuse the inode.
while :; do
  for sent in "$state"/*.sent; do
    [[ -e "$sent" ]] || continue
    f="${sent%.sent}"
    b="$(basename "$f")"
    ino="$(inode "$sent") $(head -n 1 "$sent")"
    prompts="$(wc -l <"$sent" | tr -d ' ')"
    answered="$(cat "$script/.done/$b" 2>/dev/null)"; answered="${answered:-0}"
    { IFS= read -r seen_ino; read -r seen_n; } <"$script/.done/$b.seen" 2>/dev/null || { seen_ino="" seen_n=0; }
    seen_n="${seen_n:-0}"
    [[ "$seen_ino" == "$ino" ]] || seen_n=0
    [[ "$prompts" -gt "$seen_n" ]] || continue
    [[ ! -e "$f" ]] || continue
    next=$((answered + 1))
    src="$script/$b.$next"
    [[ -f "$src" ]] || src="$script/$b"
    [[ -f "$src" ]] || continue
    if [[ -x "$script/$b.hook" ]]; then "$script/$b.hook" || true; fi
    [[ -z "${STUB_DELAY:-}" ]] || sleep "$STUB_DELAY"
    cp "$src" "$f.tmp" && mv -f "$f.tmp" "$f"
    put "$script/.done/$b" "$next"
    put "$script/.done/$b.seen" "$ino
$((seen_n + 1))"
  done
  sleep 0.05
done
