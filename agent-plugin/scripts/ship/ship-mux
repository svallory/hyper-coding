#!/usr/bin/env bash
# ship-mux — the multiplexer seam of hyper:ship. This header is the one place the
# interface is documented.
#
# Scripts speak intents to ship-mux; the backend named by `mux:` in the merged
# ship config (scripts/ship/mux/<mux>) turns them into calls on one multiplexer.
# Nothing outside the real backend may call a multiplexer CLI directly. ids are
# opaque strings: callers store and pass them, and never parse them.
#
# Usage: ship-mux <verb> [flags]      (flags below; every flag takes one value)
#
# Every verb except `check` is scoped to a ref (--ref R) and may only touch ids
# recorded for that ref (see Ownership record). Anything else exits 3 with no
# backend call.
#
# Verbs
#   check
#       Is the backend usable here? Exit 0, or 1 with one line on stderr saying
#       what is missing.
#   open  --ref R --cwd D [--label L]
#       Open (or find) the unit's space for ref R, rooted at D, inside the units
#       group (`units_group`). Idempotent per ref: a second call returns the same
#       ids (with a different --cwd it still returns the existing space and warns
#       on stderr). stdout: {"space":id,"pane":id,"group":id}; `group` is present
#       when the backend has a units group. The pane is the space's root pane.
#   run   --ref R --pane P -- CMD...
#       Wait until pane P is ready for input, then run CMD in it as a shell
#       command. No stdout. Creates nothing, so nothing is recorded.
#   start --ref R --space S --name N --harness claude|pi --cwd D -- ARGS...
#       Start an agent named N in a new pane of space S, running the harness
#       with ARGS (which may be empty). The backend may shorten N internally.
#       stdout: {"agent":id,"pane":id}
#   send  --ref R --to A (--text T [--wait-ms N] | --keys K[,K...])
#       Send a prompt (--text; with --wait-ms, wait up to N ms for the agent to
#       start working, exit 4 if it does not) or key presses (--keys) to agent A.
#       A is an agent id; a pane id is an error. No stdout.
#   read  --ref R --to A|P [--lines N]
#       stdout: plain text of the agent's or pane's visible screen, or only its
#       last N lines.
#   status --ref R --to A
#       stdout: {"state":"working|idle|blocked|gone","pane":id,"space":id}. An
#       agent that no longer exists is state "gone" (exit 0).
#   wait  --ref R --to A --until working|idle|gone|ready --timeout-ms N
#       Block until the state is reached. `ready` means the pane accepts input.
#       Exit 0 reached, 4 timeout.
#   close --ref R --id X
#       Close pane, agent, space or the units group X. Refused with exit 3, and
#       no backend call, unless X is recorded for ref R (a group: recorded as
#       ship-created and with no space left). Closing an agent also closes its
#       pane; closing a pane drops the agents in it; closing a space drops
#       everything recorded under it. A space's root pane cannot be closed on its
#       own (exit 3: close the space). An id the backend no longer has counts as
#       closed: its entries are dropped and the exit is 0.
#   list  --ref R
#       stdout: [{"id","kind":"space|pane|agent","name","backend_name","state"}]
#       for the ids recorded for R that are still alive; [] when none are.
#       `name` is the caller's name from the record, `backend_name` the
#       backend's (it may be shortened). `state` is the agent state, else "".
#
# Keys (backend-neutral names for --keys, comma-separated): enter esc ctrl+c ctrl+d
#
# Exit codes (ship-mux)
#   0  ok                                  3  refused: id not recorded for the ref,
#   1  error (config, unknown backend,        root pane, or group not ship-created /
#      backend failure)                       not empty / renamed
#   2  usage error (verb, flag, value, ref)   4  timeout (wait; send --wait-ms)
#   99 a backend refused to run under SHIP_MUX_TEST=1 (the test guard)
#
# Backend contract
#   A backend is one bash file in scripts/ship/mux/ called as `<file> <verb>
#   <flags>` with the flags above, plus: open also gets --group NAME, list gets
#   --ids JSON (a JSON array of the recorded ids, instead of any ref mapping:
#   a backend keeps no ref mapping of its own). Its exit codes: 0 ok, 1 error,
#   4 timeout, 5 not found (a target, or for `close` an id it no longer has);
#   ship-mux maps 2 and 3 to 1 and passes 4, 5 (close only) and 99 through.
#   stdout as above, with these differences:
#     open   {"space","pane","group":{"id","created":bool,"name"}} — the
#            dispatcher records the group and prints the plain id.
#     list   [{"id","kind","name","state"}] for the ids in --ids that are alive;
#            a group id in --ids is reported with kind "group" and its name.
#   A backend refuses (exit 1) to close a group that still has children.
#   Ids it hands out must be stable for the life of the thing. Adding a backend =
#   one file + tests/test-t-ship-mux-<name>.sh running tests/lib/mux-contract.sh.
#
# Ownership record
#   open and start append what they created to <space root>/notes/loops/<ref>/
#   mux.json: {"backend":NAME,"created":[{"id","kind","name","space"?,"pane"?,
#   "group"?,"cwd"?,"root"?}]}. close removes what it closed. The units group is
#   recorded in <space root>/.hyper/ship-mux.json: {"groups":{ID:{"name",
#   "backend","created"}}}; `created` is true only when ship's own open created
#   it. The group closes only when ship created it, the backend still reports
#   its name for that id, and no notes/loops/*/mux.json holds a space entry in
#   it (computed at close time). Both files are rewritten under a lock
#   (<file>.lock/owner = pid@host); a lock whose owner died on this host, or that
#   is older than 120 s, is taken over.
#
# Config: `mux` (backend file name) and `units_group`, read through lib.sh. ship-mux
# does not need `gate`. The space root is $SHIP_SPACE_ROOT or the hyper CLI's.

# shellcheck disable=SC2034  # f_* are filled by printf -v; not every verb reads each
set -euo pipefail

# Resolve this script's directory through symlinks (bash 3.2, BSD readlink).
_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
  _link="$(readlink "$_src")"
  case "$_link" in /*) _src="$_link" ;; *) _src="$_dir/$_link" ;; esac
done
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
_dir="$(CDPATH='' cd -- "$_dir" && pwd -P)"
# shellcheck source=lib.sh
source "$_dir/lib.sh"

usage() { echo "ship-mux: $*" >&2; exit 2; }
fail() { echo "ship-mux: $*" >&2; exit 1; }
refuse() { echo "ship-mux: refused: $*" >&2; exit 3; }

verb="${1:-}"
case "$verb" in
  -h|--help) sed -n '2,/^$/p' "$_src" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
  "") usage "missing verb (try --help)" ;;
  check|open|run|start|send|read|status|wait|close|list) ;;
  *) usage "unknown verb '$verb' (try --help)" ;;
esac
shift

# Flags each verb accepts, and those it requires.
case "$verb" in
  check)  allowed="" required="" ;;
  open)   allowed="ref cwd label" required="ref cwd" ;;
  run)    allowed="ref pane" required="ref pane" ;;
  start)  allowed="ref space name harness cwd" required="ref space name harness cwd" ;;
  send)   allowed="ref to text keys wait_ms" required="ref to" ;;
  read)   allowed="ref to lines" required="ref to" ;;
  status) allowed="ref to" required="ref to" ;;
  wait)   allowed="ref to until timeout_ms" required="ref to until timeout_ms" ;;
  close)  allowed="ref id" required="ref id" ;;
  list)   allowed="ref" required="ref" ;;
esac

orig=("$@")
cmd=()
f_ref="" f_cwd="" f_label="" f_pane="" f_space="" f_name="" f_harness="" f_to=""
f_text="" f_keys="" f_wait_ms="" f_lines="" f_until="" f_timeout_ms="" f_id=""
seen=" "
while [[ $# -gt 0 ]]; do
  if [[ "$1" == "--" ]]; then
    shift
    [[ "$verb" == run || "$verb" == start ]] || usage "$verb takes no '--' command"
    cmd=("$@")
    break
  fi
  [[ "$1" == --* ]] || usage "$verb: unexpected argument '$1'"
  n="${1#--}"; n="${n//-/_}"
  case " $allowed " in *" $n "*) ;; *) usage "$verb: unknown flag '$1'" ;; esac
  [[ $# -ge 2 ]] || usage "$verb: $1 needs a value"
  case "$seen" in *" $n "*) usage "$verb: $1 given twice" ;; esac
  seen="$seen$n "
  printf -v "f_$n" '%s' "$2"
  shift 2
done

for n in $required; do
  case "$seen" in *" $n "*) ;; *) usage "$verb: --${n//_/-} is required" ;; esac
done
isint() { [[ "$1" =~ ^[0-9]+$ ]]; }
if [[ -n "$f_ref" ]]; then
  # The ref names a directory under notes/loops/.
  [[ "$f_ref" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || usage "$verb: invalid --ref '$f_ref' (letters, digits, '.', '_', '-'; must start with a letter or digit)"
fi
case "$seen" in *" id "*) [[ -n "$f_id" ]] || usage "close: --id is empty" ;; esac
case "$seen" in *" to "*) [[ -n "$f_to" ]] || usage "$verb: --to is empty" ;; esac
case "$verb" in
  run) [[ ${#cmd[@]} -gt 0 ]] || usage "run: a command is required after '--'" ;;
  start)
    case "$f_harness" in claude|pi) ;; *) usage "start: --harness must be claude or pi (got '$f_harness')" ;; esac ;;
  send)
    has_text=0 has_keys=0
    case "$seen" in *" text "*) has_text=1 ;; esac
    case "$seen" in *" keys "*) has_keys=1 ;; esac
    [[ $((has_text + has_keys)) -eq 1 ]] || usage "send: exactly one of --text or --keys is required"
    case "$seen" in *" wait_ms "*) [[ $has_text -eq 1 ]] || usage "send: --wait-ms only goes with --text"; isint "$f_wait_ms" || usage "send: --wait-ms must be an integer" ;; esac
    if [[ $has_keys -eq 1 ]]; then
      [[ -n "$f_keys" ]] || usage "send: --keys is empty"
      IFS=, read -r -a _keys <<<"$f_keys"
      for k in "${_keys[@]}"; do
        case "$k" in enter|esc|ctrl+c|ctrl+d) ;; *) usage "send: unknown key '$k' (keys: enter esc ctrl+c ctrl+d)" ;; esac
      done
    fi ;;
  read) case "$seen" in *" lines "*) isint "$f_lines" || usage "read: --lines must be an integer" ;; esac ;;
  wait)
    case "$f_until" in working|idle|gone|ready) ;; *) usage "wait: --until must be working, idle, gone or ready (got '$f_until')" ;; esac
    isint "$f_timeout_ms" || usage "wait: --timeout-ms must be an integer" ;;
esac

# --- config and backend ---------------------------------------------------------
ship_config_load || exit 1
mux="$(ship_cfg_get mux)" || fail "config key 'mux' is not set"
if [[ -z "$mux" || ! "$mux" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || ! -f "$_dir/mux/$mux" ]]; then
  fail "unknown mux backend '$mux' (config key mux): no such file scripts/ship/mux/$mux"
fi
backend="$_dir/mux/$mux"
units_group=""
units_group="$(ship_cfg_get units_group)" || [[ $? -eq 3 ]] || exit 1

# _be <verb> [args...] — run the backend; its exit 2 and 3 are ours, so map them to 1.
_be() {
  local rc=0
  bash "$backend" "$@" || rc=$?
  case "$rc" in 2|3) rc=1 ;; esac
  return "$rc"
}

if [[ "$verb" == check ]]; then
  rc=0; _be check || rc=$?; exit "$rc"
fi

root="$(ship_space_root)" || exit 1
loop_dir="$root/notes/loops/$f_ref"
rec="$loop_dir/mux.json"
grp="$root/.hyper/ship-mux.json"
ops="$root/.hyper/ship-mux.ops"

# --- locks and JSON files -----------------------------------------------------------
_held=()
_release_all() {
  local i
  for ((i = ${#_held[@]} - 1; i >= 0; i--)); do rm -rf "${_held[$i]}" 2>/dev/null || true; done
}
trap _release_all EXIT

_host="$(hostname 2>/dev/null || echo unknown)"

# _lock_stale <lockdir> — owner died on this host, or the lock is over 120 s old.
_lock_stale() {
  local d="$1" owner="" opid ohost
  [[ -d "$d" ]] || return 1
  [[ -f "$d/owner" ]] && owner="$(cat "$d/owner" 2>/dev/null || true)"
  if [[ "$owner" == *@* ]]; then
    opid="${owner%%@*}" ohost="${owner#*@}"
    if [[ "$ohost" == "$_host" && "$opid" =~ ^[0-9]+$ ]] && ! kill -0 "$opid" 2>/dev/null; then return 0; fi
  fi
  [[ -n "$(find "$d" -maxdepth 0 -mmin +2 2>/dev/null)" ]]
}

# _lock <file> — advisory lock for a read-modify-write of one JSON file.
_lock() {
  local d="$1.lock" i=0
  mkdir -p "${1%/*}" 2>/dev/null || { echo "ship-mux: cannot create ${1%/*}" >&2; return 1; }
  while ! mkdir "$d" 2>/dev/null; do
    if _lock_stale "$d"; then
      if mv "$d" "$d.stale.$$" 2>/dev/null; then rm -rf "$d.stale.$$"; fi
      continue
    fi
    i=$((i + 1))
    if [[ $i -gt 200 ]]; then echo "ship-mux: timed out waiting for the lock $d" >&2; return 1; fi
    sleep 0.05
  done
  printf '%s@%s\n' "$$" "$_host" >"$d/owner"
  _held+=("$d")
}
_unlock() {
  local n=${#_held[@]}
  [[ $n -gt 0 ]] || return 0
  rm -rf "${_held[$((n - 1))]}" 2>/dev/null || true
  unset "_held[$((n - 1))]"
}

# _json_update <file> <default-json> <jq filter> [jq args...] — locked rewrite;
# returns 1 (after saying why) when it cannot.
_json_update() {
  local file="$1" default="$2" filter="$3" cur tmp
  shift 3
  _lock "$file" || return 1
  if [[ -f "$file" ]]; then cur="$(cat "$file")"; else cur="$default"; fi
  tmp="$file.tmp.$$"
  if ! jq -c "$@" "$filter" <<<"$cur" >"$tmp" 2>/dev/null || ! mv "$tmp" "$file" 2>/dev/null; then
    rm -f "$tmp"; _unlock; echo "ship-mux: cannot update $file" >&2; return 1
  fi
  _unlock
}

rec_default="$(jq -nc --arg b "$mux" '{backend: $b, created: []}')"
# A record written for another backend holds ids that mean nothing to this one.
if [[ -f "$rec" ]]; then
  rec_backend="$(jq -r '.backend // ""' "$rec")" || fail "cannot read $rec"
  [[ "$rec_backend" == "$mux" ]] || fail "$rec belongs to backend '$rec_backend', config says '$mux'"
fi

# _rec_add <jq array of entries> — add entries to the ref record, dedup by id.
_rec_add() {
  _json_update "$rec" "$rec_default" \
    '.created as $c | .created += [$new[] | select(.id as $i | $c | map(.id) | index($i) | not)]' \
    --argjson new "$1"
}

# _entry <id> — the record entry for id in this ref, or nothing.
_entry() {
  [[ -f "$rec" ]] || return 0
  jq -c --arg id "$1" '[.created[] | select(.id == $id)] | first // empty' "$rec"
}

# _need_recorded <id> — refuse (3) an id that is not recorded for this ref.
_need_recorded() {
  [[ -n "$(_entry "$1")" ]] || refuse "id '$1' is not recorded for ref '$f_ref' (see $rec); no backend call made"
}

# _drop <jq select expression over an entry, using $id> <id> — remove entries.
_drop() {
  _json_update "$rec" "$rec_default" ".created |= map(select(($1) | not))" --arg id "$2" || return 1
}

# _group_has_spaces <group id> — true when any ref's record holds a space in it.
_group_has_spaces() {
  local f
  for f in "$root"/notes/loops/*/mux.json; do
    [[ -f "$f" ]] || continue
    if jq -e --arg g "$1" '[.created[]? | select(.kind == "space" and .group == $g)] | length > 0' "$f" >/dev/null 2>&1; then
      return 0
    fi
  done
  return 1
}

# _close_ok <id> — close on the backend; "not found" (5) counts as closed.
_close_ok() {
  local rc=0
  _be close --ref "$f_ref" --id "$1" || rc=$?
  [[ $rc -eq 5 ]] && return 0
  return "$rc"
}

case "$verb" in
  run|send|read|status|wait)
    case "$verb" in run) target="$f_pane" ;; *) target="$f_to" ;; esac
    _need_recorded "$target"
    rc=0; _be "$verb" "${orig[@]}" || rc=$?
    exit "$rc" ;;

  list)
    ids="[]"
    if [[ -f "$rec" ]]; then ids="$(jq -c '[.created[].id]' "$rec")"; fi
    out="$(_be list "${orig[@]}" --ids "$ids")" || exit $?
    jq -e 'type == "array"' <<<"$out" >/dev/null 2>&1 || fail "backend '$mux' returned invalid list output: $out"
    if [[ -f "$rec" ]]; then
      jq -c --slurpfile r "$rec" '
        [.[] | . as $b | ($r[0].created | map(select(.id == $b.id)) | first) as $e
         | select($e != null)
         | {id: $b.id, kind: $b.kind, name: $e.name, backend_name: $b.name, state: ($b.state // "")}]' <<<"$out"
    else
      echo "[]"
    fi ;;

  open)
    old=""
    if [[ -f "$rec" ]]; then
      old="$(jq -c '[.created[] | select(.kind == "space")] | first // empty' "$rec")"
    fi
    if [[ -n "$old" ]]; then
      oldcwd="$(jq -r '.cwd // ""' <<<"$old")"
      if [[ -n "$oldcwd" && "$oldcwd" != "$f_cwd" ]]; then
        echo "ship-mux: warning: ref '$f_ref' is already open with cwd '$oldcwd'; ignoring --cwd '$f_cwd'" >&2
      fi
    fi
    gargs=()
    if [[ -n "$units_group" ]]; then
      gargs=(--group "$units_group")
      # Group close scans the records; it must not run between the backend creating
      # a space and the record naming it. Taken before any file lock.
      _lock "$ops" || exit 1
    fi
    out="$(_be open "${orig[@]}" ${gargs[@]+"${gargs[@]}"})" || exit $?
    jq -e 'type == "object" and (.space | type == "string" and length > 0) and (.pane | type == "string" and length > 0)' \
      <<<"$out" >/dev/null 2>&1 || fail "backend '$mux' returned invalid open output: $out"
    space="$(jq -r '.space' <<<"$out")"
    gid="$(jq -r 'if (.group | type) == "object" then .group.id elif (.group | type) == "string" then .group else "" end' <<<"$out")"
    gcreated="$(jq -r 'if (.group | type) == "object" then (.group.created // false) else false end' <<<"$out")"
    gname="$(jq -r 'if (.group | type) == "object" then (.group.name // "") else "" end' <<<"$out")"
    [[ -n "$gname" ]] || gname="$units_group"
    name="${f_label:-$f_ref}"
    isnew=1
    if [[ -n "$old" && "$(jq -r '.id' <<<"$old")" == "$space" ]]; then isnew=0; fi
    wrote_group=0 ok=1
    if [[ -n "$gid" ]]; then
      _json_update "$grp" '{"groups":{}}' \
        '.groups[$id] = ((.groups[$id] // {name: $name, backend: $b, created: false})
           | .name = $name | .created = (.created or $created))' \
        --arg id "$gid" --arg name "$gname" --arg b "$mux" --argjson created "$gcreated" && wrote_group=1 || ok=0
    fi
    if [[ $ok -eq 1 ]]; then
      _rec_add "$(jq -nc --argjson o "$out" --arg n "$name" --arg g "$gid" --arg c "$f_cwd" \
        '[{id: $o.space, kind: "space", name: $n, cwd: $c} + (if $g == "" then {} else {group: $g} end),
          {id: $o.pane, kind: "pane", name: $n, space: $o.space, root: true}]')" || ok=0
    fi
    if [[ $ok -eq 0 ]]; then
      # Roll back what this call created, so the backend holds nothing unrecorded.
      echo "ship-mux: could not record the new space; closing it" >&2
      if [[ $isnew -eq 1 ]]; then _be close --ref "$f_ref" --id "$space" >/dev/null 2>&1 || true; fi
      if [[ "$gcreated" == true && -n "$gid" ]]; then
        _be close --ref "$f_ref" --id "$gid" >/dev/null 2>&1 || true
        [[ $wrote_group -eq 0 ]] || _json_update "$grp" '{"groups":{}}' 'del(.groups[$id])' --arg id "$gid" 2>/dev/null || true
      fi
      exit 1
    fi
    [[ -z "$units_group" ]] || _unlock
    jq -c '{space, pane} + (if (.group | type) == "object" then {group: .group.id} elif (.group | type) == "string" then {group: .group} else {} end)' <<<"$out" ;;

  start)
    out="$(_be start "${orig[@]}")" || exit $?
    jq -e 'type == "object" and (.agent | type == "string" and length > 0) and (.pane | type == "string" and length > 0)' \
      <<<"$out" >/dev/null 2>&1 || fail "backend '$mux' returned invalid start output: $out"
    if ! _rec_add "$(jq -nc --argjson o "$out" --arg n "$f_name" --arg s "$f_space" \
      '[{id: $o.agent, kind: "agent", name: $n, space: $s, pane: $o.pane}, {id: $o.pane, kind: "pane", name: $n, space: $s}]')"; then
      echo "ship-mux: could not record the new agent; closing it" >&2
      _be close --ref "$f_ref" --id "$(jq -r .agent <<<"$out")" >/dev/null 2>&1 || true
      _be close --ref "$f_ref" --id "$(jq -r .pane <<<"$out")" >/dev/null 2>&1 || true
      exit 1
    fi
    jq -c '{agent, pane}' <<<"$out" ;;

  close)
    entry="$(_entry "$f_id")"
    if [[ -n "$entry" ]]; then
      kind="$(jq -r '.kind' <<<"$entry")"
      case "$kind" in
        space)
          _close_ok "$f_id" || exit $?
          _drop '.id == $id or .space == $id' "$f_id" || exit 1 ;;
        pane)
          [[ "$(jq -r '.root // false' <<<"$entry")" != true ]] || refuse "'$f_id' is the root pane of its space; close the space instead"
          _close_ok "$f_id" || exit $?
          _drop '.id == $id or .pane == $id' "$f_id" || exit 1 ;;
        agent)
          pane="$(jq -r '.pane // ""' <<<"$entry")"
          _close_ok "$f_id" || exit $?
          _drop '.id == $id' "$f_id" || exit 1
          if [[ -n "$pane" ]]; then
            _close_ok "$pane" || exit $?
            _drop '.id == $id' "$pane" || exit 1
          fi ;;
        *) fail "record holds an entry of unknown kind '$kind'" ;;
      esac
      exit 0
    fi

    # Not in the ref record: it may be the units group.
    _lock "$ops" || exit 1
    g=""
    [[ ! -f "$grp" ]] || g="$(jq -c --arg id "$f_id" '.groups[$id] // empty' "$grp")"
    [[ -n "$g" ]] || refuse "id '$f_id' is not recorded for ref '$f_ref' (see $rec); no backend call made"
    [[ "$(jq -r '.created' <<<"$g")" == true ]] || refuse "units group '$f_id' was not created by ship; not closing it"
    if _group_has_spaces "$f_id"; then refuse "units group '$f_id' still has spaces recorded in notes/loops/*/mux.json; not closing it"; fi
    gname="$(jq -r '.name' <<<"$g")"
    ids="$(jq -nc --arg id "$f_id" '[$id]')"
    seen_name="$(_be list --ref "$f_ref" --ids "$ids" | jq -r --arg id "$f_id" '[.[] | select(.id == $id and .kind == "group") | .name] | first // ""')" || exit 1
    if [[ -n "$seen_name" && "$seen_name" != "$gname" ]]; then
      refuse "units group '$f_id' is now named '$seen_name' on the backend, not '$gname'; not closing it"
    fi
    if [[ -n "$seen_name" ]]; then _close_ok "$f_id" || exit $?; fi
    _unlock
    _json_update "$grp" '{"groups":{}}' 'del(.groups[$id])' --arg id "$f_id" || exit 1 ;;
esac
