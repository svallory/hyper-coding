#!/usr/bin/env bash
# ship-loop — run one briefed unit through develop -> verify -> review -> spec check
# -> fix rounds -> optional final gate -> finalize, with every agent in a pane
# reached only through ship-mux. The driver's exit is the only notification: it
# never waits for a human. When a unit parks, runs out of budget, gets stuck or
# finishes, the process exits and result.json says why.
#
# Usage:
#   ship-loop --ref REF --worktree ABS --branch B --brief ABS --class S|M|L
#             [--base B] [--max-rounds N] [--final-gate] [--model STAGE=M[,M...]]...
#   ship-loop --preflight [--ref REF]   check the toolchain and the config, then exit
#   ship-loop --clear-limit NAME        mark account or model NAME as usable again (limited.json), then exit
#
# Everything else (gate, models, budgets, scan rules, spec paths, ...) comes from the
# merged ship config (see ship-config). --base and --max-rounds override `base` and
# `max_rounds`; --model replaces one stage's model list for this run (stages: dev
# verify review spec_check spec_write final). A bare model name launches Claude Code,
# provider/model[:thinking] launches pi; agents are launched with the flags that
# `ship-role <role> --harness H --cwd <worktree>` prints.
#
# State directory: <space root>/notes/loops/<REF>/ (ship-mux keeps mux.json there).
#   loop.log driver.pid driver.err   log, pid of the running driver, last ERROR message
#   <stage>.prompt.md                the prompt each agent was given
#   <verdict>.json + <verdict>.json.sent
#       The agent's verdict file, and the marker of when it was prompted: one line is
#       appended per prompt. A verdict newer than its marker is the answer to the last
#       prompt; finished stages (valid, fresh verdict) are never re-run. Files:
#         develop.json  fix-r<N>.json  verify-r<N>.json  review-r<N>.json
#         spec-r<N>.json  specwriter-r<N>.json  final-r<N>.json   (agents)
#         finalize.json  verify-r<N>.json when verify is skipped  (driver-written)
#   agents/<name>.json               role, model, harness and session of each agent
#   park.json                        the unit is parked (see below)
#   park-<n>.json, <verdict>.<STATUS>-<n>.json    resolved parks and the verdicts that caused them
#   budget-r<k>.json                 a stage ran over budget
#   result.json                      the outcome; also printed on stdout
#
# Exit codes and result.json.status
#   0  READY        finalize passed (rebase, gate, scan, push); land it
#   2  PARKED       park.json: a dev QUESTION/BLOCKED, a permission DIALOG, a usage
#                   LIMIT with nothing left to fail over to, or an OPERATOR question
#                   from the spec writer. The agent is left alive and waiting.
#      OVER-BUDGET  budget-r<k>.json; the agent is left running
#      STUCK        max rounds without ACCEPT, or finalize failures the dev could not fix
#   1  ERROR        tool or script failure, malformed verdict, bad usage (driver.err)
#
# Restart = resume. Running the driver again with the same --ref reattaches to live
# agents and replays the finished stages from their files. The lead hands things to a
# parked unit through files in the state directory before restarting it (ship-unit
# resume writes them):
#   answer-<n>.md    the answer to park.json (n is park.json's "n"); sent to the parked
#                    agent. QUESTION, BLOCKED and OPERATOR parks wait for it; a DIALOG
#                    park resumes once the agent is no longer blocked; a LIMIT park
#                    resumes at once (change the models with models.override first).
#   extend           minutes to add to the stage that went OVER-BUDGET (a number)
#   models.override  lines of "stage=model[,model...]"; applied on every start
# Without what the park needs, the driver re-emits the same result and exits 2.
#
# Budgets: budgets.<class> minutes for develop; a fix round answering F findings gets
# min(class, class * budgets.fix_fraction + budgets.fix_per_finding * F) (F = 1 when the
# driver only has the problem as text: a finalize rejection); every other agent stage
# gets budgets.check. The clock is wall time since the
# stage's prompt was sent, without the time the unit was parked.
#
# Failover: every agent start goes through model_pick, which walks the stage's model
# list with preflight routing (pick_model in lib.sh: limited.json, the quota snapshot,
# pi never skipped); each skipped entry writes failover-N.json (reason preflight).
# A list with nothing usable parks LIMIT (resets_at when known).
# Reactive failover (failover_on_limit): a limit seen on an agent's screen while a stage runs is
# recorded in limited.json, the agent is stopped and closed, a summariser (first usable
# failover.summarizer entry, headless) or the git facts write STATUS.md, and the same stage restarts
# under the same agent name on the next usable model with the takeover prompt. failover-N.json
# (reason limit) records it. The list exhausted parks LIMIT. result.json.failovers counts every
# failover-N.json; a stage's verdict file gets the count of its agent's.
#
# Environment (test knobs): SHIP_POLL_S (poll interval, default 2), SHIP_IDLE_GRACE_S
# (seconds an idle agent without a verdict is left alone before a nudge, default 1200),
# SHIP_HOST (recorded in result.json, default local), SHIP_FAILOVER_STOP_MS (how long a stopped agent
# gets to exit before its pane is closed anyway, default 15000), SHIP_SUMMARY_TIMEOUT_S (default 300).

set -uo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
  _link="$(readlink "$_src")"
  case "$_link" in /*) _src="$_link" ;; *) _src="$_dir/$_link" ;; esac
done
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
SHIP_DIR="$(CDPATH='' cd -- "$_dir" && pwd -P)"
# shellcheck source=lib.sh
source "$SHIP_DIR/lib.sh"
MUX="${SHIP_LOOP_MUX:-$SHIP_DIR/ship-mux}" # SHIP_LOOP_MUX: a test seam
ROLE_BIN="$SHIP_DIR/ship-role"
PROMPTS="$SHIP_DIR/prompts"
SCHEMAS="$SHIP_DIR/schemas"
# A replacement string in ${x//a/$b} must not treat & specially (bash 5.2).
shopt -u patsub_replacement 2>/dev/null || true

POLL_S="${SHIP_POLL_S:-2}"
IDLE_GRACE_S="${SHIP_IDLE_GRACE_S:-1200}"
SEND_WAIT_MS=30000
LIMIT_LINES="${SHIP_LIMIT_LINES:-25}" # only the newest lines of a screen are searched for limit text
STOP_MS="${SHIP_FAILOVER_STOP_MS:-15000}"
SUMMARY_TIMEOUT_S="${SHIP_SUMMARY_TIMEOUT_S:-300}"

CLEAR_LIMIT="" CUR_ROUND=0
REF="" WT="" BRANCH="" BRIEF="" CLASS="" BASE="" MAX="" FINAL_GATE=0 PREFLIGHT=0
MODEL_OVERRIDES=()
STATE="" LOG=/dev/null STAGE=setup FINISHED=""
PR="" ROUNDS='[]' FINALIZE_JSON='null'
SPEC_VERDICT=NOT_RUN SPEC_ROUNDS=0
FINAL_VERDICT=NOT_RUN FINAL_ROUNDS=0
SW_RUNS=0 SW_COMMITS='[]'

usage_exit() { echo "ship-loop: $*" >&2; exit 1; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) sed -n '2,/^$/p' "${BASH_SOURCE[0]}" | sed '$d' | sed 's/^# \{0,1\}//'; exit 0 ;;
    --final-gate) FINAL_GATE=1; shift; continue ;;
    --preflight) PREFLIGHT=1; shift; continue ;;
    --ref|--worktree|--branch|--brief|--class|--base|--max-rounds|--model|--clear-limit)
      [[ $# -ge 2 ]] || usage_exit "$1 needs a value" ;;
    *) usage_exit "unknown argument: $1" ;;
  esac
  case "$1" in
    --ref) REF="$2" ;; --worktree) WT="$2" ;; --branch) BRANCH="$2" ;; --brief) BRIEF="$2" ;;
    --class) CLASS="$2" ;; --base) BASE="$2" ;; --max-rounds) MAX="$2" ;;
    --model) MODEL_OVERRIDES+=("$2") ;;
    --clear-limit) CLEAR_LIMIT="$2" ;;
  esac
  shift 2
done

# --- preflight ---------------------------------------------------------------------------------
preflight() {
  local bad=0 m h cfg_ok=1 stage
  need() { command -v "$1" >/dev/null 2>&1 || { echo "preflight: $1 not found on PATH${2:+ ($2)}" >&2; bad=1; }; }
  bin_for() { case "$1" in claude) echo claude ;; *) echo pi ;; esac; }
  need jq; need git; need gh
  if [[ -z "${SHIP_SPACE_ROOT:-}" ]]; then need hyper "or set SHIP_SPACE_ROOT"; fi
  ship_require_yq || bad=1
  if [[ $bad -eq 0 ]]; then ship_config_load || cfg_ok=0; else cfg_ok=0; fi
  if [[ $cfg_ok -eq 1 ]]; then
    for m in ${MODEL_OVERRIDES[@]+"${MODEL_OVERRIDES[@]}"}; do ship_models_override "$m" || bad=1; done
    ship_require_gate || bad=1
    "$MUX" check || bad=1
    for stage in $SHIP_STAGES; do
      while IFS= read -r m; do
        [[ -n "$m" ]] || continue
        h="$(ship_model_parse "$m" | cut -f1)"
        need "$(bin_for "$h")" "needed by model $m"
      done < <(jq -r --arg s "$stage" '.models[$s][]' <<<"$SHIP_CONFIG_JSON")
    done
    while IFS= read -r m; do
      [[ -n "$m" ]] || continue
      h="$(ship_model_parse "$m" | cut -f1)"
      need "$(bin_for "$h")" "needed by failover.summarizer $m"
    done < <(jq -r '.failover.summarizer[]' <<<"$SHIP_CONFIG_JSON")
  else
    bad=1
  fi
  if [[ $bad -eq 0 ]]; then echo "preflight: ok"; else echo "preflight: failed" >&2; fi
  exit "$bad"
}

[[ $PREFLIGHT -eq 1 ]] && preflight
if [[ -n "$CLEAR_LIMIT" ]]; then
  _was="$(jq -r --arg n "$CLEAR_LIMIT" '[(.accounts[$n]?), (.models[$n]?)] | map(select(. != null)) | length' "$(ship_quota_dir)/limited.json" 2>/dev/null)"
  ship_limit_clear "$CLEAR_LIMIT" || { echo "ship-loop: could not update limited.json" >&2; exit 1; }
  if [[ "${_was:-0}" -gt 0 ]]; then echo "ship-loop: '$CLEAR_LIMIT' is no longer marked limited"; else echo "ship-loop: '$CLEAR_LIMIT' was not marked limited"; fi
  exit 0
fi
ship_require_yq || exit 1
ship_config_load || exit 1
for _o in ${MODEL_OVERRIDES[@]+"${MODEL_OVERRIDES[@]}"}; do ship_models_override "$_o" || exit 1; done

for _v in REF WT BRANCH BRIEF CLASS; do
  [[ -n "${!_v}" ]] || usage_exit "--$(printf '%s' "$_v" | tr 'A-Z' 'a-z') is required"
done
case "$CLASS" in S|M|L) ;; *) usage_exit "--class must be S, M or L" ;; esac
[[ -d "$WT" ]] || usage_exit "worktree $WT is not a directory"
[[ -f "$BRIEF" ]] || usage_exit "brief $BRIEF is not a file"
[[ -n "$BASE" ]] || BASE="$(ship_cfg_get base)" || usage_exit "config has no base"
[[ -n "$MAX" ]] || MAX="$(ship_cfg_get max_rounds)" || usage_exit "config has no max_rounds"
case "$MAX" in ''|*[!0-9]*|0) usage_exit "max rounds must be a positive integer (got '$MAX')" ;; esac

SPACE_ROOT="$(ship_space_root)" || usage_exit "cannot locate the space root"
STATE="$SPACE_ROOT/notes/loops/$REF"
mkdir -p "$STATE/agents" || usage_exit "cannot create $STATE"
LOG="$STATE/loop.log"
# Atomic, so a reader never sees an empty pid file. A driver killed between the two commands leaves a
# one-line driver.pid.tmp.<pid>: harmless (nothing reads it, and the next run archive moves it away).
echo $$ >"$STATE/driver.pid.tmp.$$" && mv -f "$STATE/driver.pid.tmp.$$" "$STATE/driver.pid"
HOST="${SHIP_HOST:-local}"

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*" | tee -a "$LOG" >&2; }

# failover_count — the failover-N.json files of this run (preflight and reactive).
failover_count() { ls "$STATE"/failover-*.json 2>/dev/null | wc -l | tr -d ' '; }

# Result JSON to result.json and stdout, then exit. Every result carries spec, final and
# specwriter summaries.
finish() { # code stage status [extra-json]
  local extra="${4:-}" tmp="$STATE/result.json.tmp" nfo
  [[ -n "$extra" ]] || extra='{}'
  nfo="$(failover_count)"
  FINISHED=1
  jq -n --arg ref "$REF" --arg stage "$2" --arg status "$3" --arg pr "$PR" \
    --arg sv "$SPEC_VERDICT" --argjson sr "$SPEC_ROUNDS" --arg fv "$FINAL_VERDICT" --argjson fr "$FINAL_ROUNDS" \
    --argjson swr "$SW_RUNS" --argjson swc "$SW_COMMITS" --argjson rounds "$ROUNDS" --argjson fin "$FINALIZE_JSON" \
    --arg host "$HOST" --arg wt "$WT" --argjson extra "$extra" --argjson nfo "$nfo" \
    '{ref:$ref, pr:($pr|tonumber? // null), stage:$stage, status:$status, rounds:$rounds,
      spec:{verdict:$sv, rounds:$sr}, final:{verdict:$fv, rounds:$fr}, specwriter:{runs:$swr, commits:$swc},
      finalize:$fin, failovers:$nfo, host:$host, worktree:$wt} + $extra' >"$tmp" && mv "$tmp" "$STATE/result.json"
  cat "$STATE/result.json"
  exit "$1"
}

die_error() { # message
  log "ERROR: $*"
  printf '%s\n' "$*" >"$STATE/driver.err"
  finish 1 "$STAGE" ERROR "$(jq -n --arg why "$*" '{why:$why}')"
}

# Anything that ends the script without finish (a bug, an unbound variable) is an ERROR too.
trap '[[ -n "$FINISHED" ]] || { log "driver exited unexpectedly"; die_error "driver exited unexpectedly; see loop.log"; }' EXIT

command -v git >/dev/null 2>&1 || die_error "git not found"
ship_require_gate || die_error "config has no usable gate (see driver output above)"
GATE="$(ship_cfg_get gate)"
git -C "$WT" rev-parse --verify -q "origin/$BASE" >/dev/null || die_error "origin/$BASE does not exist in $WT; fetch it first"

# --- config -------------------------------------------------------------------------------------
cfg() { ship_cfg_get "$1" 2>/dev/null || true; }
abs_in_space() { case "$1" in /*) printf '%s' "$1" ;; *) printf '%s/%s' "$SPACE_ROOT" "$1" ;; esac; }
RULINGS="$(abs_in_space "$(cfg rulings)")"
# The rulings file is optional for the operator, but the agents are told to read it and to add to it:
# an empty one is created on first use.
if [[ ! -e "$RULINGS" ]]; then
  mkdir -p "$(dirname "$RULINGS")" 2>/dev/null && printf '# Rulings\n' >"$RULINGS" 2>/dev/null || true
fi
SPEC_PATHS=()
while IFS= read -r _p; do [[ -z "$_p" ]] || SPEC_PATHS+=("$_p"); done < <(jq -r '.spec.paths // [] | .[]' <<<"$SHIP_CONFIG_JSON")
SPEC_PATHS_TXT="(none configured)"
[[ ${#SPEC_PATHS[@]} -eq 0 ]] || SPEC_PATHS_TXT="${SPEC_PATHS[*]}"
FORBIDDEN_TXT="$(jq -r '(.scan.forbidden // []) | if length == 0 then "(none configured)" else map("`" + . + "`") | join(", ") end' <<<"$SHIP_CONFIG_JSON")"
FORBIDDEN_EXCLUDE_TXT="$(jq -r '(.scan.exclude // []) | if length == 0 then "" else " except in files matching " + (map("`" + . + "`") | join(", ")) end' <<<"$SHIP_CONFIG_JSON")"
VERIFY_INSTR_FILE="$(cfg stages.verify.instructions)"
REVIEW_INSTR_FILE="$(cfg stages.review.instructions)"
[[ "$(cfg stages.final.always)" == true ]] && FINAL_GATE=1

# models.override (written by the lead's resume) applies on every start, before --model.
if [[ -s "$STATE/models.override" ]]; then
  while IFS= read -r _o; do
    [[ -z "$_o" ]] || ship_models_override "$_o" || die_error "bad line in models.override: $_o"
  done <"$STATE/models.override"
  for _o in ${MODEL_OVERRIDES[@]+"${MODEL_OVERRIDES[@]}"}; do ship_models_override "$_o" || die_error "bad --model $_o"; done
fi

# --- failover hooks -----------------------------------------------------------------------------
# model_pick <list key> <agent name> — the model to launch for a stage: sets PICK_MODEL. Walks the
# list from its first entry, skipping what preflight rules out (pick_model, lib.sh). Returns 2 when
# nothing is usable (PICK_RESETS_AT may say when), 1 on a config error. Not for use in $( ).
model_pick() {
  pick_model "$1" "$2" "$STAGE" "$CUR_ROUND"
}
# failover_on_limit (reactive failover) is defined with the agent helpers below.

# --- small helpers ------------------------------------------------------------------------------
aname() { printf '%s%s' "${REF:0:$((32 - ${#1}))}" "$1"; } # agent names are at most 32 chars: keep the suffix whole
write_json() { printf '%s\n' "$2" >"$1.tmp" && mv "$1.tmp" "$1"; }
valid_json() { [[ -s "$1" ]] && jq -e . "$1" >/dev/null 2>&1; }
new_uuid() {
  if command -v uuidgen >/dev/null 2>&1; then uuidgen | tr 'A-Z' 'a-z'
  elif [[ -r /proc/sys/kernel/random/uuid ]]; then cat /proc/sys/kernel/random/uuid
  else od -An -N16 -tx1 /dev/urandom | tr -d ' \n' | sed -E 's/(.{8})(.{4})(.{4})(.{4})(.{12})/\1-\2-\3-\4-\5/'
  fi
}
mux() { local verb="$1"; shift; "$MUX" "$verb" --ref "$REF" "$@"; }

# render <template> key=value... — the template without its first line, with {key} replaced in
# one pass (a value containing {other} is not substituted again). Unknown {keys} stay visible.
render() {
  local tpl="$1" m='{}' kv
  shift
  for kv in "$@"; do m="$(jq -c --arg k "${kv%%=*}" --arg v "${kv#*=}" '.[$k] = $v' <<<"$m")"; done
  sed 1d "$PROMPTS/$tpl.md" \
    | jq -Rrs --argjson m "$m" 'gsub("\\{(?<k>[a-z_]+)\\}"; ($m[.k] // ("{" + .k + "}")))'
}
TEST_SKILL="$SHIP_PLUGIN_ROOT/skills/test-engineer/SKILL.md" # the dev and review prompts point at it
RULES="$(render rules ref="$REF" worktree="$WT" branch="$BRANCH" brief="$BRIEF" gate="$GATE" rulings="$RULINGS" \
  test_skill="$TEST_SKILL" forbidden="$FORBIDDEN_TXT" forbidden_exclude="$FORBIDDEN_EXCLUDE_TXT")"
# prompt <template> key=value... — render with the pairs every prompt gets (templates ignore the
# ones they do not use).
prompt() {
  local tpl="$1"
  shift
  render "$tpl" "ref=$REF" "pr=$PR" "worktree=$WT" "branch=$BRANCH" "base=$BASE" "brief=$BRIEF" "gate=$GATE" \
    "rulings=$RULINGS" "spec_paths=$SPEC_PATHS_TXT" "forbidden=$FORBIDDEN_TXT" "forbidden_exclude=$FORBIDDEN_EXCLUDE_TXT" \
    "test_skill=$TEST_SKILL" "rules=$RULES" "$@"
}
skill_call() { # skill model
  case "$2" in */*) echo "pi: the /skill:$1 command, or read its SKILL.md" ;; *) echo "Skill tool, skill \"$1\"" ;; esac
}
file_text() { # path relative to the space root (or absolute); empty when unset or missing
  local p="$1"
  [[ -n "$p" ]] || return 0
  p="$(abs_in_space "$p")"
  [[ -f "$p" ]] && cat "$p"
  return 0
}

check_verdict() { # schema file — a verdict that does not match its schema is an ERROR
  local errs
  errs="$(validate_verdict "$SCHEMAS/$1.json" "$2" 2>&1)" || die_error "$(basename "$2") is not a valid $1 result: $(tr '\n' ' ' <<<"$errs" | cut -c1-500)"
}

# --- budgets ------------------------------------------------------------------------------------
budget_min() { # kind (develop|fix|check) verdict-file [findings, for fix]
  local base extra=0
  case "$1" in
    develop) base="$(jq -r --arg c "$CLASS" '.budgets[$c]' <<<"$SHIP_CONFIG_JSON")" ;;
    fix) base="$(jq -r --arg c "$CLASS" --argjson n "${3:-1}" \
      '.budgets[$c] as $cap | [$cap, $cap * .budgets.fix_fraction + .budgets.fix_per_finding * $n] | min' <<<"$SHIP_CONFIG_JSON")" ;;
    *) base="$(jq -r '.budgets.check' <<<"$SHIP_CONFIG_JSON")" ;;
  esac
  [[ -s "$2.extra" ]] && extra="$(cat "$2.extra")"
  awk -v a="$base" -v b="$extra" 'BEGIN { print a + b }'
}

over_budget() { # stage agent file budget_min elapsed_s
  local k=1 f
  while [[ -e "$STATE/budget-r$k.json" ]]; do k=$((k + 1)); done
  f="$STATE/budget-r$k.json"
  write_json "$f" "$(jq -n --arg stage "$1" --arg agent "$2" --arg class "$CLASS" --arg file "$(basename "$3")" \
    --argjson b "$4" --argjson e "$5" \
    '{verdict:"OVER-BUDGET", stage:$stage, agent:$agent, class:$class, budget_min:$b, elapsed_min:($e / 60 * 100 | round / 100), file:$file}')"
  check_verdict budget "$f"
  log "OVER-BUDGET $1: $2 used $(jq -r .elapsed_min "$f") of $4 min; agent left running (resume with --extend)"
  finish 2 "$1" OVER-BUDGET "$(jq -c '{budget:.}' "$f")"
}

# --- parking ------------------------------------------------------------------------------------
park() { # status stage agent question [verdict-file [resets_at]]
  local n=1 q
  while [[ -e "$STATE/park-$n.json" ]]; do n=$((n + 1)); done
  q="$4"
  write_json "$STATE/park.json" "$(jq -n --arg st "$1" --arg stage "$2" --arg agent "$3" --arg q "$q" \
    --arg since "$(date -u +%Y-%m-%dT%H:%M:%SZ)" --arg file "${5:-}" --arg resets "${6:-}" --argjson n "$n" \
    '{status:$st, stage:$stage, agent:$agent, question:$q, since:$since, n:$n, file:$file}
     + (if $resets == "" then {} else {resets_at:$resets} end)')"
  check_verdict park "$STATE/park.json"
  log "PARKED $1 $2: $3 — $(tr '\n\t' '  ' <<<"$q" | tr -s ' ' | cut -c1-300)"
  finish 2 "$2" PARKED "$(jq -c '{park:.}' "$STATE/park.json")"
}

# park_result <verdict file> <status> <stage> <agent> <question> — the agent's own verdict asked
# a question: keep it next to the park, clear the verdict so the agent's next answer is fresh.
park_result() {
  local f="$1" n=1 keep
  while [[ -e "$STATE/park-$n.json" ]]; do n=$((n + 1)); done
  keep="${f%.json}.$2-$n.json"
  mv "$f" "$keep"
  park "$2" "$3" "$4" "$5" "$f"
}

# --- agents -------------------------------------------------------------------------------------
# agent_lookup <name> — sets L_ID to the agent's id, empty when there is none. Not run in a
# command substitution, so a ship-mux failure ends the driver.
L_ID="" L_STATE=""
agent_lookup() {
  local out
  L_ID=""
  out="$(mux list 2>>"$LOG")" || die_error "ship-mux list failed; see loop.log"
  L_ID="$(jq -r --arg n "$1" '[.[] | select(.kind == "agent" and .name == $n)][0].id // empty' <<<"$out")"
}
# agent_state <id> — sets L_STATE to working|idle|blocked|gone.
agent_state() {
  local out rc=0
  L_STATE=gone
  [[ -n "$1" ]] || return 0
  out="$(mux status --to "$1" 2>>"$LOG")" || rc=$?
  if [[ $rc -eq 5 ]]; then return 0; fi
  [[ $rc -eq 0 ]] || die_error "ship-mux status $1 failed (exit $rc); see loop.log"
  L_STATE="$(jq -r '.state // "gone"' <<<"$out")"
}
agent_harness() { jq -r '.harness // "claude"' "$STATE/agents/$1.json" 2>/dev/null || echo claude; }

# start_agent <name> <role> <model list key> [model] — a fresh agent in the unit space; sets A_ID. Without
# a model, the first usable entry of the list (model_pick); failover passes the one it picked.
start_agent() {
  local name="$1" role="$2" key="$3" model resets harness rout rargs=() args=() out uuid session end
  # Never two agents under one name: a leftover one (exited, or being replaced) is closed first.
  agent_lookup "$name"
  if [[ -n "$L_ID" ]]; then
    mux close --id "$L_ID" >/dev/null 2>>"$LOG" || { log "could not close the old $name ($L_ID); not starting another"; return 1; }
    agent_lookup "$name"
    [[ -z "$L_ID" ]] || { log "the old $name ($L_ID) is still there after close; not starting another"; return 1; }
  fi
  if [[ -n "${4:-}" ]]; then
    model="$4" # a failover picked it already
  else
    model_pick "$key" "$name"
  fi
  case $? in
    0) [[ -n "${4:-}" ]] || model="$PICK_MODEL" ;;
    2)
      resets=""
      [[ -z "$PICK_RESETS_AT" ]] || resets="$(jq -nr --argjson t "$PICK_RESETS_AT" '$t | todate')"
      park LIMIT "$STAGE" "$name" "every model for $key is limited or over its quota threshold (see failover-*.json); nothing to start $name with. Wait for the reset${resets:+ ($resets)}, or resume with a models.override" "" "$resets" ;;
    *) return 1 ;;
  esac
  harness="$(ship_model_parse "$model" | cut -f1)" || return 1
  rout="$("$ROLE_BIN" "$role" --harness "$harness" --cwd "$WT" 2>>"$LOG")" || { log "ship-role $role failed for $name"; return 1; }
  read -r -a rargs <<<"$rout"
  if [[ "$harness" == claude ]]; then
    uuid="$(new_uuid)"; session="$uuid"
    args=(--model "$model" --permission-mode bypassPermissions ${rargs[@]+"${rargs[@]}"} --session-id "$uuid")
  else
    session="$STATE/pi-sessions/$name-$(new_uuid)" # one directory per agent: a summary reads only its own transcript
    mkdir -p "$session"
    args=(--model "$model" --approve ${rargs[@]+"${rargs[@]}"} --session-dir "$session")
  fi
  out="$(mux start --space "$SPACE_ID" --name "$name" --harness "$harness" --cwd "$WT" -- "${args[@]}" 2>>"$LOG")" \
    || { log "could not start $name"; return 1; }
  A_ID="$(jq -r .agent <<<"$out")"
  rm -f "$STATE/agents/$name.trust"
  write_json "$STATE/agents/$name.json" "$(jq -n --arg n "$name" --arg r "$role" --arg k "$key" --arg m "$model" \
    --arg h "$harness" --arg s "$session" --arg id "$A_ID" '{name:$n, role:$r, models_key:$k, model:$m, harness:$h, session:$s, id:$id}')"
  log "started $name ($role, $model) as $A_ID"
  # The trust dialog is up by the time the start returns (a blocked agent shows it at once); a later
  # one is caught when a prompt to the agent fails.
  if [[ "$harness" == claude ]]; then trust_dialog "$name" "$A_ID" "$STAGE" || true; fi
}

close_agent() { # name
  local id
  agent_lookup "$1"; id="$L_ID"
  [[ -n "$id" ]] || return 0
  mux close --id "$id" >/dev/null 2>>"$LOG" || log "could not close $1 ($id)"
}

# --- the workspace-trust dialog --------------------------------------------------------------------
# Every unit worktree is a new folder to Claude Code, which asks whether to trust it before it takes
# a prompt. ship made the worktree from the operator's own repo, so the driver answers that one dialog
# itself. It opens with the cursor on "No, exit", so the cursor is moved onto "Yes, I trust this folder"
# first. No other dialog is ever answered, and anything unclear is left alone (no key is sent).
TRUST_WAIT_S="${SHIP_TRUST_WAIT_S:-10}"

# trust_state — reads a screen on stdin and prints what it shows:
#   none       no trust header (a quote of one, indented or prefixed, does not count)
#   ambiguous  a header, but not a lone, last dialog (see below)
#   yes|other  a clean trust dialog, with the cursor on Yes / on the other option
# The real dialog (captured from Claude Code; see tests/fixtures/ship/trust) is: a rule, "Accessing
# workspace:", the folder path (wrapped to the width), "Quick safety check: ..." (wrapped too), prose,
# "Security guide", then two UNNUMBERED options, the cursor "❯" on one, then "Enter to confirm · Esc to
# cancel". Anything above the header (the echoed launch command, rules) is ignored. The header is the
# last "Quick safety check:" line at the dialog's left edge (at most two spaces, or a box border). After
# it there must be exactly the two options "No, exit" and "Yes, I trust this folder" (a leading number is
# tolerated), as one block set off by blank lines, with one cursor; after the block only blank lines and
# the footer. A numbered option, another cursor, "Allow", "Do you want", (y/n), or any other text after
# the options makes it ambiguous.
trust_state() {
  awk '
    function blank(x) { return x ~ /^[ │|]*$/ }
    { l[NR] = $0 }
    END {
      h = 0
      for (i = 1; i <= NR; i++) if (l[i] ~ /^( ? ?|(│|\|) ? ?)Quick safety check: [Ii]s this a project/) h = i
      if (h == 0) { print "none"; exit }
      n = 0; cur = 0; curtxt = ""
      for (i = h + 1; i <= NR; i++) {
        t = l[i]
        if (t ~ /^[ │|]*(❯|>|›)? *([0-9]+\. )?(No, exit|Yes, I trust this folder) *(│|\|)? *$/) {
          n++; pos[n] = i
          if (t ~ /^[ │|]*(❯|>|›)/) { cur++; c = t; sub(/^[ │|]*(❯|>|›) *([0-9]+\. )?/, "", c); sub(/ *(│|\|)? *$/, "", c); curtxt = c }
          x = t; sub(/^[ │|]*(❯|>|›)? *([0-9]+\. )?/, "", x); sub(/ *(│|\|)? *$/, "", x); txt[n] = x
        } else if (t ~ /^[ │|]*(❯|>|›)/ || t ~ /^[ │|]*[0-9]+\. /) { print "ambiguous"; exit }
      }
      if (n != 2 || cur != 1 || txt[1] == txt[2] || pos[2] != pos[1] + 1) { print "ambiguous"; exit }
      if (pos[1] - 1 <= h || !blank(l[pos[1] - 1])) { print "ambiguous"; exit }
      if (pos[2] < NR && !blank(l[pos[2] + 1])) { print "ambiguous"; exit }
      for (i = pos[2] + 1; i <= NR; i++)
        if (!blank(l[i]) && l[i] !~ /^ *(│|\|)? *(Enter to confirm( · Esc to cancel)?|Esc to cancel) *(│|\|)? *$/) { print "ambiguous"; exit }
      print (curtxt == "Yes, I trust this folder" ? "yes" : "other")
    }'
}

# trust_dialog <agent name> <agent id> <stage> — 0 when the trust dialog was showing and was cleared;
# 1 when it is not showing or not clearly the lone, last dialog (nothing is sent then, and the caller's
# normal DIALOG handling applies). The cursor is moved with `down` (at most 2 times, re-reading the pane
# each time) until it is on "Yes, I trust this folder", then Enter is pressed. One attempt per agent
# start. Parks the unit as DIALOG when the cursor never reaches Yes, when the pane cannot be read
# partway, when the dialog is still showing after the Enter, or when it was already answered once.
trust_dialog() {
  local name="$1" id="$2" stage="$3" screen st mark="$STATE/agents/$1.trust" end downs=0 gone why
  why="$name is showing Claude Code's workspace-trust dialog"
  screen="$(mux read --to "$id" --lines 40 2>/dev/null)" || return 1
  st="$(trust_state <<<"$screen")"
  case "$st" in none) return 1 ;; ambiguous) log "$name shows something like the workspace-trust dialog, but not clearly alone; sending no key"; return 1 ;; esac
  if [[ -e "$mark" ]]; then
    park DIALOG "$stage" "$name" "$why again after ship answered it once. Answer it in its pane, then resume."
  fi
  : >"$mark"
  while [[ "$st" != yes ]]; do
    if [[ $downs -ge 2 ]]; then
      park DIALOG "$stage" "$name" "$why and the cursor never reached \"Yes, I trust this folder\" (ship moved it $downs time(s)). Answer it in its pane, then resume."
    fi
    downs=$((downs + 1))
    mux send --to "$id" --keys down >/dev/null 2>>"$LOG" || true
    sleep "$POLL_S"
    screen="$(mux read --to "$id" --lines 40 2>/dev/null)" \
      || park DIALOG "$stage" "$name" "$why but its pane could not be read while moving the cursor. Answer it in its pane, then resume."
    st="$(trust_state <<<"$screen")"
    [[ "$st" != none ]] || park DIALOG "$stage" "$name" "$why, and the dialog vanished after a down key (the screen shows no trust dialog and ship cannot tell why). Look at its pane, then resume."
    [[ "$st" != ambiguous ]] || park DIALOG "$stage" "$name" "$why, and the screen changed to something ship cannot read safely. Answer it in its pane, then resume."
  done
  log "workspace-trust dialog in $WT shown to $name; cursor on Yes after $downs down key(s), pressing Enter"
  mux send --to "$id" --keys enter >/dev/null 2>>"$LOG" || true
  end=$((SECONDS + TRUST_WAIT_S)); gone=0
  while [[ $SECONDS -lt $end ]]; do
    sleep "$POLL_S"
    screen="$(mux read --to "$id" --lines 40 2>/dev/null)" \
      || park DIALOG "$stage" "$name" "$why but its pane could not be read after Enter. Answer it in its pane, then resume."
    # a single blank read may be a redraw: the dialog counts as cleared after two in a row
    if [[ "$(trust_state <<<"$screen")" == none ]]; then gone=$((gone + 1)); else gone=0; fi
    [[ $gone -lt 2 ]] || return 0
  done
  park DIALOG "$stage" "$name" "$why after ship pressed Enter on it. Answer it in its pane, then resume."
}

# send_prompt <agent id> <text> [name stage] — a turn that never starts gets Enter pressed up to 3 times
# (a pasted prompt can be dropped while the harness is still starting). With a name, a send that fails
# because the agent is blocked is a dialog: the trust dialog is accepted and the send retried, any other
# dialog parks the unit as DIALOG.
send_prompt() {
  local id="$1" text="$2" name="${3:-}" stage="${4:-$STAGE}" rc=0 try
  mux send --to "$id" --text "$text" --wait-ms "$SEND_WAIT_MS" >/dev/null 2>>"$LOG" || rc=$?
  if [[ $rc -ne 0 && $rc -ne 4 && -n "$name" ]]; then
    agent_state "$id"
    if [[ "$L_STATE" == blocked ]]; then
      if trust_dialog "$name" "$id" "$stage"; then
        rc=0
        mux send --to "$id" --text "$text" --wait-ms "$SEND_WAIT_MS" >/dev/null 2>>"$LOG" || rc=$?
      else
        park DIALOG "$stage" "$name" "$name is blocked on a dialog and cannot take the prompt. Answer it in its pane, then resume. Screen: $(mux read --to "$id" --lines 15 2>/dev/null | tr -s ' \n' ' ' | cut -c1-500)"
      fi
    fi
  fi
  case $rc in
    0) return 0 ;;
    4) ;;
    *) log "send to $id failed (exit $rc)"; return 1 ;;
  esac
  for try in 1 2 3; do
    log "prompt to $id has not started a turn; pressing Enter ($try)"
    mux send --to "$id" --keys enter >/dev/null 2>>"$LOG" || true
    if mux wait --to "$id" --until working --timeout-ms 15000 >/dev/null 2>&1; then return 0; fi
  done
  log "prompt to $id never started a turn"
  return 1
}

# mark_sent <file> — record that the agent was prompted for <file> (after the prompt went out). A
# verdict the agent already wrote during the send is not made stale by the marker.
mark_sent() {
  printf '%s %s%s\n' "$(date +%s)" "$RANDOM" "$RANDOM" >>"$1.sent"
  # A verdict the agent wrote while the prompt was still going out is not older than its prompt.
  if [[ -s "$1" ]]; then touch -r "$1" "$1.sent" 2>/dev/null || true; fi
}
# mtime_s <file> — modification time in whole seconds
mtime_s() { stat -c %Y "$1" 2>/dev/null || stat -f %m "$1"; }

# fresh_result <file> — a valid verdict written after the last prompt
# A verdict is stale when its prompt marker is more than a second newer. Whole seconds, with that one
# second of slack: a verdict written right after the marker can carry an older timestamp (coarse file
# clocks), and calling it stale makes the driver delete a good answer and prompt again.
fresh_result() {
  local f="$1"
  valid_json "$f" && [[ -e "$f.sent" ]] || return 1
  ! sent_after_result "$f"
}
# sent_after_result <file> — the file exists and its prompt marker is more than a second newer
sent_after_result() {
  [[ -e "$1" && -e "$1.sent" ]] || return 1
  [[ $(( $(mtime_s "$1.sent") - $(mtime_s "$1") )) -gt 1 ]]
}

# limit_hit <agent name> <agent id> — print the matching line when the newest lines of the agent's screen
# (LIMIT_LINES, not the scrollback: quoted code and files it printed earlier are not a limit) show its harness's limit text
limit_hit() {
  local re screen
  re="$(jq -r --arg h "$(agent_harness "$1")" '.limits.patterns[$h] // empty' <<<"$SHIP_CONFIG_JSON")"
  [[ -n "$re" ]] || return 1
  screen="$(mux read --to "$2" --lines "$LIMIT_LINES" 2>/dev/null)" || return 1
  printf '%s\n' "$screen" | jq -Rr --arg re "$re" 'select(test($re))' 2>/dev/null | tail -n 1 | sed -E 's/^[^[:alnum:]]*//' | tr -s ' ' | cut -c1-160 | grep .
}

# await_file <name> <id> <file> <stage> <budget min> — wait for the agent to write its verdict.
# 0 written; 1 the agent is gone or stopped without writing (FAIL_WHY says which); 2 not JSON.
# Parks (DIALOG, LIMIT) and budget overruns exit the driver.
FAIL_WHY=""
await_file() {
  local name="$1" id="$2" file="$3" stage="$4" budget="$5" acc=0 seg now el lim st idle=0 nudges=0 hit ignored="" fo
  [[ -s "$file.clock" ]] && acc="$(cat "$file.clock")"
  seg="$(date +%s)"
  lim="$(awk -v m="$budget" 'BEGIN { printf "%d", m * 60 }')"
  while true; do
    if [[ -s "$file" ]]; then
      valid_json "$file" && return 0
    fi
    now="$(date +%s)"; el=$((acc + now - seg))
    printf '%s\n' "$el" >"$file.clock"
    if [[ $el -gt $lim ]]; then over_budget "$stage" "$name" "$file" "$budget" "$el"; fi
    agent_state "$id"; st="$L_STATE"
    # Claude shows its limit as a dialog, which reads as blocked: look for the limit text before parking a dialog.
    if [[ "$st" == blocked || "$st" == idle ]] && hit="$(limit_hit "$name" "$id")" && [[ "$hit" != "$ignored" ]]; then
      fo=0; failover_on_limit "$name" "$stage" "$file" "$hit" "$id" || fo=$?
      if [[ $fo -eq 3 ]]; then ignored="$hit"; sleep "$POLL_S"; continue; fi
      [[ $fo -eq 0 ]] || return 1
      # A new agent has the stage now; the time already used stays counted, the restart does not.
      id="$FO_ID"; acc="$el"; seg="$(date +%s)"; idle=0; nudges=0
      log "budget: ${el}s used before the failover stay counted"
      continue
    fi
    case "$st" in
      gone) FAIL_WHY="$name is gone"; return 1 ;;
      blocked)
        park DIALOG "$stage" "$name" "$name is blocked on a dialog. Answer it in its pane, then resume. Screen: $(mux read --to "$id" --lines 15 2>/dev/null | tr -s ' \n' ' ' | cut -c1-500)" "$file" ;;
      working) idle=0 ;;
      *)
        if [[ -s "$file" ]] && ! valid_json "$file"; then FAIL_WHY="$(basename "$file") is not valid JSON"; return 2; fi
        [[ $idle -gt 0 ]] || idle="$now"
        if [[ $((now - idle)) -ge $IDLE_GRACE_S ]]; then
          if [[ $nudges -ge 2 ]]; then FAIL_WHY="$name stopped without writing $(basename "$file")"; return 1; fi
          nudges=$((nudges + 1)); idle=0
          log "nudging $name ($nudges)"
          send_prompt "$id" "You stopped without writing $file. Finish the task, then write that file." "$name" "$stage" || { FAIL_WHY="$name did not take the nudge"; return 1; }
        fi ;;
    esac
    sleep "$POLL_S"
  done
}

step_failed() { # stage name file rc
  [[ "$4" -ne 2 ]] || die_error "$FAIL_WHY"
  park BLOCKED "$1" "$2" "$FAIL_WHY. See loop.log; write answer-<n>.md to nudge this agent, or resume without an answer to close it and retry the stage with a new agent" "$3"
}

# --- reactive failover ---------------------------------------------------------------------------
# stamp_failovers <agent> <verdict file> <stage> <round> — the verdict carries the number of failover-N.json
# files of this agent for this stage and round (the dev has one agent for develop and every fix round).
stamp_failovers() {
  local n tmp="$2.tmp"
  n="$(cat "$STATE"/failover-*.json 2>/dev/null | jq -s --arg a "$1" --arg s "$3" --argjson r "$4" \
    '[.[] | select(.agent == $a and .stage == $s and .round == $r)] | length' 2>/dev/null)"
  [[ -n "$n" ]] || return 0
  jq --argjson n "$n" '.failovers = $n' "$2" >"$tmp" 2>/dev/null && mv "$tmp" "$2" || rm -f "$tmp"
}

# stop_agent <name> <id> <harness> — ask the agent to exit, give it SHIP_FAILOVER_STOP_MS, close its pane.
# 1 when the pane could not be closed (the agent may still be there).
stop_agent() {
  local rc=0
  mux send --to "$2" --keys esc >/dev/null 2>>"$LOG" || true
  if [[ "$3" == claude ]]; then
    mux send --to "$2" --text /exit >/dev/null 2>>"$LOG" || true
  else
    mux send --to "$2" --keys ctrl+d >/dev/null 2>>"$LOG" || true
  fi
  mux wait --to "$2" --until gone --timeout-ms "$STOP_MS" >/dev/null 2>>"$LOG" || rc=$?
  [[ $rc -eq 0 || $rc -eq 5 ]] || log "$1 did not exit within ${STOP_MS} ms; closing its pane"
  mux close --id "$2" >/dev/null 2>>"$LOG" || { log "could not close $1 ($2)"; return 1; }
}

# limit_word <matched text> — the word of "hit your <word> limit", lower case; empty for a plain limit.
limit_word() { printf '%s' "$1" | tr 'A-Z' 'a-z' | sed -nE "s/.*hit your ([a-z-]+) limit.*/\\1/p"; }

# scrub_status — STATUS.md is read by the next agent, whose screen is searched for limit text: a line that
# quotes a limit message (either harness's pattern) is replaced.
scrub_status() {
  local f="$STATE/STATUS.md" pats
  # the scrub is stricter than the detection: loose built-in patterns, and the configured ones without their
  # line anchor, so a quotation anywhere in a line goes
  pats="$(jq -c '["you.{1,3}ve hit your ([a-z]+ )?limit", "\\b429\\b.{0,40}(too many requests|rate.?limit|status code|rate_limit_error)", "too many requests", "resource_exhausted", "(rate|usage) limit (has been )?(reached|exceeded|hit)", "quota (has been )?exceeded", "exceeded (your|the) (current )?(quota|rate limit|usage limit)"]
    + [.limits.patterns[]? | sub("^(?<f>\\(\\?[a-z]+\\))\\^"; "\(.f)") | sub("^\\^"; "")]' <<<"$SHIP_CONFIG_JSON")" || pats='[]'
  if jq -Rr --argjson p "$pats" 'if (. as $l | any($p[]; . as $re | $l | test($re; "i"))) then "[line removed: it quoted a provider message]" else . end' "$f" >"$f.tmp"; then
    mv "$f.tmp" "$f"
  else
    rm -f "$f.tmp"
    log "could not scrub STATUS.md; kept as written"
  fi
}

# git_facts_status <agent> <stage> — STATUS.md from git alone.
git_facts_status() {
  local f="$STATE/STATUS.md" ahead stat dirty
  ahead="$(git -C "$WT" log --oneline "origin/$BASE..HEAD" 2>/dev/null)"
  stat="$(git -C "$WT" diff --stat "origin/$BASE...HEAD" 2>/dev/null)"
  dirty="$(git -C "$WT" status --short 2>/dev/null)"
  {
    printf '# Handover (transcript not summarised)\n\n'
    printf 'Agent %s stopped during the %s stage and a successor continues. No summariser could read its transcript, so this note comes from git alone.\n\n' "$1" "$2"
    printf '## Done\n\nCommits on %s ahead of origin/%s:\n\n%s\n\nDiffstat against origin/%s:\n\n%s\n\n' "$BRANCH" "$BASE" "${ahead:-(none)}" "$BASE" "${stat:-(no changes)}"
    printf '## In progress\n\n'
    if [[ -n "$dirty" ]]; then printf 'Uncommitted changes in the worktree (git status --short):\n\n%s\n\n' "$dirty"; else printf 'No uncommitted changes. What the agent was doing when it stopped is unknown.\n\n'; fi
    printf '## Next steps\n\nRead the brief, compare the diff with it, and continue the %s stage from there. Check the gate before you declare the stage done.\n\n' "$2"
    printf '## Open questions\n\nUnknown: the transcript was not read.\n'
  } >"$f.tmp" && mv "$f.tmp" "$f"
}

# write_status <agent> <stage> <harness> <session> — write STATUS.md; sets SUM_MODEL to the summariser model,
# empty when the git-facts fallback was used. The summariser gets read-only access: claude runs under the verify
# role's profile (no MCP) with the Read tool only, pi with its read tool only and no session; the diff and the
# git state are written to files by the driver, so no shell tool is needed.
SUM_MODEL=""
write_status() {
  local name="$1" stage="$2" harness="$3" session="$4" saved m sh transcript f ptxt out pid t0 rc=0 cfgdir sumdir rout
  local rargs=() cargs=()
  SUM_MODEL=""
  out="$STATE/STATUS.md.tmp"
  saved="$SHIP_CONFIG_JSON"
  SHIP_CONFIG_JSON="$(jq -c '.models.summarizer = (.failover.summarizer // [])' <<<"$SHIP_CONFIG_JSON")"
  pick_model --dry summarizer 2>>"$LOG" || rc=$?
  SHIP_CONFIG_JSON="$saved"
  m="$PICK_MODEL"
  if [[ $rc -ne 0 || -z "$m" ]]; then
    log "no usable summariser (failover.summarizer); STATUS.md from git facts"
    git_facts_status "$name" "$stage"
    scrub_status
    return 0
  fi
  transcript="(not found)"
  if [[ "$harness" == claude ]]; then
    cfgdir="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
    for f in "$cfgdir"/projects/*/"$session".jsonl; do [[ -f "$f" ]] && transcript="$f"; done
  else
    f="$(ls -t "$session"/* 2>/dev/null | head -n 1)"
    [[ -z "$f" ]] || transcript="$f"
  fi
  sumdir="$STATE/summary"
  mkdir -p "$sumdir"
  { git -C "$WT" diff --no-color --no-ext-diff "origin/$BASE..." 2>&1 | head -c 400000; } >"$sumdir/diff.txt"
  { printf 'Commits ahead of origin/%s:\n' "$BASE"; git -C "$WT" log --oneline "origin/$BASE..HEAD" 2>&1
    printf '\nUncommitted files:\n'; git -C "$WT" status --short 2>&1; } >"$sumdir/git.txt"
  ptxt="$(render summarize ref="$REF" stage="$stage" worktree="$WT" base="$BASE" transcript="$transcript" \
    diff_file="$sumdir/diff.txt" git_file="$sumdir/git.txt")"
  printf '%s\n' "$ptxt" >"$STATE/summarize.prompt.md"
  sh="$(ship_model_parse "$m" | cut -f1)"
  if [[ "$sh" == claude ]]; then
    rout="$("$ROLE_BIN" verify --harness claude --cwd "$WT" 2>>"$LOG")" || rout=""
    if [[ -z "$rout" ]]; then
      log "ship-role verify failed for the summariser; STATUS.md from git facts"
      git_facts_status "$name" "$stage"; scrub_status
      return 0
    fi
    read -r -a rargs <<<"$rout"
    cargs=(-p --model "$m" ${rargs[@]+"${rargs[@]}"} --tools Read --allowedTools Read --no-session-persistence
      --add-dir "$sumdir" --add-dir "$(dirname "$transcript")")
    (cd "$WT" && exec claude "${cargs[@]}" <"$STATE/summarize.prompt.md") >"$out" 2>>"$LOG" &
  else
    (cd "$WT" && exec pi -p --model "$m" --no-session --tools read -ne -ns -np --no-mcp --no-context-files -- "$ptxt" </dev/null) >"$out" 2>>"$LOG" &
  fi
  pid=$!
  t0="$(date +%s)"
  while kill -0 "$pid" 2>/dev/null; do
    if [[ $(( $(date +%s) - t0 )) -ge $SUMMARY_TIMEOUT_S ]]; then kill "$pid" 2>/dev/null; log "summariser $m timed out"; break; fi
    sleep "$POLL_S"
  done
  rc=0; wait "$pid" 2>/dev/null || rc=$?
  if [[ $rc -eq 0 ]] && grep -qi '^## *done' "$out" && grep -qi '^## *in progress' "$out" \
    && grep -qi '^## *next steps' "$out" && grep -qi '^## *open questions' "$out"; then
    sed -n '/^## *[Dd]one/,$p' "$out" >"$STATE/STATUS.md.tmp2" && mv "$STATE/STATUS.md.tmp2" "$STATE/STATUS.md"
    rm -f "$out"
    SUM_MODEL="$m"
    log "STATUS.md written by $m"
  else
    log "summariser $m failed (exit $rc) or did not write the four sections; STATUS.md from git facts"
    rm -f "$out"
    git_facts_status "$name" "$stage"
  fi
  scrub_status
}

# failover_on_limit <agent> <stage> <verdict file> <matched text> <agent id> — an agent shows its harness's
# limit text. Records the limit, picks the next usable model after the agent's own, stops the agent,
# writes STATUS.md and starts the same stage again under the same name; sets FO_ID to the new agent.
# Nothing left to fail over to: parks LIMIT (exits). Returns 1 when the restart failed (FAIL_WHY says why).
FO_ID=""
failover_on_limit() {
  local name="$1" stage="$2" file="$3" matched="$4" old_id="$5" af
  af="$STATE/agents/$name.json"
  local cur role key harness session kind lkey lim_until cool block round="$CUR_ROUND" rc=0 nxt resets idx rec w lc text answer=""
  cur="$(jq -r .model "$af")"; role="$(jq -r .role "$af")"; key="$(jq -r .models_key "$af")"
  harness="$(jq -r .harness "$af")"; session="$(jq -r .session "$af")"
  kind=model; lkey="$cur"
  if [[ "$harness" == claude ]]; then
    kind=account; lkey="$(ship_quota_account)"
    w="$(limit_word "$matched")"; lc="$(printf '%s' "$cur" | tr 'A-Z' 'a-z')"
    case "$w" in
      '') ;;
      # the words of an account window; any other word names a model
      session|weekly|week|daily|day|hourly|hour|five-hour|monthly|month|usage|rate|account|plan|extra) ;;
      *) kind=model; case "$lc" in *"$w"*) lkey="$cur" ;; *) lkey="$w" ;; esac ;;
    esac
  fi
  block=""; lim_until=""
  if [[ "$kind" == account ]]; then
    block="$(ship_quota_block)"
    [[ -z "$block" ]] || lim_until="$(jq -r '.resets_at // empty' <<<"$block")"
  fi
  if [[ -z "$lim_until" ]]; then
    cool="$(cfg limits.cooldown_min)"; [[ -n "$cool" ]] || cool=60
    lim_until="$(awk -v n="$(date +%s)" -v c="$cool" 'BEGIN { printf "%d", n + c * 60 }')"
  fi
  ship_limit_record "$kind" "$lkey" "$lim_until" || log "could not write limited.json"
  log "LIMIT $name ($cur, $kind limit on $lkey): ${matched:-no text}"
  # A limit on another model than the one this agent runs on: recorded, this agent keeps going.
  if [[ "$kind" == model && "$harness" == claude && "$lkey" != "$cur" ]]; then
    log "limit on $lkey does not concern $name ($cur); no failover"
    return 3
  fi

  PICK_AFTER="$cur"
  pick_model "$key" "$name" "$stage" "$round" 2>>"$LOG" || rc=$?
  # shellcheck disable=SC2034  # read by pick_model
  PICK_AFTER=""
  case $rc in
    0) nxt="$PICK_MODEL" ;;
    2)
      resets="$(jq -nr --argjson a "$lim_until" --arg b "$PICK_RESETS_AT" '[$a, ($b | tonumber? // empty)] | min | todate')"
      park LIMIT "$stage" "$name" "$name hit a usage limit (${matched:-no text}); no other model to fail over to. Wait for the reset${resets:+ ($resets)}, or resume with a models.override" "$file" "$resets" ;;
    *) FAIL_WHY="could not pick a model to replace $name"; return 1 ;;
  esac

  stop_agent "$name" "$old_id" "$harness" || { FAIL_WHY="could not close $name to replace it"; return 1; }
  write_status "$name" "$stage" "$harness" "$session"

  idx=1
  while [[ -e "$STATE/failover-$idx.json" ]]; do idx=$((idx + 1)); done
  rec="$(jq -nc --arg stage "$stage" --argjson round "$round" --arg agent "$name" --arg from "$cur" --arg to "$nxt" \
    --arg kind "$kind" --arg matched "$matched" --arg sum "$SUM_MODEL" --arg st "$STATE/STATUS.md" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)" \
    --argjson block "${block:-null}" \
    '{stage:$stage, round:$round, agent:$agent, from:$from, to:$to, reason:"limit", limit_kind:$kind, matched:$matched,
      summarizer:(if $sum == "" then null else $sum end), status_md:$st, at:$at} + (if $block == null then {} else {quota:($block | del(.resets_at))} end)')"
  write_json "$STATE/failover-$idx.json" "$rec"
  check_verdict failover "$STATE/failover-$idx.json"
  log "FAILOVER limit $stage: $cur -> $nxt ($name; $kind limit; STATUS.md by ${SUM_MODEL:-git facts})"

  # The agent is replaced: its prompt marker goes. The successor's first prompt is the takeover text, then the
  # stage prompt, then the lead's answer if one had been delivered to the old agent (the same as a dev taken
  # over after its pane is gone).
  rm -f "$file" "$file.sent"
  start_agent "$name" "$role" "$key" "$nxt" || { FAIL_WHY="could not start $name on $nxt after the limit"; return 1; }
  FO_ID="$A_ID"
  [[ ! -s "$file.answer" ]] || answer="

---

$(cat "$file.answer")"
  text="$(render takeover stage_prompt="$(cat "${file%.json}.prompt.md" 2>/dev/null)" answer="$answer" worktree="$WT" status_file="$STATE/STATUS.md" \
    brief="$BRIEF" from="$cur" to="$nxt")"
  printf '%s\n' "$text" >"${file%.json}.takeover.md"
  send_prompt "$FO_ID" "$text" "$name" "$stage" || { FAIL_WHY="could not prompt $name after the failover to $nxt"; return 1; }
  mark_sent "$file"
  return 0
}

# run_step <agent name> <file> <prompt> <budget min> <stage> — prompt a live agent and wait for
# its verdict. Reuses a fresh verdict; reattaches (no new prompt) to a stage already in flight.
run_step() {
  local name="$1" file="$2" text="$3" budget="$4" stage="$5" id rc=0
  if fresh_result "$file"; then log "$name: reusing $(basename "$file")"; return 0; fi
  agent_lookup "$name"; id="$L_ID"
  [[ -n "$id" ]] || die_error "agent $name is not running"
  # SHIP_LOOP_AFTER_LOOKUP: a test seam, run here with the verdict file's path (to land a verdict in this window)
  [[ -z "${SHIP_LOOP_AFTER_LOOKUP:-}" ]] || "$SHIP_LOOP_AFTER_LOOKUP" "$file" >>"$LOG" 2>&1 || true
  # The agent may write its verdict while the lookup above runs, so decide again from what is on disk
  # now: a verdict that is not older than its prompt is simply picked up (await_file returns at once).
  if fresh_result "$file"; then log "$name: reusing $(basename "$file")"; return 0; fi
  if [[ -e "$file.sent" ]] && ! sent_after_result "$file" && agent_state "$id" && [[ "$L_STATE" != gone ]]; then
    log "reattaching to $name for $(basename "$file")"
  else
    [[ ! -e "$file" ]] || log "$name: $(basename "$file") is older than its prompt; prompting again"
    rm -f "$file" "$file.answer"
    [[ "$file" == "$KEEP_CLOCK" ]] || rm -f "$file.clock"
    printf '%s\n' "$text" >"${file%.json}.prompt.md"
    send_prompt "$id" "$text" "$name" "$stage" || { rm -f "$file.sent"; FAIL_WHY="could not prompt $name: ship-mux send failed or the turn never started (see loop.log; the agent may be gone)"; step_failed "$stage" "$name" "$file" 1; }
    mark_sent "$file"
  fi
  await_file "$name" "$id" "$file" "$stage" "$budget" || rc=$?
  [[ $rc -eq 0 ]] || step_failed "$stage" "$name" "$file" "$rc"
  stamp_failovers "$name" "$file" "$stage" "$CUR_ROUND"
}

# fresh_step <name> <role> <model key> <file> <prompt> <schema> <budget> <stage> [keep] — a fresh
# agent per stage, closed when its verdict is in (unless keep).
fresh_step() {
  local name="$1" role="$2" key="$3" file="$4" text="$5" schema="$6" budget="$7" stage="$8" keep="${9:-}" id
  if fresh_result "$file"; then
    log "$name already finished: reusing $(basename "$file")"
    [[ -n "$keep" ]] || close_agent "$name"
    check_verdict "$schema" "$file"
    return 0
  fi
  agent_lookup "$name"; id="$L_ID"; agent_state "$id"
  if [[ -z "$id" || "$L_STATE" == gone ]]; then
    # The stage continues the same run: the time already used stays counted (run_step keeps its clock).
    [[ ! -e "$file.clock" ]] || KEEP_CLOCK="$file"
    rm -f "$file" "$file.sent"
    start_agent "$name" "$role" "$key" || die_error "could not start $name; see loop.log"
  fi
  run_step "$name" "$file" "$text" "$budget" "$stage"
  check_verdict "$schema" "$file"
  [[ -n "$keep" ]] || close_agent "$name"
  return 0
}

# --- formatting ---------------------------------------------------------------------------------
fmt_findings() { jq -r '.findings // [] | to_entries[] | "\(.key+1). [\(.value.severity // "BLOCKING")] \(.value.file)\(if .value.line then ":\(.value.line)" else "" end) — \(.value.summary)\(if .value.fix then "\n   Fix: \(.value.fix)" else "" end)"' "$1"; }
fmt_failures() { jq -r '.failures // [] | to_entries[] | "\(.key+1). \(.value.what)\n   Evidence: \(.value.evidence)"' "$1"; }
fmt_gaps() {
  jq -r '.gaps // [] | to_entries[] | "\(.key+1). \(.value.where // "?")\(if .value.operator_call == true then " [operator call]" else "" end) — \(.value.question // "")"
    + (.value.quotes // [] | map("\n   Spec text: " + tostring) | join(""))' "$1"
}
fmt_removals() { # file kind
  jq -r --arg k "$2" '[.removals // [] | .[] | select(.kind == $k)] | to_entries[]
    | "\(.key+1). \(.value.where // "?") — \(.value.what // ""). No consumer: \(.value.why_no_consumer // "")"' "$1"
}
fmt_resolved() { jq -r '.resolved // [] | to_entries[] | "\(.key+1). \(.value.where // "?"): \(.value.says // "")\(if (.value.question // "") != "" then "\n   (settles: \(.value.question))" else "" end)"' "$1"; }
fmt_opq() { jq -r '.operator_questions // [] | to_entries[] | "\(.key+1). \(.value.where // "?") — \(.value.question // "")\(if (.value.options // "") != "" then " Options: \(.value.options)." else "" end)\(if (.value.recommendation // "") != "" then " Recommendation: \(.value.recommendation)." else "" end)"' "$1"; }
jlen() { jq -r --arg k "$2" '(.[$k] // []) | length' "$1"; }
rmlen() { jq -r --arg k "$2" '[.removals // [] | .[] | select(.kind == $k)] | length' "$1"; } # file kind
add_round() { ROUNDS="$(jq -c --argjson e "$1" '. + [$e]' <<<"$ROUNDS")"; }

# --- setup: the unit space and the dev ------------------------------------------------------------
open_out="$(mux open --cwd "$WT" --label "$REF" 2>>"$LOG")" || die_error "ship-mux open failed; see loop.log"
SPACE_ID="$(jq -r .space <<<"$open_out")"
DEV="$(aname -dev)"
# Files that belong to the unit, not to a run: an archive leaves them where they are (unit.json,
# driver.exit and config.json are ship-unit's).
KEEP_ON_ARCHIVE="mux.json loop.log driver.pid driver.err models.override unit.json driver.exit config.json"
A_ID="" TAKEOVER="" TAKEOVER_ANSWER="" FIX_SRC="" RESTART_DEV="" KEEP_CLOCK=""
# takeover_text — what a dev that replaces a gone one is told first
takeover_text() {
  printf 'You are taking over unit %s (PR #%s) from a previous dev agent that is gone. Its work is all in %s on branch %s, and nothing was reset. Before anything else read the brief (%s), then run `git -C %s status` and `git -C %s log origin/%s..HEAD`. Then do what follows.' \
    "$REF" "${PR:-?}" "$WT" "$BRANCH" "$BRIEF" "$WT" "$WT" "$BASE"
}
# resume_restart — a LIMIT park, or a BLOCKED park the lead left without an answer, ends with the parked
# agent closed and its stage cleared, so the stage starts again with a new agent (model_pick, so a
# models.override applies). Done before the dev is looked up: the parked agent may be the dev.
resume_restart() {
  local st agent n file
  [[ -s "$STATE/park.json" ]] || return 0
  st="$(jq -r .status "$STATE/park.json")"; agent="$(jq -r .agent "$STATE/park.json")"
  n="$(jq -r .n "$STATE/park.json")"; file="$(jq -r '.file // ""' "$STATE/park.json")"
  case "$st" in
    LIMIT) ;;
    BLOCKED) [[ ! -s "$STATE/answer-$n.md" ]] || return 0 ;;
    *) return 0 ;;
  esac
  agent_lookup "$agent"
  if [[ -n "$L_ID" ]]; then mux close --id "$L_ID" >/dev/null 2>>"$LOG" || log "could not close $agent ($L_ID)"; fi
  # The clock stays: the stage continues the same run and the budget already spent still counts.
  [[ -z "$file" ]] || rm -f "$file" "$file.sent"
  [[ "$agent" != "$DEV" ]] || RESTART_DEV=1
  KEEP_CLOCK="$file"
  mv "$STATE/park.json" "$STATE/park-$n.json"
  log "resumed from park $n ($st): $agent closed, its stage restarts with a new agent"
}
resume_restart
agent_lookup "$DEV"; DEV_ID="$L_ID"; agent_state "$DEV_ID"
if [[ -z "$DEV_ID" || "$L_STATE" == gone ]]; then
  if [[ -n "$RESTART_DEV" ]] || { valid_json "$STATE/develop.json" && [[ "$(jq -r .status "$STATE/develop.json")" == DONE ]]; }; then
    # develop is finished: the worktree holds the work and nothing is reset. A new dev takes over, and
    # every result stays. Prompts the old dev had in flight are forgotten so they are sent again.
    for _s in "$STATE"/fix-r*.json.sent; do
      [[ -e "$_s" && ! -e "${_s%.sent}" ]] && rm -f "$_s" "${_s%.sent}.clock"
    done
    TAKEOVER=1
    log "$DEV is gone and its run continues (develop.json DONE, or its park was restarted): a new dev takes over, results kept"
  else
    # No finished develop: this is a new run. Set the results of the earlier run (answers and extensions
    # too, they belong to its numbering) aside.
    _old=""
    for _f in "$STATE"/*; do
      [[ -f "$_f" ]] || continue
      case " $KEEP_ON_ARCHIVE " in *" ${_f##*/} "*) continue ;; esac
      [[ -n "$_old" ]] || { _old="$STATE/run-$(date +%Y%m%d-%H%M%S)"; mkdir -p "$_old"; }
      mv "$_f" "$_old"/
    done
    [[ -z "$_old" ]] || log "archived the previous run's results to $_old"
  fi
  STAGE=develop
  start_agent "$DEV" dev dev || die_error "dev agent did not start; see loop.log"
  DEV_ID="$A_ID"
  log "dev $DEV is $DEV_ID in space $SPACE_ID"
else
  log "reusing $DEV ($DEV_ID)"
fi

# --- resume: what the lead left for a parked or over-budget unit -------------------------------
resume_park() {
  local st stage agent n file ans id atext who
  [[ -s "$STATE/park.json" ]] || return 0
  st="$(jq -r .status "$STATE/park.json")"; stage="$(jq -r .stage "$STATE/park.json")"
  agent="$(jq -r .agent "$STATE/park.json")"; n="$(jq -r .n "$STATE/park.json")"
  file="$(jq -r '.file // ""' "$STATE/park.json")"
  STAGE="$stage"
  agent_lookup "$agent"; id="$L_ID"; agent_state "$id"
  case "$st" in
    QUESTION|BLOCKED|OPERATOR)
      ans="$STATE/answer-$n.md"
      if [[ -n "$file" && -e "$file.operator" && ! -s "$ans" ]]; then
        log "still parked (OPERATOR): waiting for $ans"
        finish 2 "$stage" PARKED "$(jq -c '{park:.}' "$STATE/park.json")"
      elif [[ -z "$id" || "$L_STATE" == gone ]]; then
        log "parked agent $agent is gone: the stage will be restarted"
      elif [[ "$agent" == "$DEV" && -n "$file" && ! -e "$file.sent" ]]; then
        # The dev that asked is gone and a new one took over without ever being prompted for this stage:
        # the answer goes into its first prompt (takeover text, stage prompt, answer in one message).
        if [[ -s "$ans" ]]; then
          # TAKEOVER is set above when the dev was replaced; a live dev whose prompt failed to go out is spoken to as itself
          if [[ -n "$TAKEOVER" ]]; then who="The previous dev stopped with this ($st):"; else who="You were parked earlier ($st):"; fi
          TAKEOVER_ANSWER="$who
$(jq -r '.question // ""' "$STATE/park.json")
The lead answers:
$(cat "$ans")"
          log "answer-$n.md will go to the new $agent in its first prompt"
        else
          log "still parked ($st): waiting for $ans"
          finish 2 "$stage" PARKED "$(jq -c '{park:.}' "$STATE/park.json")"
        fi
      elif [[ -s "$ans" ]]; then
        [[ -z "$file" ]] || rm -f "$file"
        atext="Answer from the lead to your $st:
$(cat "$ans")
Continue the task. When it is complete, write the result file ${file:-you were given} again."
        send_prompt "$id" "$atext" "$agent" "$stage" || die_error "could not deliver answer-$n.md to $agent"
        # kept so that a successor (after a usage limit) is told the answer again
        [[ -z "$file" ]] || { printf '%s\n' "$atext" >"$file.answer"; mark_sent "$file"; }
        log "delivered answer-$n.md to $agent"
      else
        log "still parked ($st): waiting for $ans"
        finish 2 "$stage" PARKED "$(jq -c '{park:.}' "$STATE/park.json")"
      fi ;;
    DIALOG)
      if [[ -n "$id" && "$L_STATE" == blocked ]]; then
        log "still parked (DIALOG): $agent is still blocked"
        finish 2 "$stage" PARKED "$(jq -c '{park:.}' "$STATE/park.json")"
      fi ;;
    LIMIT) ;;
  esac
  mv "$STATE/park.json" "$STATE/park-$n.json"
  log "resumed from park $n ($st)"
}
resume_budget() {
  local b stage file mins
  for b in "$STATE"/budget-r*.json; do
    [[ -f "$b" && ! -e "$b.handled" ]] || continue
    stage="$(jq -r .stage "$b")"; file="$STATE/$(jq -r '.file // ""' "$b")"
    if [[ -s "$STATE/extend" ]]; then
      mins="$(cat "$STATE/extend")"
      case "$mins" in ''|*[!0-9.]*) die_error "extend file must hold a number of minutes (got '$mins')" ;; esac
      awk -v a="$( [[ -s "$file.extra" ]] && cat "$file.extra" || echo 0 )" -v b="$mins" 'BEGIN { print a + b }' >"$file.extra"
      mv "$STATE/extend" "$STATE/extend.applied"
      touch "$b.handled"
      log "extended $stage by $mins min"
    else
      STAGE="$stage"
      log "still over budget: $stage; resume with --extend"
      finish 2 "$stage" OVER-BUDGET "$(jq -c '{budget:.}' "$b")"
    fi
  done
}
resume_park
resume_budget

# --- stage helpers -------------------------------------------------------------------------------
# dev_ok <file> <stage> — DONE continues; QUESTION and BLOCKED park the unit (the dev stays alive).
dev_ok() {
  local f="$1" stage="$2" st q
  st="$(jq -r .status "$f")"
  [[ "$st" == DONE ]] && return 0
  q="$(jq -r 'if (.question // "") == "" then "(no question text; the dev summary follows) " + (.summary // "") else .question end' "$f")"
  park_result "$f" "$st" "$stage" "$DEV" "$q"
}

# fix_round <round> <findings> <count> — the same dev fixes; file fix-r<round>.json. <count> is how many
# findings the text holds (1 for a problem that is only text); it sets the round's budget.
fix_round() {
  local r="$1" findings="$2" n="$3" f="$STATE/fix-r$1.json" text
  STAGE=fix CUR_ROUND="$r"
  printf '%s\n' "$findings" >"$STATE/fix-r$r.findings"; printf '%s\n' "$FIX_SRC" >"$STATE/fix-r$r.src"
  printf '%s\n' "$n" >"$STATE/fix-r$r.n"
  text="$(prompt fix round="$r" pending="$findings" verdict_file="$f")"
  # (a fix that is already in is replayed, not prompted: the takeover text and the lead's answer wait for the step that is)
  if ! fresh_result "$f"; then
    if [[ -n "$TAKEOVER" ]]; then
      text="$(takeover_text)

$text"
      TAKEOVER=""
    fi
    if [[ -n "$TAKEOVER_ANSWER" ]]; then
      text="$text

$TAKEOVER_ANSWER
Continue from there."
      TAKEOVER_ANSWER=""
    fi
  fi
  # What the diff was when the dev was prompted: written once, so a resumed fix is compared with it.
  if [[ ! ( -e "$f.sent" && -s "$STATE/fix-r$r.before" ) ]]; then diff_sig; printf '%s\n' "$DSIG" >"$STATE/fix-r$r.before"; fi
  run_step "$DEV" "$f" "$text" "$(budget_min fix "$f" "$n")" fix
  check_verdict develop "$f"
  dev_ok "$f" fix
  log "round $r fixed at $(jq -r '.head // "?"' "$f")"
}

spec_touched() {
  [[ ${#SPEC_PATHS[@]} -gt 0 ]] || return 1
  ! git -C "$WT" diff --quiet "origin/$BASE...HEAD" -- "${SPEC_PATHS[@]}"
}
spec_required() { spec_touched || grep -qiE '^[[:space:]]*Spec:[[:space:]]*required' "$BRIEF"; }

# --- develop ---------------------------------------------------------------------------------------
STAGE=develop
f="$STATE/develop.json"
text="$(prompt develop verdict_file="$f")"
# (a develop.json that is already in is reused: the takeover text then belongs to the first fix round)
if ! fresh_result "$f"; then
  if [[ -n "$TAKEOVER" ]]; then
    text="$(takeover_text)

$text"
    TAKEOVER=""
  fi
  if [[ -n "$TAKEOVER_ANSWER" ]]; then
    text="$text

$TAKEOVER_ANSWER
Continue from there."
    TAKEOVER_ANSWER=""
  fi
fi
run_step "$DEV" "$f" "$text" "$(budget_min develop "$f")" develop
check_verdict develop "$f"
dev_ok "$f" develop
PR="$(jq -r '.pr // empty' "$f")"
[[ -n "$PR" ]] || die_error "develop.json is DONE but names no pr; the dev must open the PR"
log "PR #$PR opened"

# --- spec writer: GAP and spec-text REMOVE ---------------------------------------------------------
# Runs a fresh spec writer on the gaps and spec removals of <from> (the spec check's result), then
# sets pending and spec_pending for the next round. Code removals and findings go to the dev.
spec_write() { # source from round
  local src="$1" from="$2" r="$3" w wf extra="" gaps removals commits nres v text q
  STAGE=specwriter CUR_ROUND="$r"
  w="$(aname "-specwriter-r$r")"; wf="$STATE/specwriter-r$r.json"
  local ngaps nop pn ans
  ngaps="$(jlen "$from" gaps)"
  nop="$(jq '[.gaps // [] | .[] | select(.operator_call == true)] | length' "$from")"
  if [[ "$nop" -gt 0 && "$nop" -eq "$ngaps" && -z "$(fmt_removals "$from" spec)" ]]; then
    # Every gap waits on the operator: nothing for the writer to do until there is an answer.
    if [[ -s "$wf.operator" ]]; then
      ans="$STATE/answer-$(cat "$wf.operator").md"
      [[ -s "$ans" ]] || die_error "specwriter-r$r waits on the operator but $(basename "$ans") is empty"
      extra="The operator has ruled on the gaps marked [operator call]:
$(cat "$ans")
Write the spec text that records that ruling."
    else
      pn=1
      while [[ -e "$STATE/park-$pn.json" ]]; do pn=$((pn + 1)); done
      printf '%s\n' "$pn" >"$wf.operator"
      park OPERATOR specwriter "$w" "Every gap is an operator call; no writer was started. $(fmt_gaps "$from" | tr '\n' ' ')" "$wf"
    fi
  elif [[ "$nop" -gt 0 ]]; then
    extra="Gaps marked [operator call] wait on the operator: do not write text for them; put them in operator_questions with the options and your recommendation."
  fi
  gaps="$(fmt_gaps "$from")"; removals="$(fmt_removals "$from" spec)"
  [[ -n "$gaps" ]] || gaps="(none)"
  [[ -n "$removals" ]] || removals="(none)"
  text="$(prompt specwriter round="$r" source="$src" gaps="$gaps" removals="$removals" extra="$extra" verdict_file="$wf")"
  fresh_step "$w" spec spec_write "$wf" "$text" specwriter "$(budget_min check "$wf")" specwriter keep
  v="$(jq -r .status "$wf")"
  if [[ "$v" == OPERATOR ]]; then
    q="$(fmt_opq "$wf")"
    [[ -n "$q" ]] || q="(no operator_questions; the writer's result follows) $(jq -c . "$wf")"
    park_result "$wf" OPERATOR specwriter "$w" "$q"
  fi
  nres="$(jlen "$wf" resolved)"
  [[ "$nres" -gt 0 ]] || die_error "$(basename "$wf") is WRITTEN with nothing resolved"
  close_agent "$w"
  SW_RUNS=$((SW_RUNS + 1))
  commits="$(jq -r '.commits // [] | join(", ")' "$wf")"
  SW_COMMITS="$(jq -c --slurpfile s "$wf" '. + ($s[0].commits // [])' <<<"$SW_COMMITS")"
  add_round "$(jq -nc --argjson r "$r" --arg v "SPECWRITER-$v" --argjson n "$nres" --argjson c "$(jlen "$wf" commits)" \
    '{round:$r, verdict:$v, resolved:$n, specCommits:$c}')"
  log "round $r spec writer $v ($nres resolved; commits: ${commits:-none})"
  pending="The spec changed under this PR: the $src found problems, and the spec author settled them in commits already on $BRANCH in $WT (${commits:-see git log}). The spec now says:
$(fmt_resolved "$wf")
Make the code and tests match the spec exactly; do not edit the spec files. If the new text cannot be implemented as written, stop with status QUESTION and say why."
  pending_n="$nres"
  spec_pending="In round $r the $src found spec problems, which the spec author settled (${commits:-see git log}). Check the new text first, against the rulings and the code at HEAD:
$(fmt_resolved "$wf")
"
  add_dev_work "$from" "the $src"
}
# add_dev_work <spec result> <who> — append the findings and code removals of a result to pending
add_dev_work() {
  local from="$1" who="$2" n nr
  n="$(jlen "$from" findings)"; nr="$(fmt_removals "$from" code)"
  pending_n=$((pending_n + n + $(rmlen "$from" code)))
  if [[ "$n" -gt 0 ]]; then
    pending="$pending
$who also asks for these code changes:
$(fmt_findings "$from")"
  fi
  if [[ -n "$nr" ]]; then
    pending="$pending
$who found code with no consumer named in the brief's Consumers section. Remove it (and its tests) in this round:
$nr"
  fi
}

# do_review <round> <prior> — a fresh reviewer on the PR at HEAD; sets RV_VERDICT and RV_N.
do_review() {
  local r="$1" prior="$2" rf="$STATE/review-r$1.json" rtext
  STAGE=review CUR_ROUND="$r"
  # What this review is shown: written when the prompt goes out, never when a finished review is replayed.
  write_sig "$rf"
  pick_model --dry review
  rtext="$(prompt review round="$r" skill_call="$(skill_call code-review "$PICK_MODEL")" prior="$prior" \
    review_instructions="$(file_text "$REVIEW_INSTR_FILE")" verdict_file="$rf")"
  fresh_step "$(aname "-review-r$r")" review review "$rf" "$rtext" review "$(budget_min check "$rf")" review
  RV_VERDICT="$(jq -r .verdict "$rf")"; RV_N="$(jlen "$rf" findings)"
  add_round "$(jq -nc --argjson r "$r" --arg v "$RV_VERDICT" --argjson n "$RV_N" '{round:$r, verdict:$v, findings:$n}')"
  log "round $r review $RV_VERDICT ($RV_N findings)"
}
# reviewed_diff — the diff as it is now has a READY (ACCEPT) review that was shown exactly this diff.
# The only thing that lets finalize push.
reviewed_diff() {
  local cur rv sig
  diff_sig; cur="$DSIG"
  rejected_diff && return 1
  for rv in "$STATE"/review-r*.json "$STATE"/final-r*.json; do
    [[ -f "$rv" ]] && fresh_result "$rv" || continue
    [[ "$(jq -r .verdict "$rv" 2>/dev/null)" == ACCEPT ]] || continue
    sig="${rv%.json}.sig"
    [[ -s "$sig" && "$(cat "$sig")" == "$cur" ]] && return 0
  done
  return 1
}
# diff_sig — sets DSIG to a signature of what the PR changes. Never run it in $( ) or with its output
# redirected: a failure ends the driver through die_error, which must run in the main shell to write the
# one ERROR result (a subshell's exit leaves the exit trap to overwrite it).
# (git patch-id --verbatim: line numbers do not count, so a rebase that only shifts lines keeps it; whitespace does, since it can change what code does.)
# Both the signature stored with a review and the one the push is checked against come from this function.
DSIG=""
diff_sig() {
  # Fail closed: a git that cannot compute the signature (too old for --verbatim, a missing origin/$BASE)
  # ends the run, because an equal fake signature on both sides would let any diff through the push check.
  local d sig
  DSIG=""
  d="$(git -C "$WT" diff -U0 --no-color "origin/$BASE...HEAD" 2>>"$LOG")" || die_error "git diff origin/$BASE...HEAD failed; see loop.log"
  if [[ -z "$d" ]]; then DSIG=empty; return 0; fi
  sig="$(printf '%s\n' "$d" | git patch-id --verbatim 2>>"$LOG")" || die_error "git patch-id --verbatim failed (git 2.39 or newer is required); see loop.log"
  sig="${sig%% *}"
  [[ -n "$sig" ]] || die_error "git patch-id produced no signature; see loop.log"
  DSIG="$sig"
}
# write_sig <verdict file> — store the diff an agent is shown next to its verdict (<stage>.sig), when the
# prompt goes out; a finished verdict that is replayed keeps the signature it was written with.
write_sig() {
  if [[ ! -e "$1.sent" ]] || sent_after_result "$1"; then
    diff_sig
    printf '%s\n' "$DSIG" >"${1%.json}.sig"
  fi
}
# rejected_diff — sets REJECTED_BY (a verdict file name) and returns 0 when the diff as it is now was rejected
# by the spec check or by the final gate. Decided per stage: a stage rejects the diff when its newest verdict
# on exactly this diff is not ACCEPT; the other stage's ACCEPT does not clear it. A revert to such a diff must
# not ride on the code review that once accepted it.
REJECTED_BY=""
rejected_diff() {
  local stage f n sig best bestn
  diff_sig
  REJECTED_BY=""
  for stage in spec final; do
    best="" bestn=-1
    for f in "$STATE/$stage"-r*.json; do
      [[ -f "$f" ]] && fresh_result "$f" || continue
      sig="${f%.json}.sig"
      [[ -s "$sig" && "$(cat "$sig")" == "$DSIG" ]] || continue
      n="${f##*-r}"; n="${n%.json}"
      [[ "$n" =~ ^[0-9]+$ ]] || continue
      if [[ $n -gt $bestn ]]; then best="$f"; bestn=$n; fi
    done
    if [[ -n "$best" && "$(jq -r .verdict "$best" 2>/dev/null)" != ACCEPT ]]; then
      REJECTED_BY="$(basename "$best")"
      return 0
    fi
  done
  return 1
}

# --- rounds ------------------------------------------------------------------------------------------
pending="" pending_n=0 spec_pending="" final_pending="" accepted="" last=review ACC_R=0
for ((r = 1; r <= MAX; r++)); do
  fixed=""
  if [[ -n "$pending" ]]; then
    fixed="$pending"
    fix_round "$r" "$pending" "$pending_n"
    pending=""
  fi

  # verify
  STAGE=verify CUR_ROUND="$r"
  vf="$STATE/verify-r$r.json"
  if [[ -z "$VERIFY_INSTR_FILE" ]]; then
    [[ -s "$vf" ]] || write_json "$vf" '{"verdict":"SKIP","summary":"no stages.verify.instructions configured","failures":[]}'
  else
    vtext="$(prompt verify round="$r" verify_instructions="$(file_text "$VERIFY_INSTR_FILE")" verdict_file="$vf")"
    vname="$(aname "-verify-r$r")"
    fresh_step "$vname" verify verify "$vf" "$vtext" verify "$(budget_min check "$vf")" verify keep
    if [[ "$(jq -r .verdict "$vf")" == BLOCKED ]]; then
      # The verifier could not verify: the unit parks with the verifier kept alive for the lead's answer.
      park_result "$vf" BLOCKED verify "$vname" "verify was blocked: $(jq -r .summary "$vf")"
    fi
    close_agent "$vname"
  fi
  vv="$(jq -r .verdict "$vf")"
  log "round $r verify $vv"
  if [[ "$vv" == FAIL ]]; then
    [[ "$(jlen "$vf" failures)" -gt 0 ]] || die_error "$(basename "$vf") is FAIL with no failures"
    pending="$(fmt_failures "$vf")" pending_n="$(jlen "$vf" failures)"
    add_round "$(jq -nc --argjson r "$r" '{round:$r, verdict:"VERIFY-FAIL"}')"
    last=verify
    continue
  fi

  # review
  STAGE=review last=review
  rf="$STATE/review-r$r.json"
  prior=""
  [[ -z "$fixed" ]] || prior="The previous round's findings, which the dev says are fixed. Verify each one against the current head before looking for new issues:
$fixed"
  do_review "$r" "$prior"
  if [[ "$RV_VERDICT" != ACCEPT ]]; then
    [[ "$RV_N" -gt 0 ]] || die_error "$(basename "$rf") is CHANGES with no findings"
    pending="$(fmt_findings "$rf")" pending_n="$RV_N"
    continue
  fi

  # spec check: only after the code review accepts; code changes it asks for are a normal fix round
  if spec_required; then
    STAGE=spec last=spec CUR_ROUND="$r"
    sf="$STATE/spec-r$r.json"
    SPEC_ROUNDS=$((SPEC_ROUNDS + 1))
    write_sig "$sf"
    stext="$(prompt spec round="$r" spec_pending="$spec_pending" verdict_file="$sf")"
    fresh_step "$(aname "-spec-r$r")" spec spec_check "$sf" "$stext" spec "$(budget_min check "$sf")" spec
    SPEC_VERDICT="$(jq -r .verdict "$sf")"
    n="$(jlen "$sf" findings)"; ng="$(jlen "$sf" gaps)"; nrm="$(jlen "$sf" removals)"; nc="$(jlen "$sf" commits)"
    add_round "$(jq -nc --argjson r "$r" --arg v "SPEC-$SPEC_VERDICT" --argjson n "$n" --argjson g "$ng" --argjson m "$nrm" --argjson c "$nc" \
      '{round:$r, verdict:$v, findings:$n, gaps:$g, removals:$m, specCommits:$c}')"
    log "round $r spec $SPEC_VERDICT ($n findings, $ng gaps, $nrm removals, $nc spec commits)"
    case "$SPEC_VERDICT" in
      ACCEPT)
        [[ $((ng + nrm)) -eq 0 ]] || die_error "$(basename "$sf") is ACCEPT but lists gaps or removals"
        spec_pending="" ;;
      GAP)
        [[ "$ng" -gt 0 ]] || die_error "$(basename "$sf") is GAP with no gaps"
        spec_write "spec checker" "$sf" "$r"
        continue ;;
      REMOVE)
        [[ "$nrm" -gt 0 ]] || die_error "$(basename "$sf") is REMOVE with no removals"
        if [[ -n "$(fmt_removals "$sf" spec)" ]]; then
          spec_write "spec checker" "$sf" "$r"
        else
          pending="The spec check found elements with no consumer." pending_n=0
          spec_pending="In round $r the spec check asked for removals; the dev removed them. Check they are gone and nothing else broke:
$(fmt_removals "$sf" code)
"
          add_dev_work "$sf" "the spec check"
        fi
        continue ;;
      *)
        [[ "$n" -gt 0 ]] || die_error "$(basename "$sf") is CHANGES with no findings"
        SPEC_VERDICT=CHANGES
        pending="$(fmt_findings "$sf")" pending_n="$n"
        spec_pending="Your previous spec round's findings, which the dev says are fixed. Check each one first:
$pending
"
        continue ;;
    esac
  else
    SPEC_VERDICT=SKIP
    log "round $r spec SKIP (no spec hunks, brief does not require it)"
  fi

  # final gate: the whole PR against the brief and the specs it touches
  if [[ $FINAL_GATE -eq 0 ]]; then accepted=1; ACC_R=$r; break; fi
  STAGE=final last=final CUR_ROUND="$r"
  ff="$STATE/final-r$r.json"
  FINAL_ROUNDS=$((FINAL_ROUNDS + 1))
  write_sig "$ff"
  ftext="$(prompt final round="$r" final_pending="$final_pending" verdict_file="$ff")"
  fresh_step "$(aname "-final-r$r")" review final "$ff" "$ftext" review "$(budget_min check "$ff")" final
  FINAL_VERDICT="$(jq -r .verdict "$ff")"; n="$(jlen "$ff" findings)"
  add_round "$(jq -nc --argjson r "$r" --arg v "FINAL-$FINAL_VERDICT" --argjson n "$n" '{round:$r, verdict:$v, findings:$n}')"
  log "round $r final $FINAL_VERDICT ($n findings)"
  if [[ "$FINAL_VERDICT" == ACCEPT ]]; then accepted=1; ACC_R=$r; break; fi
  [[ "$n" -gt 0 ]] || die_error "$(basename "$ff") is CHANGES with no findings"
  pending="$(fmt_findings "$ff")" pending_n="$n"
  final_pending="Your previous round's findings, which the dev says are fixed. Check each one first:
$pending
"
done
if [[ -z "$accepted" ]]; then
  log "STUCK after $MAX rounds ($last)"
  finish 2 "$last" STUCK "$(jq -n --arg f "$pending" '{findings:$f}')"
fi

# --- finalize ----------------------------------------------------------------------------------------
# The driver rebases, runs the gate, scans the added lines and pushes. Anything wrong goes back to the
# dev as a fix finding (at most twice); the dev's space stays open until the unit is landed.
forbidden_scan() { # prints offending added lines; returns 1 on a bad regex
  local pats file g skip out rc=0
  pats="$(jq -c '.scan.forbidden // []' <<<"$SHIP_CONFIG_JSON")"
  [[ "$pats" != "[]" ]] || return 0
  while IFS= read -r file; do
    [[ -n "$file" ]] || continue
    skip=0
    while IFS= read -r g; do
      [[ -n "$g" ]] || continue
      # shellcheck disable=SC2254  # the user's glob is meant as a pattern
      case "$file" in $g) skip=1 ;; esac
    done < <(jq -r '.scan.exclude // [] | .[]' <<<"$SHIP_CONFIG_JSON")
    [[ $skip -eq 0 ]] || continue
    out="$(git -C "$WT" diff -U0 --no-color "origin/$BASE..HEAD" -- "$file" \
      | jq -Rr --argjson p "$pats" --arg f "$file" 'select(startswith("+") and (startswith("+++") | not))
          | . as $l | ($p[] | select(. as $re | $l | test($re))) as $m | "\($f): \($l[1:]) (matches \($m))"' 2>&1)" || rc=1
    [[ -z "$out" ]] || printf '%s\n' "$out"
  done < <(git -C "$WT" diff --name-only "origin/$BASE..HEAD")
  return $rc
}

# finalize_try — 0 pushed (finalize.json written); 1 the dev has to fix something (FIN_MSG says what);
# 2 the diff after the rebase is not one a reviewer accepted: nothing was pushed
FIN_MSG=""
finalize_try() {
  local out files ahead gate_out hits head
  git -C "$WT" fetch origin >>"$LOG" 2>&1 || die_error "git fetch origin failed in $WT; see loop.log"
  if ! out="$(git -C "$WT" rebase "origin/$BASE" 2>&1)"; then
    files="$(git -C "$WT" diff --name-only --diff-filter=U | tr '\n' ' ')"
    git -C "$WT" rebase --abort >/dev/null 2>&1 || true
    FIN_MSG="1. [BLOCKING] $BRANCH — rebasing onto origin/$BASE failed${files:+ with conflicts in: $files}.
   Fix: in $WT run \`git rebase origin/$BASE\`, resolve the conflicts keeping both sides' intent (a conflict that needs a design choice: stop with status QUESTION), finish the rebase, run the gate, and \`git push --force-with-lease\`. git said: $(tr '\n' ' ' <<<"$out" | cut -c1-400)"
    return 1
  fi
  ahead="$(git -C "$WT" rev-list --count "origin/$BASE..HEAD")"
  [[ "$ahead" -gt 0 ]] || die_error "$BRANCH has no commits ahead of origin/$BASE after the rebase"
  if ! gate_out="$( (cd "$WT" && bash -c "$GATE") 2>&1)"; then
    printf '%s\n' "$gate_out" >"$STATE/gate.log"
    FIN_MSG="1. [BLOCKING] $BRANCH — the gate failed after the rebase onto origin/$BASE.
   Fix: make the gate pass in $WT (\`$GATE\`), commit, and push. Last lines:
$(printf '%s\n' "$gate_out" | tail -n 30)"
    return 1
  fi
  printf '%s\n' "$gate_out" >"$STATE/gate.log"
  hits="$(forbidden_scan)" || die_error "scan.forbidden holds an invalid regular expression: $hits"
  if [[ -n "$hits" ]]; then
    FIN_MSG="1. [BLOCKING] $BRANCH — added lines match scan.forbidden:
$(printf '%s\n' "$hits" | head -n 30)
   Fix: reword or remove each hit in a commit, run the gate, and push."
    return 1
  fi
  # The one push invariant: only a diff that a READY review was shown goes out.
  if ! reviewed_diff; then log "the diff to push has no READY review; reviewing it first"; return 2; fi
  git -C "$WT" push -q --force-with-lease origin "HEAD:refs/heads/$BRANCH" >>"$LOG" 2>&1 \
    || die_error "git push --force-with-lease failed for $BRANCH; see loop.log"
  head="$(git -C "$WT" rev-parse --short HEAD)"
  write_json "$STATE/finalize.json" "$(jq -n --argjson pr "$PR" --arg h "$head" --arg b "$BASE" \
    '{status:"DONE", pr:$pr, head:$h, summary:("rebased onto origin/" + $b + ", gate passed, scan clean, pushed"), failovers:0}')"
  return 0
}

# rejection_text <verdict file> — what a rejecting stage asked for: its findings, and for the spec check its
# gaps and removals (GAP and REMOVE verdicts carry no findings).
rejection_text() {
  fmt_findings "$1"
  if [[ "$(basename "$1")" == spec-* ]]; then
    fmt_gaps "$1"; fmt_removals "$1" code; fmt_removals "$1" spec
  fi
}

# RECHECK — the stage (spec or final) that rejected a diff the dev then fixed in finalize (the gate-restore
# branch of review_gate). The push needs that stage's ACCEPT on the diff being pushed, as well as a READY review.
# It is kept in the state dir so a restarted driver still owes the re-check.
RECHECK="$(cat "$STATE/recheck" 2>/dev/null || true)"
# recheck_diff — 0 when no stage is owed a re-check or it ACCEPTs the diff as it is now; 1 when it rejects it:
# NEED_FIX, FIX_SRC and GATE_PRIOR then send the dev back, counting toward the same cap as every other cycle.
recheck_diff() {
  local f sig verdict n ng nrm rf rej prior text
  [[ -n "$RECHECK" ]] || return 0
  diff_sig
  for f in "$STATE/$RECHECK"-r*.json; do
    [[ -f "$f" ]] && fresh_result "$f" || continue
    sig="${f%.json}.sig"
    [[ -s "$sig" && "$(cat "$sig")" == "$DSIG" && "$(jq -r .verdict "$f" 2>/dev/null)" == ACCEPT ]] && return 0
  done
  if [[ "$RECHECK" == spec ]] && ! spec_required; then return 0; fi
  # the review of this diff took round FR; the stage takes the same number unless it already has a verdict there
  while [[ -e "$STATE/$RECHECK-r$FR.json" ]]; do FR=$((FR + 1)); done
  rf="$STATE/$RECHECK-r$FR.json"
  prior="${RECHECK_PRIOR:-The dev changed the PR to answer your earlier rejection. Check each of those findings first.}"
  STAGE=$RECHECK CUR_ROUND="$FR"
  write_sig "$rf"
  if [[ "$RECHECK" == spec ]]; then
    SPEC_ROUNDS=$((SPEC_ROUNDS + 1))
    text="$(prompt spec round="$FR" spec_pending="$prior
" verdict_file="$rf")"
    fresh_step "$(aname "-spec-r$FR")" spec spec_check "$rf" "$text" spec "$(budget_min check "$rf")" spec
  else
    FINAL_ROUNDS=$((FINAL_ROUNDS + 1))
    text="$(prompt final round="$FR" final_pending="$prior
" verdict_file="$rf")"
    fresh_step "$(aname "-final-r$FR")" review final "$rf" "$text" review "$(budget_min check "$rf")" final
  fi
  verdict="$(jq -r .verdict "$rf")"
  n="$(jlen "$rf" findings)"; ng="$(jlen "$rf" gaps)"; nrm="$(jlen "$rf" removals)"
  add_round "$(jq -nc --argjson r "$FR" --arg v "$(tr a-z A-Z <<<"$RECHECK")-$verdict" --argjson n "$n" '{round:$r, verdict:$v, findings:$n}')"
  log "round $FR $RECHECK re-check of the fixed diff: $verdict ($n findings, $ng gaps, $nrm removals)"
  if [[ "$verdict" == ACCEPT ]]; then
    [[ $((ng + nrm)) -eq 0 ]] || die_error "$(basename "$rf") is ACCEPT but lists gaps or removals"
    return 0
  fi
  rej="$(rejection_text "$rf")"
  [[ -n "$rej" ]] || die_error "$(basename "$rf") is $verdict with nothing to fix"
  cycles=$((cycles + 1))
  if [[ $cycles -ge $MAX ]]; then
    log "STUCK: the $RECHECK kept rejecting the fixed diff ($cycles of $MAX)"
    finish 2 "$RECHECK" STUCK "$(jq -n --arg f "$rej" --arg by "$(basename "$rf")" '{findings:$f, rejected_by:$by}')"
  fi
  NEED_FIX="$rej" NEED_FIX_N=$((n + ng + nrm)); FIX_SRC=gate
  [[ "$NEED_FIX_N" -gt 0 ]] || NEED_FIX_N=1
  RECHECK_PRIOR="The $RECHECK rejected the diff the dev fixed after an earlier rejection. These are its findings, which the dev says are fixed. Check each one first:
$rej"
  GATE_PRIOR="$RECHECK_PRIOR"
  return 1
}

# review_gate — returns when the diff as it is now has a READY review and no fix is pending. NEED_FIX (with
# FIX_SRC, where it came from) is work the dev still owes; a fix for a CHANGES verdict that leaves the diff
# as it was is a failed round. Every CHANGES verdict and every failed round counts toward max_rounds.
# When a spec check or final gate rejection is what sent the dev to fix (FIX_SRC=gate), that stage judges the
# fixed diff too, after the review is READY and before the push (recheck_diff).
FR=$ACC_R cycles=0 NEED_FIX="" NEED_FIX_N=1 GATE_PRIOR="" RECHECK_PRIOR="" guard=0
review_gate() {
  local before after rv rej
  while true; do
    guard=$((guard + 1))
    [[ $guard -le $((MAX * 4 + 8)) ]] || die_error "finalize could not settle on a reviewed diff after $guard steps"
    if [[ -n "$NEED_FIX" ]]; then
      FR=$((FR + 1))
      fix_round "$FR" "$NEED_FIX" "$NEED_FIX_N"
      before="$(cat "$STATE/fix-r$FR.before")"
      diff_sig; after="$DSIG"
      if rejected_diff; then
        cycles=$((cycles + 1))
        log "round $FR: the fix restored the diff that $REJECTED_BY rejected ($cycles of $MAX)"
        if [[ $cycles -ge $MAX ]]; then
          finish 2 "${REJECTED_BY%%-r*}" STUCK "$(jq -n --arg f "$NEED_FIX" --arg by "$REJECTED_BY" '{findings:$f, rejected_by:$by}')"
        fi
        NEED_FIX="$NEED_FIX
(Your last attempt restored the diff that $REJECTED_BY rejected. Change the code, or stop with QUESTION and say why not.)"
        continue
      fi
      if [[ "$FIX_SRC" == review && "$after" == "$before" ]]; then
        cycles=$((cycles + 1))
        log "round $FR: the fix changed nothing after a CHANGES verdict ($cycles of $MAX)"
        if [[ $cycles -ge $MAX ]]; then
          finish 2 review STUCK "$(jq -n --arg f "$NEED_FIX" '{findings:$f}')"
        fi
        NEED_FIX="$NEED_FIX
(Your last attempt changed nothing in the diff. Change the code, or stop with QUESTION and say why not.)"
        continue
      fi
      NEED_FIX=""
      if reviewed_diff; then recheck_diff && return 0; continue; fi
      rv=$FR
    else
      if reviewed_diff; then recheck_diff && return 0; continue; fi
      if rejected_diff; then
        # No dev fix made this diff: the gate (or a rebase, or anything else) restored one that the spec
        # check or the final gate rejected. A new review would ACCEPT it without counting, so treat it as
        # the fix branch treats a restored rejected diff: it counts, goes back to the dev, and ends STUCK.
        cycles=$((cycles + 1))
        log "the diff changed without a dev fix and is the one $REJECTED_BY rejected ($cycles of $MAX)"
        if [[ $cycles -ge $MAX ]]; then
          finish 2 "${REJECTED_BY%%-r*}" STUCK "$(jq -n --arg by "$REJECTED_BY" '{findings:("The diff was restored to the one " + $by + " rejected, by something other than a dev fix (the gate, a rebase or a commit outside the loop)."), rejected_by:$by}')"
        fi
        rej="$(rejection_text "$STATE/$REJECTED_BY")"
        NEED_FIX="The diff now in the PR is the one $REJECTED_BY rejected. The gate, a rebase or a commit outside your fixes (not a fix of yours) restored it, so the change that answered these has been undone. Address them again in the code, or stop with QUESTION and say why not:
$rej"
        GATE_PRIOR="The PR was restored, by the gate or another change that is not a dev fix, to the diff that ${REJECTED_BY%%-r*} rejected. Check that each of these is addressed in the diff as it is now:
$rej"
        FIX_SRC=gate
        NEED_FIX_N=1
        RECHECK="${REJECTED_BY%%-r*}" RECHECK_PRIOR="$GATE_PRIOR"
        printf '%s\n' "$RECHECK" >"$STATE/recheck"
        continue
      fi
      FR=$((FR + 1)); rv=$FR
      GATE_PRIOR="The PR changed after your last accept. Review the diff against origin/$BASE as it is now."
    fi
    do_review "$rv" "$GATE_PRIOR"
    if [[ "$RV_VERDICT" != ACCEPT ]]; then
      [[ "$RV_N" -gt 0 ]] || die_error "review-r$rv.json is CHANGES with no findings"
      cycles=$((cycles + 1))
      if [[ $cycles -ge $MAX ]]; then
        log "STUCK: the post-fix review kept asking for changes"
        finish 2 review STUCK "$(jq -n --arg f "$(fmt_findings "$STATE/review-r$rv.json")" '{findings:$f}')"
      fi
      NEED_FIX="$(fmt_findings "$STATE/review-r$rv.json")" NEED_FIX_N="$RV_N"; FIX_SRC=review
      GATE_PRIOR="The previous findings, which the dev says are fixed. Verify each against the current head first:
$NEED_FIX"
    fi
  done
}

STAGE=finalize
attempt=0
# A fix that was in flight when the driver stopped (a QUESTION in the middle of it, a crash) is continued,
# not replayed over: it is the next round of the dev's work.
_k=$((ACC_R + 1))
if [[ -e "$STATE/fix-r$_k.json.sent" && -s "$STATE/fix-r$_k.findings" ]]; then
  NEED_FIX="$(cat "$STATE/fix-r$_k.findings")"; NEED_FIX_N="$(cat "$STATE/fix-r$_k.n" 2>/dev/null || echo 1)"; FIX_SRC="$(cat "$STATE/fix-r$_k.src" 2>/dev/null)"
  FR=$((_k - 1))
  log "continuing the dev's fix round $_k"
fi
while ! { valid_json "$STATE/finalize.json" && [[ "$(jq -r .status "$STATE/finalize.json")" == DONE ]]; }; do
  review_gate
  STAGE=finalize
  _rc=0; finalize_try || _rc=$?
  case $_rc in
    0) break ;;
    2) continue ;;
  esac
  attempt=$((attempt + 1))
  if [[ $attempt -gt 2 ]]; then
    log "finalize still failing after 2 dev fixes"
    finish 2 finalize STUCK "$(jq -n --arg f "$FIN_MSG" '{findings:$f}')"
  fi
  log "finalize problem, back to the dev (attempt $attempt)"
  NEED_FIX="$FIN_MSG" NEED_FIX_N=1; FIX_SRC=finalize
  GATE_PRIOR="The dev changed the PR after your last accept, to fix this: $FIN_MSG
Review the diff against origin/$BASE as it is now."
done
FINALIZE_JSON="$(jq -c . "$STATE/finalize.json")"
log "finalized at $(jq -r .head "$STATE/finalize.json")"
finish 0 "done" READY
