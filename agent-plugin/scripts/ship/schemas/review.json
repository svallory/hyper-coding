{
  "title": "review / final result",
  "description": "review-rN.json and final.json.",
  "type": "object",
  "required": ["verdict", "findings"],
  "properties": {
    "verdict": {"type": "string", "enum": ["ACCEPT", "CHANGES"]},
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "file", "summary", "fix"],
        "properties": {
          "severity": {"type": "string", "enum": ["BLOCKING", "SHOULD", "NOTE"]},
          "file": {"type": "string"},
          "line": {"type": "integer"},
          "summary": {"type": "string"},
          "fix": {"type": "string"}
        }
      }
    },
    "failovers": {"type": "integer"}
  }
}
