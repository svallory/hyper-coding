#!/usr/bin/env bash
# ship-unit — start, resume, wait for and list hyper:ship units. A unit is one
# briefed piece of work that ship-loop (the driver) takes from dev to READY. The
# driver runs in the unit's multiplexer space, on this machine or on a host over
# ssh, and ship-unit blocks until it exits, so the caller is woken by the exit
# (start it as a background command).
#
# Usage:
#   ship-unit run <ref> --brief FILE --class S|M|L [--host H] [--branch B] [--base B]
#                       [--max-rounds N] [--final-gate] [--model STAGE=M[,M...]]...
#                       [--spec-dir DIR]
#   ship-unit resume <ref> [--answer FILE] [--extend MIN] [--model STAGE=M[,M...]]...
#   ship-unit wait <ref>
#   ship-unit list
#
#   run     create the worktree (wt switch -c from origin/<base>; the branch defaults to
#           the ref), check the host has a free slot, open the unit's space with
#           ship-mux and start the driver in it, then block until it exits. Mirrors
#           notes/loops/<ref>/ back (host mode), prints result.json and exits with
#           the driver's code. --model values are written to models.override.
#   resume  restart the driver of a parked or over-budget unit; it reattaches. First
#           writes what ship-loop reads from notes/loops/<ref>/: --answer becomes
#           answer-<n>.md (n is park.json's "n"; refused for LIMIT and DIALOG parks),
#           --extend becomes `extend` (minutes, above 0, for the stage that went
#           OVER-BUDGET), --model lines are appended to models.override (so they beat
#           run's). Then blocks like run.
#   wait    block on an already running driver (after the caller's session was lost).
#   list    one line per unit under notes/loops/ (not .done): ref, host, status,
#           stage, failovers, age, driver alive. A unit with a live driver is RUNNING;
#           without one its status is result.json's, or DEAD when it left none. Each
#           remote host is asked once, in parallel.
#
#   --host H      run on the host named H in the ship config (hosts.H.ssh is the ssh
#                 destination, hosts.H.slots the number of concurrent units). The
#                 default is `local`. The space must exist on the host at the same
#                 absolute path.
#   --spec-dir D  a spec directory the unit's agents read; with --host it is copied
#                 to the host together with the brief and the rulings file.
#
# Slots: a unit counts toward a host's slots while its driver is alive there (a
# driver.pid naming a ship process, or a launch in its first SHIP_UNIT_START_GRACE_S
# seconds with no pid yet). Checking, creating the worktree and launching happen under
# one lock per host (<space>/.hyper/ship-unit.lock), so concurrent runs cannot
# overbook. `run` and `resume` refuse (exit 3) when the host is full, or when the
# ref's driver is already running.
#
# Host mode: scripts/ship/, scripts/hyper-require-lib.sh and skills/ship/defaults.yml
# are rsynced to ~/.cache/hyper/ship/<plugin version>/ on the host (the host needs no
# hyper CLI), SHIP_SPACE_ROOT is exported over ssh, and the brief, the rulings file and
# the spec dir are rsynced to the same paths. The lead's merged config goes over in the
# ssh command line (SHIP_CONFIG_JSON=..., so it is visible in `ps` on the host while the
# call runs); the host writes it to notes/loops/<ref>/config.json
# and the driver loads it through SHIP_CONFIG_FILE, so the unit runs under the lead's
# config whatever the host's own files say. The wait loop polls the host; when ssh fails
# it reconnects with a growing delay (SHIP_UNIT_POLL_S doubling up to
# SHIP_UNIT_BACKOFF_MAX_S) and keeps polling, up to SHIP_UNIT_RECONNECT_SEC (default
# 900) of continuous failure. The driver keeps running; `ship-unit wait <ref>`
# reattaches. The loop directory is mirrored back right after the start and at the end.
#
# State written next to the driver's own (see ship-loop): unit.json (what the unit was
# started with, so resume and wait need no arguments), driver.exit (the driver's exit
# code; removed on every start) and, for host units, config.json.
#
# Exit codes
#   0 READY   1 ERROR   2 parked, over budget or stuck    only ever the driver's result
#   3 refused (host full, driver already running, nothing to answer or extend)
#   64 usage (a bad option, a bad --model, --extend 0)
#   70 ship-unit failed: wt (worktrunk) not on PATH, sync or copy failure, no ssh destination, unknown unit, a
#      driver that died without an exit code or result
#   75 the connection to the host was lost while the driver is still running (also:
#      gave up reconnecting); `ship-unit wait <ref>` reattaches
#
# Environment (test knobs): SHIP_UNIT_POLL_S (poll interval, default 5),
# SHIP_UNIT_BACKOFF_MAX_S (default 30), SHIP_UNIT_RECONNECT_SEC, SHIP_UNIT_START_GRACE_S
# (how long a driver that has not written a pid yet counts as starting, default 60),
# SHIP_UNIT_LOCK_WAIT_S (default 300), SHIP_LOOP_BIN (the driver).
# _launch, _resume, _probe and _driver are internal and need SHIP_UNIT_INTERNAL=1.

set -euo pipefail

_src="${BASH_SOURCE[0]}"
while [[ -L "$_src" ]]; do
  case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
  _link="$(readlink "$_src")"
  case "$_link" in /*) _src="$_link" ;; *) _src="$_dir/$_link" ;; esac
done
case "$_src" in */*) _dir="${_src%/*}" ;; *) _dir="." ;; esac
_dir="$(CDPATH='' cd -- "$_dir" && pwd -P)"
_src="$_dir/${_src##*/}"
# shellcheck source=lib.sh
source "$_dir/lib.sh"
# shellcheck source=lib-host.sh
source "$_dir/lib-host.sh"

MUX="$_dir/ship-mux"
LOOP="${SHIP_LOOP_BIN:-$_dir/ship-loop}"
POLL_S="${SHIP_UNIT_POLL_S:-5}"
BACKOFF_MAX_S="${SHIP_UNIT_BACKOFF_MAX_S:-30}"
RECONNECT_SEC="${SHIP_UNIT_RECONNECT_SEC:-900}"
START_GRACE_S="${SHIP_UNIT_START_GRACE_S:-60}"
LOCK_WAIT_S="${SHIP_UNIT_LOCK_WAIT_S:-300}"

E_REFUSED=3 E_USAGE=64 E_INTERNAL=70 E_LOST=75
usage() { echo "ship-unit: $*" >&2; exit "$E_USAGE"; }
# UNDO_FN: set while _launch holds a branch and worktree it created, so that any failure removes them.
UNDO_FN=""
undo_now() { local f="$UNDO_FN"; UNDO_FN=""; [[ -z "$f" ]] || "$f" || true; }
fail() { undo_now; echo "ship-unit: $*" >&2; exit "$E_INTERNAL"; }
refuse() { echo "ship-unit: refused: $*" >&2; exit "$E_REFUSED"; }

sub="${1:-}"
case "$sub" in
  -h|--help|"") sed -n '2,/^$/p' "$_src" | sed '$d' | sed 's/^# \{0,1\}//'; [[ -n "$sub" ]] && exit 0; exit "$E_USAGE" ;;
  run|resume|wait|list) ;;
  _launch|_resume|_probe|_driver)
    [[ "${SHIP_UNIT_INTERNAL:-}" == 1 ]] || usage "unknown subcommand '$sub' (try --help)" ;;
  *) usage "unknown subcommand '$sub' (try --help)" ;;
esac
shift

check_ref() {
  [[ -n "${1:-}" ]] || usage "a ref is required"
  [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || usage "invalid ref '$1' (letters, digits, '.', '_', '-'; must start with a letter or digit)"
}

mtime() { # epoch seconds, 0 when the path is gone (GNU or BSD stat; never a non-number)
  local m
  m="$(stat -c %Y "$1" 2>/dev/null)" && [[ "$m" =~ ^[0-9]+$ ]] && { echo "$m"; return; }
  m="$(stat -f %m "$1" 2>/dev/null)" && [[ "$m" =~ ^[0-9]+$ ]] && { echo "$m"; return; }
  echo 0
}

abs_path() { # path -> absolute (the directory must exist)
  local p="$1" d
  case "$p" in /*) printf '%s\n' "$p"; return ;; esac
  d="$(CDPATH='' cd -- "$(dirname -- "$p")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$d" "$(basename -- "$p")"
}

load_cfg() { # sets root, exports SHIP_SPACE_ROOT
  ship_config_load || exit "$E_INTERNAL"
  root="$(ship_space_root)" || exit "$E_INTERNAL"
  export SHIP_SPACE_ROOT="$root"
}

positive_number() { [[ "$1" =~ ^[0-9]+(\.[0-9]+)?$ ]] && awk -v n="$1" 'BEGIN { exit !(n + 0 > 0) }'; }

# --- driver liveness (runs where the driver runs) -------------------------------------------
# The pid must be alive AND be our driver: a recycled pid is some other process, and the
# lead's own `ship-unit run`/`wait` processes are not drivers. The command line comes from
# ps, else /proc. A command that cannot be read is retried; see below.
driver_proc_ok() { # pid ref
  local c=""
  for _ in 1 2 3; do
    kill -0 "$1" 2>/dev/null || return 1
    c="$(ps -o command= -p "$1" 2>/dev/null)" || c=""
    if [[ -z "$c" && -r "/proc/$1/cmdline" ]]; then c="$(tr '\0' ' ' <"/proc/$1/cmdline" 2>/dev/null)" || c=""; fi
    [[ -z "$c" ]] || break
    sleep 0.1
  done
  if [[ -z "$c" ]]; then
    # A live pid whose command will not read: if ps or /proc exist here the read failed
    # (fork pressure), and a driver must not be taken for dead. With neither, it is not ours.
    command -v ps >/dev/null 2>&1 || [[ -d /proc/self ]]
    return $?
  fi
  c="${c%"${c##*[! ]}"}"
  case "$c" in
    *ship-unit*" _driver $2") return 0 ;;
    *ship-loop*|*"${LOOP##*/}"*) return 0 ;;
  esac
  return 1
}

# unit_state <loop dir> — one of: "exit N", running, starting, dead, missing.
unit_state() {
  local d="$1" p launched=0 now st
  [[ -f "$d/unit.json" ]] || { echo missing; return 0; }
  if [[ -s "$d/driver.exit" ]]; then echo "exit $(tr -dc '0-9' <"$d/driver.exit")"; return 0; fi
  # The pid file is read once and everything is decided from that one value: it can be
  # empty for an instant while the driver starts, and a second look must not disagree.
  p=""
  { read -r p <"$d/driver.pid"; } 2>/dev/null || true
  if [[ "$p" =~ ^[0-9]+$ ]] && driver_proc_ok "$p" "${d##*/}"; then echo running; return 0; fi
  launched="$(jq -r '.launched_at // 0' "$d/unit.json" 2>/dev/null)" || launched=0
  [[ "$launched" =~ ^[0-9]+$ ]] || launched=0
  now="$(date +%s)"
  if [[ -z "$p" && "$launched" -gt 0 && $((now - launched)) -lt "$START_GRACE_S" ]]; then
    echo starting; return 0
  fi
  # The driver is gone and left no exit code (its pane was closed, the host rebooted).
  # A result written since the launch still says how it ended.
  if [[ -s "$d/result.json" && "$(mtime "$d/result.json")" -ge "$launched" ]]; then
    st="$(jq -r '.status // ""' "$d/result.json" 2>/dev/null)" || st=""
    case "$st" in READY) echo "exit 0" ;; ERROR) echo "exit 1" ;; "") echo dead ;; *) echo "exit 2" ;; esac
    return 0
  fi
  echo dead
}

unit_live() { case "$(unit_state "$1")" in running|starting) return 0 ;; *) return 1 ;; esac; }

# --- internal: probe -----------------------------------------------------------------------
# One line per ref: "ship-unit-probe: <ref> <state>". The prefix lets the caller ignore
# whatever a login shell prints around it.
if [[ "$sub" == _probe ]]; then
  [[ $# -gt 0 ]] || usage "_probe needs a ref"
  root="$(ship_space_root)" || exit "$E_INTERNAL"
  for ref in "$@"; do
    check_ref "$ref"
    echo "ship-unit-probe: $ref $(unit_state "$root/notes/loops/$ref")"
  done
  exit 0
fi

# --- internal: the command that runs in the unit's pane ------------------------------------
if [[ "$sub" == _driver ]]; then
  ref="${1:-}"; check_ref "$ref"
  root="$(ship_space_root)" || exit "$E_INTERNAL"
  d="$root/notes/loops/$ref"
  [[ -f "$d/unit.json" ]] || fail "$d/unit.json is missing"
  args=(--ref "$ref")
  args+=(--worktree "$(jq -r .worktree "$d/unit.json")" --branch "$(jq -r .branch "$d/unit.json")")
  args+=(--brief "$(jq -r .brief "$d/unit.json")" --class "$(jq -r .class "$d/unit.json")")
  v="$(jq -r '.base // ""' "$d/unit.json")"; [[ -z "$v" ]] || args+=(--base "$v")
  v="$(jq -r '.max_rounds // ""' "$d/unit.json")"; [[ -z "$v" ]] || args+=(--max-rounds "$v")
  [[ "$(jq -r '.final_gate // false' "$d/unit.json")" != true ]] || args+=(--final-gate)
  # Models reach ship-loop through models.override (written by run, appended by resume),
  # so a resume --model beats the run's.
  # Atomic: a reader must see the whole pid or no file, never an empty one.
  echo $$ >"$d/driver.pid.tmp.$$" && mv -f "$d/driver.pid.tmp.$$" "$d/driver.pid"
  rc=0
  "$LOOP" "${args[@]}" || rc=$?
  echo "$rc" >"$d/driver.exit.tmp" && mv "$d/driver.exit.tmp" "$d/driver.exit"
  exit "$rc"
fi

# --- launching (on the host that runs the driver) ------------------------------------------
host_name="local" slots=""
LOCK_DIR="" LOCK_HELD=0 CLEAN_FILE=""

internal_cleanup() {
  [[ -z "$CLEAN_FILE" ]] || rm -f "$CLEAN_FILE"
  if [[ $LOCK_HELD -eq 1 ]]; then ship_unlock "$LOCK_DIR"; LOCK_HELD=0; fi
}

# lock_acquire — one launch at a time per host (ship_lock in lib.sh: a lock file, stale when its holder is
# dead or it is over ten minutes old).
lock_acquire() {
  LOCK_DIR="$root/.hyper/ship-unit.lock"
  mkdir -p "$root/.hyper" || fail "cannot create $root/.hyper"
  trap internal_cleanup EXIT
  ship_lock "$LOCK_DIR" "$LOCK_WAIT_S" 600 || fail "could not get the launch lock $LOCK_DIR in ${LOCK_WAIT_S}s (held by ${SHIP_LOCK_OWNER:-?})"
  LOCK_HELD=1
}

# live_units [except ref] — refs of this host whose driver is alive or starting.
live_units() {
  local u r
  for u in "$root"/notes/loops/*/; do
    [[ -f "$u/unit.json" ]] || continue
    r="${u%/}"; r="${r##*/}"
    [[ "$r" != "${1:-}" ]] || continue
    [[ "$(jq -r '.host // "local"' "$u/unit.json" 2>/dev/null)" == "$host_name" ]] || continue
    ! unit_live "${u%/}" || echo "$r"
  done
  return 0
}

# check_free <ref> — refuse when the ref's driver is up or the host is full. Holds the lock.
check_free() {
  local ref="$1" d="$root/notes/loops/$1" live n
  if [[ -f "$d/unit.json" ]] && unit_live "$d"; then
    refuse "the driver of $ref is already running on $host_name; use 'ship-unit wait $ref'"
  fi
  [[ "$slots" =~ ^[0-9]+$ ]] || { slots="$(ship_cfg_get "hosts.$host_name.slots" 2>/dev/null)" || slots=""; }
  [[ "$slots" =~ ^[0-9]+$ ]] || fail "host '$host_name' has no usable hosts.$host_name.slots in the ship config"
  live="$(live_units "$ref" | tr '\n' ' ')"
  n="$(printf '%s' "$live" | wc -w | tr -d ' ')"
  if [[ "$n" -ge "$slots" ]]; then
    refuse "host $host_name is full: $n of $slots slots in use (${live% }); wait for one to finish"
  fi
}

# write_config <ref> — a host unit runs under the lead's merged config, not its own files.
write_config() {
  local d="$root/notes/loops/$1"
  if [[ "$host_name" != local && -n "${SHIP_CONFIG_JSON:-}" ]]; then
    (umask 077; printf '%s\n' "$SHIP_CONFIG_JSON" >"$d/config.json.tmp") && mv "$d/config.json.tmp" "$d/config.json"
  fi
}

# launch_driver <ref> — space and driver pane. unit.json exists and its launched_at is set.
launch_driver() {
  local ref="$1" d="$root/notes/loops/$1" wt open_out pane cmd
  "$MUX" check || fail "the multiplexer is not usable here"
  wt="$(jq -r .worktree "$d/unit.json")"
  rm -f "$d/driver.exit" "$d/driver.pid"
  jq --argjson t "$(date +%s)" '.launched_at = $t' "$d/unit.json" >"$d/unit.json.tmp" && mv "$d/unit.json.tmp" "$d/unit.json"
  write_config "$ref"
  if ! open_out="$("$MUX" open --ref "$ref" --cwd "$wt" --label "$ref")"; then
    unlaunch "$ref"; fail "ship-mux open failed"
  fi
  pane="$(jq -r .pane <<<"$open_out")"
  cmd="SHIP_UNIT_INTERNAL=1 SHIP_SPACE_ROOT=$(ship_sq "$root") SHIP_HOST=$(ship_sq "$host_name")"
  if [[ "$host_name" != local && -f "$d/config.json" ]]; then cmd+=" SHIP_CONFIG_FILE=$(ship_sq "$d/config.json")"; fi
  # The driver pane's shell has its own PATH; the agents must see the one of the shell that ran
  # ship-unit (a local run only: another host's PATH is its own).
  if [[ "$host_name" == local && -n "${PATH:-}" ]]; then cmd+=" PATH=$(ship_sq "$PATH")"; fi
  cmd+=" bash $(ship_sq "$_src") _driver $(ship_sq "$ref")"
  if ! "$MUX" run --ref "$ref" --pane "$pane" -- "$cmd"; then
    unlaunch "$ref"; fail "ship-mux run failed"
  fi
  jq -nc --arg ref "$ref" --arg host "$host_name" --arg wt "$wt" --argjson open "$open_out" \
    '{ref: $ref, host: $host, worktree: $wt, space: $open.space, pane: $open.pane}'
}

# unlaunch <ref> — a launch that failed must not hold a slot.
unlaunch() {
  local d="$root/notes/loops/$1"
  jq '.launched_at = 0' "$d/unit.json" >"$d/unit.json.tmp" && mv "$d/unit.json.tmp" "$d/unit.json"
}

if [[ "$sub" == _launch ]]; then
  command -v wt >/dev/null 2>&1 || fail "wt (worktrunk) not found on PATH"
  ref="${1:-}"; check_ref "$ref"; shift
  brief="" class="" branch="" base="" max_rounds="" final_gate=false spec_dir=""
  models=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --final-gate) final_gate=true; shift; continue ;;
      --brief|--class|--branch|--base|--max-rounds|--model|--host-name|--slots|--spec-dir)
        [[ $# -ge 2 ]] || usage "$1 needs a value" ;;
      *) usage "unknown argument: $1" ;;
    esac
    case "$1" in
      --brief) brief="$2" ;; --class) class="$2" ;; --branch) branch="$2" ;; --base) base="$2" ;;
      --max-rounds) max_rounds="$2" ;; --model) models+=("$2") ;; --host-name) host_name="$2" ;;
      --slots) slots="$2" ;; --spec-dir) spec_dir="$2" ;;
    esac
    shift 2
  done
  load_cfg
  [[ -f "$brief" ]] || fail "brief $brief is not a file (on $host_name)"
  [[ -z "$spec_dir" || -d "$spec_dir" ]] || fail "spec dir $spec_dir is not a directory"
  [[ -n "$branch" ]] || branch="$ref"
  [[ -n "$base" ]] || base="$(ship_cfg_get base)" || fail "config has no base"
  d="$root/notes/loops/$ref"

  # Fetching can be slow; it must not hold the lock (a wave of runs would queue behind it).
  GIT_TERMINAL_PROMPT=0 git -C "$root" fetch -q origin >/dev/null 2>&1 || true
  lock_acquire
  check_free "$ref"

  wt_find() {
    git -C "$root" worktree list --porcelain 2>/dev/null | awk -v b="refs/heads/$branch" '
      $1 == "worktree" { p = substr($0, 10) } $1 == "branch" && $2 == b { print p; exit }'
  }
  wt_path="$(wt_find)"
  # What this run creates (a reused worktree or branch is never touched), so that a failure of any
  # later step removes exactly that and the next run starts clean.
  made_branch=0 made_wt=0
  undo_created() {
    local p
    p="$(wt_find)"
    if [[ $made_wt -eq 1 && -n "$p" ]]; then
      git -C "$root" worktree remove --force "$p" >/dev/null 2>&1 || true
      git -C "$root" worktree prune >/dev/null 2>&1 || true
    fi
    if [[ $made_branch -eq 1 ]]; then git -C "$root" branch -D "$branch" >/dev/null 2>&1 || true; fi
    echo "ship-unit: removed the worktree and branch this run created for $ref" >&2
  }
  if [[ -z "$wt_path" ]]; then
    UNDO_FN=undo_created
    if git -C "$root" rev-parse --verify -q "refs/heads/$branch" >/dev/null 2>&1; then
      made_wt=1
      wt_out="$(CDPATH='' cd -- "$root" && wt switch --no-cd "$branch" 2>&1)" || fail "wt switch $branch failed:"$'\n'"$(head -c 1500 <<<"$wt_out" | sed 's/^/  /')"
    else
      # A new branch starts from the remote base, not from whatever the local one is.
      from="$base"
      git -C "$root" rev-parse --verify -q "refs/remotes/origin/$base" >/dev/null 2>&1 && from="origin/$base"
      made_wt=1 made_branch=1
      wt_out="$(CDPATH='' cd -- "$root" && wt switch -c --no-cd -b "$from" "$branch" 2>&1)" || fail "wt switch -c $branch failed:"$'\n'"$(head -c 1500 <<<"$wt_out" | sed 's/^/  /')"
    fi
    [[ -z "$wt_out" ]] || echo "$wt_out" >&2
    wt_path="$(wt_find)"
    [[ -n "$wt_path" && -d "$wt_path" ]] || fail "wt did not leave a worktree for branch $branch"
  fi

  mkdir -p "$d"
  models_json="$(printf '%s\n' ${models[@]+"${models[@]}"} | jq -R 'select(. != "")' | jq -sc .)"
  # A fresh run starts from the run's own model overrides; a later resume appends.
  : >"$d/models.override"
  for m in ${models[@]+"${models[@]}"}; do printf '%s\n' "$m" >>"$d/models.override"; done
  jq -n --arg ref "$ref" --arg host "$host_name" --arg branch "$branch" --arg wt "$wt_path" --arg brief "$brief" \
    --arg class "$class" --arg base "$base" --arg mr "$max_rounds" --argjson fg "$final_gate" \
    --argjson models "$models_json" --arg spec "$spec_dir" --argjson t "$(date +%s)" \
    '{ref: $ref, host: $host, branch: $branch, worktree: $wt, brief: $brief, class: $class, base: $base,
      max_rounds: (if $mr == "" then null else ($mr | tonumber) end), final_gate: $fg, models: $models,
      spec_dir: (if $spec == "" then null else $spec end), launched_at: $t}' >"$d/unit.json.tmp"
  mv "$d/unit.json.tmp" "$d/unit.json"
  rm -f "$d/driver.exit" "$d/driver.pid"
  launch_driver "$ref"
  UNDO_FN=""
  exit 0
fi

if [[ "$sub" == _resume ]]; then
  ref="${1:-}"; check_ref "$ref"; shift
  answer="" extend="" models=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --answer-file|--extend|--model|--host-name|--slots) [[ $# -ge 2 ]] || usage "$1 needs a value" ;;
      *) usage "unknown argument: $1" ;;
    esac
    case "$1" in
      --answer-file) answer="$2" ;; --extend) extend="$2" ;; --model) models+=("$2") ;;
      --host-name) host_name="$2" ;; --slots) slots="$2" ;;
    esac
    shift 2
  done
  load_cfg
  # A staged answer is a copy for this call only.
  case "$answer" in */.resume-answer) CLEAN_FILE="$answer" ;; esac
  d="$root/notes/loops/$ref"
  [[ -f "$d/unit.json" ]] || fail "unknown unit '$ref': $d/unit.json does not exist"
  lock_acquire
  check_free "$ref"
  # Check everything before writing anything.
  n=""
  if [[ -n "$answer" ]]; then
    [[ -s "$answer" ]] || fail "answer file $answer is missing or empty"
    [[ -s "$d/park.json" ]] || refuse "$ref is not parked (no park.json); nothing is waiting for an answer"
    case "$(jq -r '.status // ""' "$d/park.json")" in
      LIMIT) refuse "$ref is parked on a usage limit; an answer does not help: wait for the reset or resume with --model" ;;
      DIALOG) refuse "$ref is parked on a dialog the agent could not pass; an answer does not help: fix it in the pane, then resume without --answer" ;;
    esac
    n="$(jq -r '.n // empty' "$d/park.json")"
    [[ "$n" =~ ^[0-9]+$ ]] || fail "$d/park.json has no park number"
  fi
  if [[ -n "$extend" ]]; then
    positive_number "$extend" || usage "--extend takes minutes (a number above 0), got '$extend'"
    ok=0
    for b in "$d"/budget-r*.json; do
      [[ -f "$b" && ! -e "$b.handled" ]] && ok=1
    done
    [[ $ok -eq 1 ]] || refuse "$ref has no stage over budget; nothing to extend"
  fi
  if [[ -n "$answer" ]]; then
    cp "$answer" "$d/answer-$n.md.tmp" && mv "$d/answer-$n.md.tmp" "$d/answer-$n.md"
    echo "ship-unit: wrote answer-$n.md" >&2
  fi
  [[ -z "$extend" ]] || { printf '%s\n' "$extend" >"$d/extend"; echo "ship-unit: wrote extend ($extend min)" >&2; }
  for m in ${models[@]+"${models[@]}"}; do printf '%s\n' "$m" >>"$d/models.override"; done
  launch_driver "$ref"
  exit 0
fi

# --- client side: run / resume / wait / list -----------------------------------------------
HTARGET="" HNAME=local need_sync=0 resynced=0 DRIVER_RC=""

# unit_exec <ship-unit args...> — run a ship-unit subcommand where the unit lives.
# A host whose cache copy is missing (exit 127) gets one more sync.
unit_exec() {
  local rc=0
  if [[ -z "$HTARGET" ]]; then
    SHIP_UNIT_INTERNAL=1 SHIP_HOST="$HNAME" bash "$_src" "$@"
    return $?
  fi
  ship_host_run "$HTARGET" "$root" "$HNAME" ship-unit "$@" || rc=$?
  if [[ $rc -eq 127 && $resynced -eq 0 ]]; then
    resynced=1
    ship_host_sync "$HTARGET" >&2 || return 70
    rc=0
    ship_host_run "$HTARGET" "$root" "$HNAME" ship-unit "$@" || rc=$?
  fi
  return "$rc"
}

# select_host <name> [soft] — sets HNAME, HTARGET; syncs the scripts for a remote host once.
# With "soft" a failed sync is not fatal: the wait loop syncs again when it reconnects.
select_host() {
  HNAME="${1:-local}"
  HTARGET=""
  if ! ship_host_is_local "$HNAME"; then
    HTARGET="$(ship_host_target "$HNAME")" || exit "$E_INTERNAL"
    if ! ship_host_sync "$HTARGET"; then
      [[ "${2:-}" == soft ]] || fail "could not copy the ship scripts to $HNAME ($HTARGET)"
      need_sync=1
    fi
  fi
}

host_slots() {
  local s
  s="$(ship_cfg_get "hosts.$HNAME.slots" 2>/dev/null)" || s=""
  [[ "$s" =~ ^[0-9]+$ ]] || fail "host '$HNAME' has no usable hosts.$HNAME.slots in the ship config"
  printf '%s\n' "$s"
}

# probe_state <rc var> <output var> — not used; see probe_ref.
# probe_ref <ref> — sets PROBE (the state) and returns ssh's status; 0 only with a state.
PROBE=""
probe_ref() {
  local out rc=0
  PROBE=""
  out="$(unit_exec _probe "$1" 2>/dev/null)" || rc=$?
  [[ $rc -eq 0 ]] || return "$rc"
  PROBE="$(printf '%s\n' "$out" | sed -n "s/^ship-unit-probe: $1 //p" | tail -n 1)"
  return 0
}

# next_delay <current> — doubled, capped.
next_delay() { awk -v d="$1" -v m="$BACKOFF_MAX_S" 'BEGIN { d = d * 2; if (d > m) d = m; printf "%g", d }'; }

# wait_driver <ref> — block until the driver exits; sets DRIVER_RC (the code ship-unit exits
# with). Reconnects, with a growing delay, while ssh fails.
wait_driver() {
  local ref="$1" rc lost_since="" announced=0 delay="$POLL_S" dead_seen=0
  DRIVER_RC=""
  while :; do
    if [[ $need_sync -eq 1 && -n "$HTARGET" ]]; then
      if ship_host_sync "$HTARGET" >/dev/null 2>&1; then need_sync=0; fi
    fi
    rc=0
    if [[ $need_sync -eq 1 ]]; then rc=255; else probe_ref "$ref" || rc=$?; fi
    if [[ $rc -eq 0 ]]; then
      if [[ -n "$lost_since" ]]; then echo "ship-unit: reconnected to $HNAME" >&2; fi
      lost_since="" announced=0 delay="$POLL_S"
      [[ "$PROBE" == dead ]] || dead_seen=0
      case "$PROBE" in
        "exit "*)
          DRIVER_RC="${PROBE#exit }"
          case "$DRIVER_RC" in
            0|1|2) ;;
            *) echo "ship-unit: the driver of $ref exited with code $DRIVER_RC" >&2; DRIVER_RC=$E_INTERNAL ;;
          esac
          return 0 ;;
        running|starting) ;;
        dead)
          # Twice in a row: one odd reading (a process table under load) is not a verdict.
          if [[ $dead_seen -eq 0 ]]; then dead_seen=1
          else
            echo "ship-unit: the driver of $ref is not running on $HNAME and left no exit code or result; see notes/loops/$ref/loop.log" >&2
            DRIVER_RC=$E_INTERNAL; return 0
          fi ;;
        missing) echo "ship-unit: $HNAME has no unit $ref" >&2; DRIVER_RC=$E_INTERNAL; return 0 ;;
        *) echo "ship-unit: unexpected probe answer '$PROBE'" >&2; DRIVER_RC=$E_INTERNAL; return 0 ;;
      esac
    elif [[ -n "$HTARGET" ]] && ship_host_lost "$rc"; then
      [[ -n "$lost_since" ]] || lost_since=$SECONDS
      if [[ $announced -eq 0 ]]; then echo "ship-unit: lost the connection to $HNAME (ssh exit $rc); retrying" >&2; announced=1; fi
      if [[ $((SECONDS - lost_since)) -ge $RECONNECT_SEC ]]; then
        echo "ship-unit: gave up reconnecting to $HNAME after ${RECONNECT_SEC}s; the driver keeps running there: 'ship-unit wait $ref' reattaches" >&2
        DRIVER_RC=$E_LOST; return 0
      fi
      delay="$(next_delay "$delay")"
    else
      echo "ship-unit: probing the driver of $ref on $HNAME failed (exit $rc)" >&2
      DRIVER_RC=$E_INTERNAL; return 0
    fi
    sleep "$delay"
  done
}

# pull_state <ref> — mirror the host's loop directory here. Returns pull's status.
pull_state() {
  [[ -n "$HTARGET" ]] || return 0
  ship_host_pull_dir "$HTARGET" "$root/notes/loops/$1" "$root/notes/loops/$1" 2>/dev/null
}

# finish_unit <ref> — mirror the state back, print the result, exit with the driver's code.
# A mirror that cannot be made is retried, with a growing delay, for as long as a lost
# connection is retried; then the exit is 75 (the driver is done, `ship-unit wait` copies it).
finish_unit() {
  local ref="$1" code="$DRIVER_RC" delay="$POLL_S" t0=$SECONDS
  if [[ -n "$HTARGET" && "$code" != "$E_LOST" ]]; then
    until pull_state "$ref"; do
      if [[ $((SECONDS - t0)) -ge $RECONNECT_SEC ]]; then
        echo "ship-unit: could not copy notes/loops/$ref back from $HNAME; the driver finished with $code, the host holds the state: 'ship-unit wait $ref' copies it" >&2
        exit "$E_LOST"
      fi
      sleep "$delay"; delay="$(next_delay "$delay")"
    done
  fi
  [[ ! -s "$root/notes/loops/$ref/result.json" ]] || cat "$root/notes/loops/$ref/result.json"
  [[ "$code" =~ ^[0-9]+$ ]] || code=$E_INTERNAL
  exit "$code"
}

# launch_failed <rc> <ref> <verb> — map a failed _launch/_resume to ship-unit's exit codes.
launch_failed() {
  local rc="$1" ref="$2"
  case "$rc" in
    3|64|70) exit "$rc" ;;
  esac
  if [[ -n "$HTARGET" ]] && ship_host_lost "$rc"; then
    echo "ship-unit: lost the connection to $HNAME while starting $ref (ssh exit $rc); the driver may be running: 'ship-unit wait $ref' reattaches" >&2
    exit "$E_LOST"
  fi
  echo "ship-unit: starting $ref on $HNAME failed (exit $rc)" >&2
  exit "$E_INTERNAL"
}

case "$sub" in
  run)
    ref="" brief="" class="" host="local" branch="" base="" max_rounds="" final_gate=0 spec_dir=""
    models=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --final-gate) final_gate=1; shift; continue ;;
        --brief|--class|--host|--branch|--base|--max-rounds|--model|--spec-dir)
          [[ $# -ge 2 ]] || usage "$1 needs a value" ;;
        -*) usage "unknown option $1" ;;
        *) [[ -z "$ref" ]] || usage "one ref at a time"; ref="$1"; shift; continue ;;
      esac
      case "$1" in
        --brief) brief="$2" ;; --class) class="$2" ;; --host) host="$2" ;; --branch) branch="$2" ;;
        --base) base="$2" ;; --max-rounds) max_rounds="$2" ;; --model) models+=("$2") ;; --spec-dir) spec_dir="$2" ;;
      esac
      shift 2
    done
    check_ref "$ref"
    [[ -n "$brief" ]] || usage "--brief is required"
    case "$class" in S|M|L) ;; *) usage "--class must be S, M or L" ;; esac
    if [[ -n "$max_rounds" ]]; then
      [[ "$max_rounds" =~ ^[1-9][0-9]*$ ]] || usage "--max-rounds must be a positive integer"
    fi
    [[ -f "$brief" ]] || usage "brief $brief is not a file"
    brief="$(abs_path "$brief")"
    if [[ -n "$spec_dir" ]]; then
      [[ -d "$spec_dir" ]] || usage "spec dir $spec_dir is not a directory"
      spec_dir="$(CDPATH='' cd -- "$spec_dir" && pwd -P)"
    fi
    load_cfg
    for m in ${models[@]+"${models[@]}"}; do ship_models_override "$m" || exit "$E_USAGE"; done
    select_host "$host"
    slots="$(host_slots)"

    if [[ -n "$HTARGET" ]]; then
      rulings="$(ship_cfg_get rulings 2>/dev/null)" || rulings=""
      push=("$brief")
      if [[ -n "$rulings" ]]; then
        case "$rulings" in /*) ;; *) rulings="$root/$rulings" ;; esac
        push+=("$rulings")
      fi
      [[ -z "$spec_dir" ]] || push+=("$spec_dir")
      ship_host_push "$HTARGET" "${push[@]}" || fail "could not copy the brief and spec files to $HNAME"
    fi

    largs=("$ref" --brief "$brief" --class "$class" --host-name "$HNAME" --slots "$slots")
    [[ -z "$branch" ]] || largs+=(--branch "$branch")
    [[ -z "$base" ]] || largs+=(--base "$base")
    [[ -z "$max_rounds" ]] || largs+=(--max-rounds "$max_rounds")
    [[ $final_gate -eq 0 ]] || largs+=(--final-gate)
    [[ -z "$spec_dir" ]] || largs+=(--spec-dir "$spec_dir")
    for m in ${models[@]+"${models[@]}"}; do largs+=(--model "$m"); done
    # A host unit must be findable by `wait` even when the connection drops during the start.
    stub=""
    if [[ -n "$HTARGET" && ! -f "$root/notes/loops/$ref/unit.json" ]]; then
      mkdir -p "$root/notes/loops/$ref"
      stub="$root/notes/loops/$ref/unit.json"
      jq -nc --arg r "$ref" --arg h "$HNAME" '{ref: $r, host: $h, launched_at: 0}' >"$stub"
    fi
    rc=0
    unit_exec _launch "${largs[@]}" >/dev/null || rc=$?
    if [[ $rc -ne 0 ]]; then
      if [[ -n "$stub" && $rc -ne $E_LOST && ! ( $rc -ne 3 && $rc -ne 64 && $rc -ne 70 && -n "$HTARGET" ) ]]; then rm -f "$stub"; fi
      launch_failed "$rc" "$ref"
    fi
    echo "ship-unit: $ref started on $HNAME" >&2
    pull_state "$ref" || true
    wait_driver "$ref"
    finish_unit "$ref"
    ;;

  resume)
    ref="" answer="" extend=""
    models=()
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --answer|--extend|--model) [[ $# -ge 2 ]] || usage "$1 needs a value" ;;
        -*) usage "unknown option $1" ;;
        *) [[ -z "$ref" ]] || usage "one ref at a time"; ref="$1"; shift; continue ;;
      esac
      case "$1" in
        --answer) answer="$2" ;; --extend) extend="$2" ;; --model) models+=("$2") ;;
      esac
      shift 2
    done
    check_ref "$ref"
    if [[ -n "$answer" ]]; then
      [[ -s "$answer" ]] || usage "answer file $answer is missing or empty"
      answer="$(abs_path "$answer")"
    fi
    if [[ -n "$extend" ]]; then
      positive_number "$extend" || usage "--extend takes minutes (a number above 0), got '$extend'"
    fi
    load_cfg
    for m in ${models[@]+"${models[@]}"}; do ship_models_override "$m" || exit "$E_USAGE"; done
    [[ -f "$root/notes/loops/$ref/unit.json" ]] || fail "unknown unit '$ref': no notes/loops/$ref/unit.json"
    select_host "$(jq -r '.host // "local"' "$root/notes/loops/$ref/unit.json")"
    slots="$(host_slots)"
    rargs=("$ref" --host-name "$HNAME" --slots "$slots")
    staged=""
    if [[ -n "$answer" ]]; then
      if [[ -n "$HTARGET" ]]; then
        staged="$root/notes/loops/$ref/.resume-answer"
        cp "$answer" "$staged"
        if ! ship_host_push "$HTARGET" "$staged"; then rm -f "$staged"; fail "could not copy the answer to $HNAME"; fi
        rargs+=(--answer-file "$staged")
      else
        rargs+=(--answer-file "$answer")
      fi
    fi
    [[ -z "$extend" ]] || rargs+=(--extend "$extend")
    for m in ${models[@]+"${models[@]}"}; do rargs+=(--model "$m"); done
    rc=0
    unit_exec _resume "${rargs[@]}" >/dev/null || rc=$?
    [[ -z "$staged" ]] || rm -f "$staged"
    [[ $rc -eq 0 ]] || launch_failed "$rc" "$ref"
    echo "ship-unit: $ref restarted on $HNAME" >&2
    pull_state "$ref" || true
    wait_driver "$ref"
    finish_unit "$ref"
    ;;

  wait)
    ref=""
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -*) usage "unknown option $1" ;;
        *) [[ -z "$ref" ]] || usage "one ref at a time"; ref="$1"; shift ;;
      esac
    done
    check_ref "$ref"
    load_cfg
    [[ -f "$root/notes/loops/$ref/unit.json" ]] || fail "unknown unit '$ref': no notes/loops/$ref/unit.json"
    select_host "$(jq -r '.host // "local"' "$root/notes/loops/$ref/unit.json")" soft
    wait_driver "$ref"
    finish_unit "$ref"
    ;;

  list)
    [[ $# -eq 0 ]] || usage "list takes no arguments"
    load_cfg
    tmp="$(mktemp -d "${TMPDIR:-/tmp}/ship-unit-list.XXXXXX")" || fail "cannot create a temp dir"
    hosts_seen=()
    # One probe per remote host, all at once: each lists the refs it should answer for.
    for u in "$root"/notes/loops/*/; do
      [[ -f "$u/unit.json" ]] || continue
      h="$(jq -r '.host // "local"' "$u/unit.json" 2>/dev/null)" || h=local
      ship_host_is_local "$h" && continue
      hk="$(printf '%s' "$h" | tr -c 'A-Za-z0-9_-' '_')"
      if [[ ! -f "$tmp/$hk.refs" ]]; then hosts_seen+=("$h"); fi
      ref="${u%/}"; ref="${ref##*/}"
      echo "$ref" >>"$tmp/$hk.refs"
    done
    for h in ${hosts_seen[@]+"${hosts_seen[@]}"}; do
      hk="$(printf '%s' "$h" | tr -c 'A-Za-z0-9_-' '_')"
      (
        t="$(ship_host_target "$h" 2>/dev/null)" || { echo 255 >"$tmp/$hk.rc"; exit 0; }
        # shellcheck disable=SC2046
        ship_host_run "$t" "$root" "$h" ship-unit _probe $(cat "$tmp/$hk.refs") >"$tmp/$hk.out" 2>/dev/null
        echo $? >"$tmp/$hk.rc"
      ) &
    done
    wait
    rows=0
    printf '%-24s %-10s %-12s %-14s %-9s %-6s %s\n' REF HOST STATUS STAGE FAILOVERS AGE ALIVE
    for u in "$root"/notes/loops/*/; do
      [[ -d "$u" ]] || continue
      u="${u%/}"
      ref="${u##*/}"
      h=local
      [[ ! -f "$u/unit.json" ]] || h="$(jq -r '.host // "local"' "$u/unit.json" 2>/dev/null || echo local)"
      # Is the driver alive? Ask where it runs.
      alive=no
      if [[ -f "$u/unit.json" ]]; then
        if ship_host_is_local "$h"; then
          unit_live "$u" && alive=yes
        else
          hk="$(printf '%s' "$h" | tr -c 'A-Za-z0-9_-' '_')"
          if [[ "$(cat "$tmp/$hk.rc" 2>/dev/null)" == 0 ]]; then
            case "$(sed -n "s/^ship-unit-probe: $ref //p" "$tmp/$hk.out" | tail -n 1)" in
              running|starting) alive=yes ;;
              "") alive='?' ;;
            esac
          else
            alive='?'
          fi
        fi
      fi
      st="" stage="-" fo=0
      if [[ -s "$u/result.json" ]]; then
        st="$(jq -r '.status // ""' "$u/result.json" 2>/dev/null || true)"
        stage="$(jq -r '.stage // "-"' "$u/result.json" 2>/dev/null || echo -)"
        fo="$(jq -r '.failovers // 0' "$u/result.json" 2>/dev/null || echo 0)"
      fi
      nf="$(find "$u" -maxdepth 1 -name 'failover-*.json' 2>/dev/null | wc -l | tr -d ' ')"
      [[ "$fo" =~ ^[0-9]+$ ]] || fo=0
      [[ "$nf" -le "$fo" ]] || fo="$nf"
      if [[ "$alive" == yes ]]; then
        st=RUNNING
        newest="$(ls -t "$u"/*.prompt.md 2>/dev/null | head -n 1 || true)"
        stage="-"
        [[ -z "$newest" ]] || { stage="${newest##*/}"; stage="${stage%.prompt.md}"; }
      elif [[ -z "$st" ]]; then
        st=DEAD
      fi
      ref_file="$u/loop.log"
      [[ -e "$ref_file" ]] || ref_file="$u/unit.json"
      t_new=0
      for f in "$u/result.json" "$ref_file"; do
        [[ -e "$f" ]] || continue
        m="$(mtime "$f")"; [[ "$m" -ge "$t_new" ]] && t_new="$m"
      done
      age=$(( $(date +%s) - t_new ))
      if [[ "$t_new" -eq 0 ]]; then age_s="-"
      elif [[ $age -lt 3600 ]]; then age_s="$((age / 60))m"
      elif [[ $age -lt 172800 ]]; then age_s="$((age / 3600))h"
      else age_s="$((age / 86400))d"; fi
      printf '%-24s %-10s %-12s %-14s %-9s %-6s %s\n' "$ref" "$h" "$st" "$stage" "$fo" "$age_s" "$alive"
      rows=$((rows + 1))
    done
    for h in ${hosts_seen[@]+"${hosts_seen[@]}"}; do
      hk="$(printf '%s' "$h" | tr -c 'A-Za-z0-9_-' '_')"
      rm -f "$tmp/$hk.refs" "$tmp/$hk.out" "$tmp/$hk.rc"
    done
    rmdir "$tmp" 2>/dev/null || true
    [[ $rows -gt 0 ]] || echo "(no units)"
    ;;
esac
