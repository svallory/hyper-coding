{
	"name": "@hypercli/hq",
	"version": "0.4.0",
	"packageManager": "bun@1.3.11",
	"type": "module",
	"description": "Claude Code session management for HyperDev — always-on control plane",
	"keywords": ["hyperdev", "claude-code", "remote-control", "session-management", "tmux"],
	"author": "Saulo Vallory <saulo@toki.life>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/svallory/hyper-coding.git",
		"directory": "packages/hq"
	},
	"homepage": "https://hyperdev.saulo.engineer",
	"bugs": {
		"url": "https://github.com/svallory/hyper-coding/issues"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": ["dist", "help", "oclif.manifest.json", "README.md", "LICENSE"],
	"oclif": {
		"commands": "./dist/commands",
		"topics": {
			"hq": {
				"description": "Manage Claude Code sessions with the always-on HQ control center"
			},
			"hq:configure": {
				"description": "Configure individual HQ settings"
			}
		},
		"topicSeparator": " "
	},
	"imports": {
		"#lib/*": "./dist/lib/*.js",
		"#services/*": "./dist/services/*.js",
		"#config/*": "./dist/config/*.js",
		"#utils/*": "./dist/utils/*.js",
		"#commands/*": "./dist/commands/*.js",
		"#tests/*": "./tests/*.ts",
		"#fixtures/*": "./tests/fixtures/*.ts",
		"#*": "./dist/*.js"
	},
	"scripts": {
		"build": "tsc",
		"postbuild": "bunx oclif manifest",
		"clean": "rm -rf dist tsconfig.tsbuildinfo",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@clack/prompts": "^1.1.0",
		"@hypercli/ui": "workspace:*",
		"@oclif/core": "^4",
		"create-hyper-hq": "workspace:*",
		"smol-toml": "^1"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.4",
		"@types/node": "^20.0.0",
		"typescript": "^5.4.0",
		"vitest": "4.0.18"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
