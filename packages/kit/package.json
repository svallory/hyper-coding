{
	"name": "@hypercli/kit",
	"version": "0.5.0",
	"packageManager": "bun@1.3.11",
	"type": "module",
	"description": "Kit lifecycle management for HyperDev",
	"keywords": [
		"hyperdev",
		"hypergen",
		"kits"
	],
	"author": "Saulo Vallory <saulo@toki.life>",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/svallory/hyper-coding.git",
		"directory": "packages/kit"
	},
	"homepage": "https://hyperdev.saulo.engineer",
	"bugs": {
		"url": "https://github.com/svallory/hyper-coding/issues"
	},
	"engines": {
		"bun": ">=1.3.0"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"files": [
		"dist",
		"help",
		"oclif.manifest.json",
		"README.md",
		"LICENSE"
	],
	"oclif": {
		"commands": "./dist/commands",
		"topics": {
			"kit": {
				"description": "Manage generator kits — install, update, and inspect"
			},
			"recipe": {
				"description": "Browse and run code generation recipes"
			},
			"cookbook": {
				"description": "Explore multi-step generation cookbooks"
			}
		},
		"topicSeparator": " "
	},
	"imports": {
		"#types/*": "./dist/types/*.js",
		"#utils/*": "./dist/utils/*.js",
		"#commands/*": "./dist/commands/*.js",
		"#tests/*": "./tests/*.ts",
		"#fixtures/*": "./tests/fixtures/*.ts",
		"#*": "./dist/*.js"
	},
	"scripts": {
		"build": "tsc",
		"postbuild": "bun x --no-install oclif manifest",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "biome check .",
		"format": "biome format . --write",
		"typecheck": "tsc --noEmit",
		"prepublishOnly": "bun run build"
	},
	"dependencies": {
		"@hypercli/core": "workspace:*",
		"@hypercli/ui": "workspace:*",
		"@clack/prompts": "^0.11.0",
		"@oclif/core": "^4",
		"debug": "^4.4.3",
		"giget": "^2.0.0",
		"js-yaml": "^4.1.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@types/debug": "^4.1.13",
		"@types/fs-extra": "^11.0.4",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^20.0.0",
		"@vitest/coverage-v8": "^4.0.0",
		"fs-extra": "^11.3.3",
		"oclif": "6.0.2",
		"typescript": "^5.4.0",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "4.0.18"
	},
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	}
}
