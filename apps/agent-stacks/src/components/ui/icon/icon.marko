// marko-ui's Icon, trimmed to what this site uses: a Lucide icon drawn on the
// server only. The map is in __lucide__.ts; `Book` was added by hand (deviation
// agent-stacks-icons/book). There is no client resolver by design (deviation
// agent-stacks-icons/no-client-icon): the browser never draws an icon and its
// bundle must not carry the map. Re-running `marko-ui add icon --overwrite`
// discards these edits.
import { cn } from "../../../lib/utils.ts";
import { LUCIDE_WRAPPER } from "./render.ts";
import type { IconName } from "./icon-names.ts";
server import { resolveIconInner } from "./resolve.ts";

static const SIZED = "size-4";
static let drawIcon: (name: string) => string = () => "";
server {
  drawIcon = resolveIconInner;
}

export interface Input {
  /** Abstract icon name, e.g. "SearchIcon". */
  name: IconName;
  class?: string;
  /** Drop the default `size-4` class when an ancestor sizes the icon. */
  unsized?: boolean;
  "aria-hidden"?: "true" | "false";
}

<const/{ name, class: className, unsized }=input/>

<svg
  aria-hidden=input["aria-hidden"]
  xmlns="http://www.w3.org/2000/svg"
  viewBox=LUCIDE_WRAPPER.viewBox
  width="24"
  height="24"
  fill=LUCIDE_WRAPPER.fill
  stroke=LUCIDE_WRAPPER.stroke
  stroke-width=LUCIDE_WRAPPER["stroke-width"]
  stroke-linecap=LUCIDE_WRAPPER["stroke-linecap"]
  stroke-linejoin=LUCIDE_WRAPPER["stroke-linejoin"]
  class=cn(unsized ? undefined : SIZED, className) || undefined
  data-icon-name=name
  data-icon-library="lucide"
>
  $!{drawIcon(name)}
</svg>
