import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="refactoring" name="Refactoring" source=pstack>
  <@by><playbook-ref of=pstack name="refactoring" path="skills/poteto-mode/playbooks/refactoring.md"/></@by>
  <@summary>
    "You own the contract. The structure changes. The behavior does not." A redesign routes to Feature; large structural work routes to figure-it-out.
  </@summary>
  <@order label="Ends with" lead="Opening a PR">
    Reply: the structure that changed, the pin you held it against, the equivalence proof, the reader-load delta, what shipped and what got reverted. No new behavior.
  </@order>

  <@step id="pin-behaviour" title="Pin behaviour" phrase="A characterization test before any move"
    group="check">
    <@what>
      A characterization test, snapshot or equivalence harness that captures current behaviour. "Type check and lint are not a pin."
    </@what>
    <@actor>Main agent</@actor>
    <@output>The pin</@output>
    <@gate>The pin must exist before structure moves (prompt text)</@gate>

    <@row kind="playbook" name="Refactoring" path="skills/poteto-mode/playbooks/refactoring.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
  </@step>

  <@step id="name-structure" title="Name structure" phrase="What the code is missing" group="plan">
    <@what>
      "The reshape must delete branches or invalid states, not add indirection." Boring code stays when its shape is already clear and local.
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="skill" name="principle-model-the-domain"
      path="skills/principle-model-the-domain/SKILL.md" by="model; the step cites this principle">
      State machine, typed model, table or registry.
    </@row>
  </@step>

  <@step id="target-shape" title="Target shape" phrase="Layout, types and call graph" group="plan">
    <@what>
      What the module layout, types and call graph would be if built today. Across a function boundary: architect first.
    </@what>
    <@actor>Main agent</@actor>
    <@handoff to="feature"/>
    <@handoff to="figure-it-out"/>

    <@row kind="skill" name="architect" path="skills/architect/SKILL.md" by="model, named in this step">
      Designs the shape of a change that crosses a function boundary. It runs arena.
    </@row>
    <@row kind="skill" name="principle-foundational-thinking"
      path="skills/principle-foundational-thinking/SKILL.md"
      by="model; the step cites this principle">
      Core types and data structures first.
    </@row>
    <@row kind="skill" name="principle-redesign-from-first-principles"
      path="skills/principle-redesign-from-first-principles/SKILL.md"
      by="model; the step cites this principle">
      Design as if the requirement had always been there.
    </@row>
  </@step>

  <@step id="subtract-first" title="Subtract first" phrase="Delete dead weight before adding"
    group="build">
    <@what>
      Delete dead code, collapse one-caller wrappers, drop redundant validators, remove orphan references. "A speculative cleanup that might help gets reverted."
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="skill" name="principle-subtract-before-you-add"
      path="skills/principle-subtract-before-you-add/SKILL.md"
      by="model; the step cites this principle">
      Remove before you build.
    </@row>
    <@row kind="skill" name="principle-laziness-protocol"
      path="skills/principle-laziness-protocol/SKILL.md" by="model; the step cites this principle">
      The smallest change that reaches the target.
    </@row>
  </@step>

  <@step id="small-steps" title="Small steps" phrase="Each keeps the pin green" group="build">
    <@what>
      For an API reshape, migrate every caller and delete the old API in the same wave: "No compatibility shims, no parallel old-and-new paths." Mechanical edits go to a subagent.
    </@what>
    <@actor>
      Main agent leads; a <agent-ref of=pstack name="poteto-agent" path="agents/poteto-agent.md"/> subagent writes
    </@actor>
    <@gate>The pin stays green after each step (prompt text)</@gate>
    <@back>Itself, one behaviour-preserving step at a time</@back>

    <@row kind="agent" name="poteto-agent" path="agents/poteto-agent.md" by="main agent, Task tool">
      Subagent type for any subagent a playbook step spawns. Background, fresh per task.
    </@row>
    <@row kind="reference" name="worker.md" path="skills/poteto-mode/worker.md"
      by="first line of every agent kickoff">
      Rules every spawned agent reads first: no extra gates, never ask a person, PR format.
    </@row>
    <@row kind="rule" name="pstack-models.mdc" gloss="~/.cursor/rules/pstack-models.mdc"
      by="written by /setup-pstack; read by the model">
      Per-role model lines. Each code playbook reads its own line.
    </@row>
    <@row kind="skill" name="principle-migrate-callers-then-delete-legacy-apis"
      path="skills/principle-migrate-callers-then-delete-legacy-apis/SKILL.md"
      by="model; the step cites this principle">
      One wave: migrate, then delete.
    </@row>
  </@step>

  <@step id="prove-unchanged" title="Prove unchanged" phrase="On the real artifact" group="check">
    <@what>
      Not "it compiles". For larger reshapes: a script that diffs old against new outputs, a recorded baseline replayed, or a smoke run through the control skill.
    </@what>
    <@actor>Main agent</@actor>
    <@output>The equivalence proof</@output>

    <@row kind="skill" name="principle-prove-it-works" path="skills/principle-prove-it-works/SKILL.md"
      by="model; the step cites this principle">
      Verify on the real artifact, not a proxy.
    </@row>
    <@row kind="skill" name="control-ui / control-cli" gloss="cursor-team-kit plugin (not in pstack)"
      by="model; \"the matching control skill\"">
      Drives the real UI or CLI the way a user would.
    </@row>
  </@step>

  <@step id="worth-keeping" title="Worth keeping" phrase="Lower reader load, else revert" group="check">
    <@what>
      "The success measure is reduced reader load. If the diff does not lower reader load somewhere, revert it."
    </@what>
    <@actor>Main agent</@actor>
    <@gate>The model's judgment of reader load</@gate>

    <@row kind="skill" name="principle-minimize-reader-load"
      path="skills/principle-minimize-reader-load/SKILL.md"
      by="model; the step cites this principle">
      Count layers and hidden state.
    </@row>
  </@step>

  <@step id="commits-and-pr" title="Commits and PR" phrase="Subtraction, reshape, cleanup; then PR"
    group="ship">
    <@what>
      A subtraction commit, then the reshape, then follow-on cleanup. Then "Run <playbook-ref of=pstack name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"/>".
    </@what>
    <@actor>Main agent</@actor>
    <@handoff to="opening-a-pr"/>

    <@row kind="skill" name="principle-sequence-verifiable-units"
      path="skills/principle-sequence-verifiable-units/SKILL.md"
      by="model; the step cites this principle">
      Verify each unit before starting the next.
    </@row>
    <@row kind="binary" name="git" gloss="git CLI" by="model">
      Worktrees, rebase, patch-id, push.
    </@row>
    <@row kind="playbook" name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"
      by="model; last step of this playbook">
      The shared closing playbook.
    </@row>
  </@step>

  <@connector from="pin-behaviour" to="name-structure"/>

  <@connector from="name-structure" to="target-shape"/>

  <@connector from="target-shape" to="subtract-first"/>

  <@connector from="subtract-first" to="small-steps"/>

  <@connector from="small-steps" to="prove-unchanged"/>

  <@connector from="prove-unchanged" to="worth-keeping"/>

  <@connector from="worth-keeping" to="commits-and-pr"/>

  <@connector from="small-steps" to="small-steps" label="next small step" enforced="prompt">
    <@when>More structure remains to move.</@when>
    <@by>model</@by>
    <@how>Each step must keep the pin green before the next. No cap.</@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Refactoring" path="skills/poteto-mode/playbooks/refactoring.md"/> step 5
    </@source>
  </@connector>
</lane>
