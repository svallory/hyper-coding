import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="authoring-a-skill" name="Authoring a skill" source=pstack>
  <@by><playbook-ref of=pstack name="authoring-a-skill" path="skills/poteto-mode/playbooks/authoring-a-skill.md"/></@by>
  <@summary>
    "You own the skill's voice." "When in doubt, delete. Keep only prose that changes a decision."
  </@summary>
  <@order label="Ends with" lead="Opening a PR">
    Reply: summary of the skill, key design decisions, validation notes.
  </@order>

  <@step id="write-skill" title="Write skill" phrase="Cursor's built-in create-skill" group="build">
    <@what>
      "Tell it to do the thing and skip the reason. Explain only when the rule is confusing without one." Delegate to other skills by path; do not restate them.
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="playbook" name="Authoring a skill"
      path="skills/poteto-mode/playbooks/authoring-a-skill.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
    <@row kind="skill" name="create-skill" gloss="Cursor built-in skill (not in pstack)"
      by="model, named in this step">
      Authors SKILL.md files.
    </@row>
    <@row kind="skill" name="principle-encode-lessons-in-structure"
      path="skills/principle-encode-lessons-in-structure/SKILL.md"
      by="model; the step cites this principle">
      Point at types, READMEs and config.
    </@row>
  </@step>

  <@step id="validate" title="Validate" phrase="Frontmatter, files exist, links resolve" group="check">
    <@what>
      Frontmatter has name and description, referenced files exist, cross-skill links resolve.
    </@what>
    <@actor>Main agent, by hand</@actor>
    <@gate>No validator script is named</@gate>
  </@step>

  <@step id="test-cases" title="Test cases" phrase="Only if structural" group="check">
    <@what>"Test cases if structural. Skip if subjective."</@what>
    <@actor>Main agent</@actor>
  </@step>

  <@step id="opening-a-pr" title="Opening a PR" phrase="Run the shared PR playbook" group="ship">
    <@what>"Run <playbook-ref of=pstack name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"/>."</@what>
    <@actor>Main agent</@actor>
    <@output>A ready (not draft) PR</@output>
    <@gate>None in code</@gate>
    <@handoff to="opening-a-pr"/>

    <@row kind="playbook" name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"
      by="model; last step of this playbook">
      The shared closing playbook.
    </@row>
  </@step>

  <@connector from="write-skill" to="validate"/>

  <@connector from="validate" to="test-cases" pick enforced="prompt">
    <@when>The skill is structural.</@when>
    <@by>model</@by>
    <@how>The model decides whether it is structural or subjective.</@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Authoring a skill" path="skills/poteto-mode/playbooks/authoring-a-skill.md"/> step 3
    </@source>
  </@connector>

  <@connector from="test-cases" to="opening-a-pr"/>

  <@connector from="validate" to="opening-a-pr" label="subjective: no tests" enforced="prompt">
    <@when>The skill is subjective.</@when>
    <@by>model</@by>
    <@how>"Skip if subjective."</@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Authoring a skill" path="skills/poteto-mode/playbooks/authoring-a-skill.md"/> step 3
    </@source>
  </@connector>
</lane>
