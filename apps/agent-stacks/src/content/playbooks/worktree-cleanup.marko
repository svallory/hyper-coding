import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="worktree-cleanup" name="Worktree cleanup" source=pstack>
  <@by><playbook-ref of=pstack name="worktree-cleanup" path="skills/poteto-mode/playbooks/worktree-cleanup.md"/></@by>
  <@summary>
    "This is the one playbook that deletes user state with no code review to catch a slip, so the gates above are the review."
  </@summary>
  <@order label="Ends with" lead="pruned worktrees; space reclaimed">
    Reply: df -h / before and after with space reclaimed, the worktrees pruned, and a one-line reason for each held back.
  </@order>

  <@step id="snapshot-and-audit" title="Snapshot and audit" phrase="df -h, then worktree-audit.sh"
    group="plan">
    <@what>
      The script reads paths from git worktree list, never hand-typed, and classifies each worktree by size, age, merge state, uncommitted work, PR state and the newest chat that touched it. Without -b it checks MERGED against origin/HEAD.
    </@what>
    <@actor>Main agent</@actor>
    <@output>A table with a suggested bucket per worktree</@output>
    <@gate>The script only prints; it never deletes</@gate>

    <@row kind="playbook" name="Worktree cleanup"
      path="skills/poteto-mode/playbooks/worktree-cleanup.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
    <@row kind="script" name="worktree-audit.sh" path="skills/poteto-mode/scripts/worktree-audit.sh"
      by="model, step 1">
      Suggests a bucket per worktree: hold-wip, hold-open-pr, verify-recent-chat, safe, review. Never deletes.
    </@row>
    <@row kind="binary" name="git" gloss="git CLI" by="model">
      Worktrees, rebase, patch-id, push.
    </@row>
  </@step>

  <@step id="cross-check-pins" title="Cross-check pins" phrase="Pinned and active chats win"
    group="check" human>
    <@what>
      "The bucket is advice, not permission." Get the pinned and active chats from the user or the sidebar and cross-check every candidate. "The lever has marked safe a worktree the user had pinned, so the pinned set wins."
    </@what>
    <@actor>Main agent and the user</@actor>

    <@row kind="skill" name="principle-prove-it-works" path="skills/principle-prove-it-works/SKILL.md"
      by="model; the step cites this principle">
      Verify on the real artifact, not a proxy.
    </@row>
  </@step>

  <@step id="verify-usage" title="Verify usage" phrase="Subagents read the transcripts" group="check">
    <@what>
      For every verify-recent-chat row, or anything in doubt, subagents read the transcripts and report whether the chat is pinned or ongoing and which worktrees it touches.
    </@what>
    <@actor>Subagents</@actor>

    <@row kind="skill" name="principle-guard-the-context-window"
      path="skills/principle-guard-the-context-window/SKILL.md"
      by="model; the step cites this principle">
      Send bulk reading to subagents; keep the summary.
    </@row>
    <@row kind="agent" name="poteto-agent" path="agents/poteto-agent.md" by="main agent, Task tool">
      Subagent type for any subagent a playbook step spawns. Background, fresh per task.
    </@row>
  </@step>

  <@step id="pause-on-loss" title="Pause on loss" phrase="wip: show the diff, get a decision"
    group="check" human>
    <@what>
      wip:N is N tracked uncommitted edits: show the diff and get a decision first. scratch:N is untracked throwaway: safe to drop, but name the files. Clean, merged and not in use proceeds.
    </@what>
    <@actor>The user, for wip and in-use worktrees</@actor>
    <@gate>Prompt text</@gate>
  </@step>

  <@step id="prune" title="Prune" phrase="git worktree remove --force" group="ship">
    <@what>
      Per path: git worktree remove --force; if the directory survives on ignored build artifacts, rm -rf it; then git worktree prune. Branch refs survive. Confirm with df -h / and re-list.
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="binary" name="git" gloss="git CLI" by="model">
      Worktrees, rebase, patch-id, push.
    </@row>
  </@step>

  <@step id="simulators-and-caches" title="Simulators and caches"
    phrase="simctl, DerivedData, package caches" group="ship">
    <@what>
      <binary-ref of=pstack name="xcrun simctl"/> delete for test clones, unavailable devices and old runtimes; Xcode DerivedData and iOS DeviceSupport; Cursor application support; pnpm, uv, brew and yarn caches. "Clear only caches the user has not said to keep."
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="binary" name="xcrun simctl" gloss="Xcode CLI" by="model, named in this step">
      Deletes simulators and runtimes.
    </@row>
  </@step>

  <@connector from="snapshot-and-audit" to="cross-check-pins"/>

  <@connector from="cross-check-pins" to="verify-usage"/>

  <@connector from="verify-usage" to="pause-on-loss"/>

  <@connector from="pause-on-loss" to="prune" pick enforced="prompt">
    <@when>The candidate has uncommitted work or is in use.</@when>
    <@by>human for wip and in-use; model otherwise</@by>
    <@how>
      The user decides after seeing the diff. Clean, merged and not-in-use worktrees proceed without asking, per Autonomy.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Worktree cleanup" path="skills/poteto-mode/playbooks/worktree-cleanup.md"/> step 4
    </@source>
  </@connector>

  <@connector from="prune" to="simulators-and-caches"/>
</lane>
