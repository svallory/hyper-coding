import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="feature" name="Feature" source=pstack>
  <@by><playbook-ref of=pstack name="feature" path="skills/poteto-mode/playbooks/feature.md"/></@by>
  <@summary>
    "You own the design. Plan, review, verify." Delegate implementation; stay in the lead.
  </@summary>
  <@order label="Ends with" lead="Opening a PR">
    Reply: what you built, what you chose and why, the throughput checkpoint, open decisions. Tables for design alternatives.
  </@order>

  <@step id="trace-subsystem" title="Trace subsystem" phrase="Read what the change touches" group="plan">
    <@what>"Trace the affected subsystem."</@what>
    <@actor>Main agent</@actor>
    <@input>A feature request</@input>

    <@row kind="playbook" name="Feature" path="skills/poteto-mode/playbooks/feature.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
  </@step>

  <@step id="architect" title="Architect" phrase="The shape of the change" group="plan">
    <@what>
      "<skill-ref of=pstack name="architect" path="skills/architect/SKILL.md"/> for the shape." The <skill-ref of=pstack name="architect" path="skills/architect/SKILL.md"/> skill runs an <skill-ref of=pstack name="arena" path="skills/arena/SKILL.md"/> of competing designs.
    </@what>
    <@actor>Main agent</@actor>
    <@output>A chosen shape</@output>

    <@row kind="skill" name="architect" path="skills/architect/SKILL.md" by="model, named in this step">
      Designs the shape of a change that crosses a function boundary. It runs <skill-ref of=pstack name="arena" path="skills/arena/SKILL.md"/>.
    </@row>
    <@row kind="skill" name="arena" path="skills/arena/SKILL.md" by="model, named in this step">
      Several runners on different models build the same thing; a cross-judge picks.
    </@row>
  </@step>

  <@step id="throughput-checkpoint" title="Throughput checkpoint"
    phrase="Four todo items; n/a needs a reason" group="plan">
    <@what>
      Blocking first steps; independent workstreams; shared mutable state; smallest safe decomposition. A dimension that does not apply keeps its item as "n/a: &lt;reason>".
    </@what>
    <@actor>Main agent</@actor>
    <@output>Four todo items</@output>
    <@gate>None in code</@gate>

    <@row kind="skill" name="principle-separate-before-serializing-shared-state"
      path="skills/principle-separate-before-serializing-shared-state/SKILL.md"
      by="model; the step cites this principle">
      Split the shared target before serializing writers.
    </@row>
  </@step>

  <@step id="delegate-build" title="Delegate build" phrase="Subagent, or arena for several shapes"
    group="build">
    <@what>
      A subagent on the configured feature model gets file paths, the named data shape and success criteria. When the implementation admits several valid shapes, it goes through <skill-ref of=pstack name="arena" path="skills/arena/SKILL.md"/> instead: "Mandatory: no skip-with-reason escape". Code-coupled work goes to a single owner.
    </@what>
    <@actor>
      Main agent leads; a <agent-ref of=pstack name="poteto-agent" path="agents/poteto-agent.md"/> subagent writes
    </@actor>
    <@output>Commits</@output>
    <@gate>The arena rule is prompt text</@gate>

    <@row kind="agent" name="poteto-agent" path="agents/poteto-agent.md" by="main agent, Task tool">
      Subagent type for any subagent a playbook step spawns. Background, fresh per task.
    </@row>
    <@row kind="reference" name="worker.md" path="skills/poteto-mode/worker.md"
      by="first line of every agent kickoff">
      Rules every spawned agent reads first: no extra gates, never ask a person, PR format.
    </@row>
    <@row kind="rule" name="pstack-models.mdc" gloss="~/.cursor/rules/pstack-models.mdc"
      by="written by /setup-pstack; read by the model">
      Per-role model lines. Each code playbook reads its own line.
    </@row>
    <@row kind="skill" name="arena" path="skills/arena/SKILL.md" by="model, named in this step">
      Several runners on different models build the same thing; a cross-judge picks.
    </@row>
    <@row kind="skill" name="principle-model-the-domain"
      path="skills/principle-model-the-domain/SKILL.md" by="model; the step cites this principle">
      Pick the organizing structure before logic is written.
    </@row>
  </@step>

  <@step id="verify" title="Verify" phrase="Matching surface; inconclusive is no pass" group="check">
    <@what>
      "Verify on the matching surface. Inconclusive or wrong-surface is not a pass. Flag it."
    </@what>
    <@actor>Main agent</@actor>
    <@gate>Prompt text</@gate>

    <@row kind="skill" name="control-ui / control-cli" gloss="cursor-team-kit plugin (not in pstack)"
      by="model; \"the matching control skill\"">
      Drives the real UI or CLI the way a user would.
    </@row>
  </@step>

  <@step id="order-commits" title="Order commits" phrase="Small ordered commits; stack follow-ups"
    group="ship">
    <@what>
      "Rebase into small, ordered commits. Stack follow-ups." Each small unit is built, verified and committed before the next.
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="skill" name="principle-sequence-verifiable-units"
      path="skills/principle-sequence-verifiable-units/SKILL.md"
      by="model; the step cites this principle">
      Verify each unit before starting the next.
    </@row>
    <@row kind="binary" name="git" gloss="git CLI" by="model">
      Worktrees, rebase, patch-id, push.
    </@row>
  </@step>

  <@step id="interrogate" title="Interrogate" phrase="Only if the design is contested" group="check">
    <@what>"If the design is contested, <skill-ref of=pstack name="interrogate" path="skills/interrogate/SKILL.md"/> before shipping."</@what>
    <@actor>A panel of reviewers on different models</@actor>

    <@row kind="skill" name="interrogate" path="skills/interrogate/SKILL.md"
      by="model, named in this step">
      A panel on different models attacks the design.
    </@row>
  </@step>

  <@step id="opening-a-pr" title="Opening a PR" phrase="Run the shared PR playbook" group="ship">
    <@what>"Run <playbook-ref of=pstack name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"/>."</@what>
    <@actor>Main agent</@actor>
    <@output>A ready (not draft) PR</@output>
    <@gate>None in code</@gate>
    <@handoff to="opening-a-pr"/>

    <@row kind="playbook" name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"
      by="model; last step of this playbook">
      The shared closing playbook.
    </@row>
  </@step>

  <@connector from="trace-subsystem" to="architect"/>

  <@connector from="architect" to="throughput-checkpoint"/>

  <@connector from="throughput-checkpoint" to="delegate-build"/>

  <@connector from="delegate-build" to="verify"/>

  <@connector from="verify" to="order-commits"/>

  <@connector from="order-commits" to="interrogate" pick enforced="prompt">
    <@when>The design is contested.</@when>
    <@by>model</@by>
    <@how>The model judges whether it is. Nothing defines "contested".</@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Feature" path="skills/poteto-mode/playbooks/feature.md"/> step 7
    </@source>
  </@connector>

  <@connector from="interrogate" to="opening-a-pr"/>

  <@connector from="order-commits" to="opening-a-pr" label="design not contested" enforced="prompt">
    <@when>Nobody contests the design.</@when>
    <@by>model</@by>
    <@how>Interrogate is skipped.</@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Feature" path="skills/poteto-mode/playbooks/feature.md"/> step 7
    </@source>
  </@connector>

  <@connector from="delegate-build" to="throughput-checkpoint" label="phase boundary" enforced="prompt">
    <@when>The work crosses a phase boundary.</@when>
    <@by>model</@by>
    <@how>
      "Rewrite the checkpoint at phase boundaries. Spawn a fresh owner rather than chaining interrupts."
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Feature" path="skills/poteto-mode/playbooks/feature.md"/>, closing paragraph
    </@source>
  </@connector>
</lane>
