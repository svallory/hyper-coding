import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="pause-safely" name="Pause safely" source=pstack>
  <@by><playbook-ref of=pstack name="pause-safely" path="skills/poteto-mode/playbooks/pause-safely.md"/></@by>
  <@summary>
    "You own a clean stop. Leave a checkpoint a cold-start agent can resume from." Explicit only: on "keep going" or "don't stop", do not pause.
  </@summary>
  <@order label="Ends with" lead="a pause, not a final report">
    Reply: where you are in the loop, what is on disk versus still in your head (paths, no diff dumps), the commits you made and whether the tree is clean, and the first action on resume.
  </@order>

  <@step id="safe-boundary" title="Safe boundary" phrase="Finish or back out; cancel subagents"
    group="plan">
    <@what>
      "Finish the current atomic step or back out of it. Start nothing new, and cancel any nested subagents."
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="playbook" name="Pause safely" path="skills/poteto-mode/playbooks/pause-safely.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
  </@step>

  <@step id="nothing-irreversible" title="Nothing irreversible" phrase="No new PR, no new push"
    group="check">
    <@what>"No PR and no push unless you already had one out."</@what>
    <@actor>Main agent</@actor>
  </@step>

  <@step id="wip-commit" title="WIP commit" phrase="One wip: commit on this branch" group="ship">
    <@what>
      Commit uncommitted edits as one clear wip: commit so nothing is lost. "If the tree is broken, say so in the commit body in one line."
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="binary" name="git" gloss="git CLI" by="model">
      Worktrees, rebase, patch-id, push.
    </@row>
  </@step>

  <@step id="resume-note" title="Resume note" phrase="Off-context file or trail pointer" group="learn">
    <@what>
      Intent, what you were doing, progress and what is verified, current state, next steps, key files, gotchas. For the compaction trigger, a file like /tmp/&lt;slug>-resume.md. If a <skill-ref of=pstack name="show-me-your-work" path="skills/show-me-your-work/SKILL.md"/> trail exists, point at it.
    </@what>
    <@actor>Main agent</@actor>
    <@handoff to="session-pickup"/>

    <@row kind="skill" name="show-me-your-work" path="skills/show-me-your-work/SKILL.md"
      by="model, named in this step">
      Decision trail: one row per attempt or step.
    </@row>
  </@step>

  <@connector from="safe-boundary" to="nothing-irreversible"/>

  <@connector from="nothing-irreversible" to="wip-commit"/>

  <@connector from="wip-commit" to="resume-note"/>
</lane>
