import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="runtime-forensics" name="Runtime forensics" source=pstack>
  <@by><playbook-ref of=pstack name="runtime-forensics" path="skills/poteto-mode/playbooks/runtime-forensics.md"/></@by>
  <@summary>
    "You own the diagnosis. Instrument the live process, don't theorize from source." The deliverable is a cited diagnosis, not a fix.
  </@summary>
  <@order label="Ends with" lead="a diagnosis; no fix unless asked">
    Reply: the signal captured, the reduced finding, how you proved the mechanism, the source location, artifact paths. "Hand back to <playbook-ref of=pstack name="Bug fix" path="skills/poteto-mode/playbooks/bug-fix.md"/> or Perf once the cause is known."
  </@order>

  <@step id="capture-signal" title="Capture signal" phrase="CPU profile, heap snapshot or CDP trace"
    group="plan">
    <@what>
      On the matching surface, through the control skill: a CPU profile for a spinning process, a heap snapshot for a leak, a CDP trace for a visual glitch. "A real artifact, not a guess."
    </@what>
    <@actor>Main agent</@actor>
    <@input>A live process that misbehaves</@input>
    <@output>A capture file</@output>

    <@row kind="playbook" name="Runtime forensics"
      path="skills/poteto-mode/playbooks/runtime-forensics.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
    <@row kind="skill" name="control-ui / control-cli" gloss="cursor-team-kit plugin (not in pstack)"
      by="model; \"the matching control skill\"">
      Drives the real UI or CLI the way a user would.
    </@row>
  </@step>

  <@step id="reduce-artifact" title="Reduce artifact" phrase="Find the smoking gun" group="plan">
    <@what>
      The function on the hot path, the retainer chain from the leaked object to a GC root, the loop firing without input. Large artifacts are parsed in a subagent; the reduced finding stays in the main thread.
    </@what>
    <@actor>A subagent parses; the main agent keeps the finding</@actor>
    <@output>The reduced finding</@output>

    <@row kind="skill" name="principle-guard-the-context-window"
      path="skills/principle-guard-the-context-window/SKILL.md"
      by="model; the step cites this principle">
      Send bulk reading to subagents; keep the summary.
    </@row>
    <@row kind="agent" name="poteto-agent" path="agents/poteto-agent.md" by="main agent, Task tool">
      Subagent type for any subagent a playbook step spawns. Background, fresh per task.
    </@row>
    <@row kind="reference" name="worker.md" path="skills/poteto-mode/worker.md"
      by="first line of every agent kickoff">
      Rules every spawned agent reads first: no extra gates, never ask a person, PR format.
    </@row>
  </@step>

  <@step id="prove-mechanism" title="Prove mechanism" phrase="Instrument or hotfix the live process"
    group="check">
    <@what>
      "Prove the mechanism before believing it." Inject instrumentation by CDP eval on the running process, or hotfix the live code without reloading.
    </@what>
    <@actor>Main agent</@actor>
    <@output>Runtime evidence for the hypothesis</@output>
    <@gate>Evidence from the running process, in prompt text</@gate>
  </@step>

  <@step id="map-to-source" title="Map to source" phrase="File, symbol and line" group="plan">
    <@what>
      The line that allocates or schedules. Then the one-line checkpoint: "throughput checkpoint: n/a, read-only forensics".
    </@what>
    <@actor>Main agent</@actor>
    <@output>The cited diagnosis</@output>
    <@handoff to="bug-fix"/>
    <@handoff to="perf-issue"/>
  </@step>

  <@connector from="capture-signal" to="reduce-artifact"/>

  <@connector from="reduce-artifact" to="prove-mechanism"/>

  <@connector from="prove-mechanism" to="map-to-source"/>
</lane>
