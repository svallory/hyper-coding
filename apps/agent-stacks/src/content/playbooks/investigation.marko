import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="investigation" name="Investigation" source=pstack>
  <@by><playbook-ref of=pstack name="investigation" path="skills/poteto-mode/playbooks/investigation.md"/></@by>
  <@summary>
    "You own the answer. Plan, route, write." Read-only: a cited explanation or a recommendation, not a code change.
  </@summary>
  <@order label="Ends with" lead="a reply; no PR">
    Reply: the investigation output. For "are we sure?" answers, your real judgment with reasons; push back if the premise is wrong. "No PR, no babysit, no <skill-ref of=pstack name="architect" path="skills/architect/SKILL.md"/> unless the investigation precedes a code change."
  </@order>

  <@step id="trace-code" title="Trace code" phrase="Read the code the question is about" group="plan">
    <@what>Trace the code. For a motivation question, also route through the <skill-ref of=pstack name="why" path="skills/why/SKILL.md"/> skill.</@what>
    <@actor>Main agent</@actor>
    <@input>A question</@input>
    <@output>A trace with citations</@output>

    <@row kind="playbook" name="Investigation" path="skills/poteto-mode/playbooks/investigation.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
    <@row kind="skill" name="why" path="skills/why/SKILL.md" by="model, named in this step">
      Finds the reason code is the way it is, from history.
    </@row>
  </@step>

  <@step id="checkpoint-line" title="Checkpoint line" phrase="One line: n/a, read-only" group="plan">
    <@what>
      The throughput checkpoint that <playbook-ref of=pstack name="Feature" path="skills/poteto-mode/playbooks/feature.md"/> writes as four items stays one line here: "throughput checkpoint: n/a, read-only investigation".
    </@what>
    <@actor>Main agent</@actor>
  </@step>

  <@step id="write-answer" title="Write answer" phrase="Five sections, or a tradeoffs table"
    group="build">
    <@what>
      Overview, Key Concepts, How It Works, Where Things Live, Gotchas. If the request is a choice between alternatives: a recommendation with a tradeoffs table.
    </@what>
    <@actor>Main agent</@actor>
    <@output>The explanation or recommendation</@output>
  </@step>

  <@step id="unslop-reply" title="Unslop reply" phrase="Strip filler from the prose" group="check">
    <@what>
      Apply the <skill-ref of=pstack name="unslop" path="skills/unslop/SKILL.md"/> skill to the reply. If the investigation was the first half of a code change: "hand back to the user and re-route to <playbook-ref of=pstack name="Bug fix" path="skills/poteto-mode/playbooks/bug-fix.md"/> or <playbook-ref of=pstack name="Feature" path="skills/poteto-mode/playbooks/feature.md"/>".
    </@what>
    <@actor>Main agent</@actor>
    <@output>The reply</@output>
    <@handoff to="bug-fix"/>
    <@handoff to="feature"/>

    <@row kind="skill" name="unslop" path="skills/unslop/SKILL.md" by="model, named in this step">
      Removes filler and AI tells from prose.
    </@row>
  </@step>

  <@connector from="trace-code" to="checkpoint-line"/>

  <@connector from="checkpoint-line" to="write-answer"/>

  <@connector from="write-answer" to="unslop-reply"/>
</lane>
