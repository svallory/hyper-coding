import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="session-pickup" name="Session pickup" source=pstack>
  <@by><playbook-ref of=pstack name="session-pickup" path="skills/poteto-mode/playbooks/session-pickup.md"/></@by>
  <@summary>"You own the resume point. Read the prior trail, don't redo it."</@summary>
  <@order label="Ends with" lead="a routed playbook">
    Reply: where the prior agent stopped, what you inherited vs redid (ideally nothing redone), the resume point, and the outcome.
  </@order>

  <@step id="locate-trail" title="Locate trail" phrase="Transcript, cloud URL or branch" group="plan">
    <@what>
      A local transcript under the active workspace's agent-transcripts/ directory, a cloud-agent URL, or a pushed branch. Read the metadata overview and last messages first, then scan back for the decision points. A long transcript is parsed in a subagent.
    </@what>
    <@actor>Main agent or a subagent</@actor>

    <@row kind="playbook" name="Session pickup" path="skills/poteto-mode/playbooks/session-pickup.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
    <@row kind="skill" name="principle-guard-the-context-window"
      path="skills/principle-guard-the-context-window/SKILL.md"
      by="model; the step cites this principle">
      Send bulk reading to subagents; keep the summary.
    </@row>
    <@row kind="agent" name="poteto-agent" path="agents/poteto-agent.md" by="main agent, Task tool">
      Subagent type for any subagent a playbook step spawns. Background, fresh per task.
    </@row>
  </@step>

  <@step id="rebuild-state" title="Rebuild state" phrase="Branch, landed work, todos, decisions"
    group="plan">
    <@what>
      The branch and worktree, what already landed (git log, git diff against the base), the open todos, the decisions made. "The prior trail is authoritative input. Resist the bias to re-derive it."
    </@what>
    <@actor>Main agent</@actor>

    <@row kind="binary" name="git" gloss="git CLI" by="model">
      Worktrees, rebase, patch-id, push.
    </@row>
  </@step>

  <@step id="done-versus-pending" title="Done versus pending" phrase="Name the resume point" group="plan">
    <@what>
      Compare what shipped against what was planned. Do not re-run the prior repro or redo completed work.
    </@what>
    <@actor>Main agent</@actor>
    <@output>The resume point</@output>
  </@step>

  <@step id="route" title="Route" phrase="Pick a playbook and a verdict" group="plan">
    <@what>
      The verdict is one of: continue the execution, ship a finished recommendation, ratify or override a prior conclusion, or postmortem a failed run. "The pickup playbook ends here. The routed playbook owns the rest."
    </@what>
    <@actor>Main agent</@actor>
    <@handoff to="router"/>
  </@step>

  <@step id="verify-inherited" title="Verify inherited" phrase="Claims against the real artifact"
    group="check">
    <@what>"A passing prior self-report is not the proof."</@what>
    <@actor>Main agent</@actor>

    <@row kind="skill" name="principle-prove-it-works" path="skills/principle-prove-it-works/SKILL.md"
      by="model; the step cites this principle">
      Verify on the real artifact, not a proxy.
    </@row>
  </@step>

  <@connector from="locate-trail" to="rebuild-state"/>

  <@connector from="rebuild-state" to="done-versus-pending"/>

  <@connector from="done-versus-pending" to="route"/>

  <@connector from="route" to="verify-inherited"/>
</lane>
