import { pstack } from "../sources";
import type { LaneViewInput } from "../../model/types";
export type Input = LaneViewInput;

<lane ...input id="bug-fix" name="Bug fix" source=pstack>
  <@by><playbook-ref of=pstack name="bug-fix" path="skills/poteto-mode/playbooks/bug-fix.md"/></@by>
  <@summary>
    "You own this task. Plan, review, verify." "Every shipped line traces to runtime evidence… When evidence refutes a hypothesis, revert what it motivated."
  </@summary>
  <@order label="Ends with" lead="Opening a PR">
    Reply: what was broken, root cause, fix, how you verified. "Paste failing-then-passing repro output verbatim."
  </@order>

  <@step id="reproduce" title="Reproduce" phrase="Yourself, on the real surface" group="check">
    <@what>
      Through the control skill, "even when a debug or instrumentation protocol says to ask the user to reproduce". If it will not reproduce: synthesize the trigger, tighten conditions, or instrument until it fires.
    </@what>
    <@actor>Main agent</@actor>
    <@input>A bug report</@input>
    <@output>A repro that fires</@output>
    <@gate>
      Asking the user is allowed only with a stated reason the control surface cannot reach the target
    </@gate>

    <@row kind="playbook" name="Bug fix" path="skills/poteto-mode/playbooks/bug-fix.md"
      by="model, after matching the request to its title">
      The step list this lane is drawn from.
    </@row>
    <@row kind="skill" name="control-ui / control-cli" gloss="cursor-team-kit plugin (not in pstack)"
      by="model; \"the matching control skill\"">
      Drives the real UI or CLI the way a user would.
    </@row>
  </@step>

  <@step id="find-cause" title="Find cause" phrase="Binary-search hypotheses with runtime evidence"
    group="plan">
    <@what>
      Form the candidate hypotheses, then rule them out until one survives. Seed them with a trace of the subsystem and the <skill-ref of=pstack name="why" path="skills/why/SKILL.md"/> skill for regression history. "Each pass, take the split that cuts the most remaining problem space." A long hunt runs under <tool-ref name="/loop"/>.
    </@what>
    <@actor>Main agent; subagents investigate</@actor>
    <@output>One surviving mechanism, confirmed at runtime</@output>
    <@gate>"Confirm the surviving mechanism with runtime evidence before step 3"</@gate>
    <@back>Itself, until one hypothesis survives</@back>

    <@row kind="skill" name="why" path="skills/why/SKILL.md" by="model, named in this step">
      Regression history for the affected code.
    </@row>
    <@row kind="tool" name="/loop" gloss="Cursor built-in command (not in pstack)" by="model">
      Re-runs a prompt on an interval or when a watcher fires.
    </@row>
    <@row kind="agent" name="poteto-agent" path="agents/poteto-agent.md" by="main agent, Task tool">
      Subagent type for any subagent a playbook step spawns. Background, fresh per task.
    </@row>
  </@step>

  <@step id="plan-fix" title="Plan fix" phrase="Architect if it crosses a function" group="plan">
    <@what>"If it crosses a function boundary, <skill-ref of=pstack name="architect" path="skills/architect/SKILL.md"/> first."</@what>
    <@actor>Main agent</@actor>
    <@output>A specific scope for the fix</@output>

    <@row kind="skill" name="architect" path="skills/architect/SKILL.md" by="model, named in this step">
      Designs the shape of a change that crosses a function boundary. It runs <skill-ref of=pstack name="arena" path="skills/arena/SKILL.md"/>.
    </@row>
  </@step>

  <@step id="delegate-fix" title="Delegate fix" phrase="Subagent, specific scope" group="build">
    <@what>
      Implementation goes to a subagent on the configured bug-fix model (default claude-opus-5-5-xhigh-fast). "The smallest change the evidence justifies ships, nothing more."
    </@what>
    <@actor>
      Main agent leads; a <agent-ref of=pstack name="poteto-agent" path="agents/poteto-agent.md"/> subagent writes
    </@actor>
    <@output>A diff the main agent reviews</@output>

    <@row kind="agent" name="poteto-agent" path="agents/poteto-agent.md" by="main agent, Task tool">
      Subagent type for any subagent a playbook step spawns. Background, fresh per task.
    </@row>
    <@row kind="reference" name="worker.md" path="skills/poteto-mode/worker.md"
      by="first line of every agent kickoff">
      Rules every spawned agent reads first: no extra gates, never ask a person, PR format.
    </@row>
    <@row kind="rule" name="pstack-models.mdc" gloss="~/.cursor/rules/pstack-models.mdc"
      by="written by /setup-pstack; read by the model">
      Per-role model lines. Each code playbook reads its own line.
    </@row>
  </@step>

  <@step id="verify" title="Verify" phrase="Original repro passes, same surface" group="check">
    <@what>
      "Inconclusive or wrong-surface is not a pass. Flag it. Unit tests show branch behavior, not bug absence."
    </@what>
    <@actor>Main agent</@actor>
    <@output>Failing-then-passing repro output</@output>
    <@gate>The step 1 repro, re-run on the same surface (prompt text)</@gate>

    <@row kind="skill" name="control-ui / control-cli" gloss="cursor-team-kit plugin (not in pstack)"
      by="model; \"the matching control skill\"">
      Drives the real UI or CLI the way a user would.
    </@row>
  </@step>

  <@step id="order-commits" title="Order commits" phrase="Failing repro first, fix on top" group="ship">
    <@what>
      The failing repro lands before the fix in git history. <skill-ref of=pstack name="tdd" path="skills/tdd/SKILL.md"/> applies when the bug has a cheap local test path; skip it when the test would be expensive or unclear.
    </@what>
    <@actor>Main agent</@actor>
    <@output>Ordered commits</@output>

    <@row kind="skill" name="tdd" path="skills/tdd/SKILL.md" by="model, named in this step">
      Failing-test-first cadence.
    </@row>
    <@row kind="skill" name="principle-sequence-verifiable-units"
      path="skills/principle-sequence-verifiable-units/SKILL.md"
      by="model; the step cites this principle">
      Verify each unit before starting the next.
    </@row>
    <@row kind="binary" name="git" gloss="git CLI" by="model">
      Worktrees, rebase, patch-id, push.
    </@row>
  </@step>

  <@step id="opening-a-pr" title="Opening a PR" phrase="Run the shared PR playbook" group="ship">
    <@what>"Run <playbook-ref of=pstack name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"/>."</@what>
    <@actor>Main agent</@actor>
    <@output>A ready (not draft) PR</@output>
    <@gate>None in code</@gate>
    <@handoff to="opening-a-pr"/>

    <@row kind="playbook" name="Opening a PR" path="skills/poteto-mode/playbooks/opening-a-pr.md"
      by="model; last step of this playbook">
      The shared closing playbook.
    </@row>
  </@step>

  <@connector from="reproduce" to="find-cause"/>

  <@connector from="find-cause" to="plan-fix"/>

  <@connector from="plan-fix" to="delegate-fix"/>

  <@connector from="delegate-fix" to="verify"/>

  <@connector from="verify" to="order-commits"/>

  <@connector from="order-commits" to="opening-a-pr"/>

  <@connector from="find-cause" to="find-cause" label="hypothesis refuted" enforced="prompt">
    <@when>Runtime evidence rules a hypothesis out.</@when>
    <@by>model</@by>
    <@how>
      Eliminate it and take the next split. "When evidence refutes a hypothesis, revert what it motivated." No cap on passes.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Bug fix" path="skills/poteto-mode/playbooks/bug-fix.md"/> intro and step 2
    </@source>
  </@connector>

  <@connector from="verify" to="find-cause" label="repro still fails" inferred enforced="prompt">
    <@when>The original repro does not pass after the fix.</@when>
    <@by>model</@by>
    <@how>
      The playbook says only that inconclusive is not a pass and to flag it. Going back to the cause hunt is our reading.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="Bug fix" path="skills/poteto-mode/playbooks/bug-fix.md"/> step 4
    </@source>
  </@connector>
</lane>
