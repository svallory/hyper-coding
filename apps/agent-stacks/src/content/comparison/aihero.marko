  <@connector from="grill" to="prototype" manual enforced="prompt">
    <@when>
      Taken only when a question from the grill cannot be settled in conversation and needs running code (state, business logic, a UI you have to see). Otherwise the grill goes to To-spec or Implement.
    </@when>
    <@by>human</@by>
