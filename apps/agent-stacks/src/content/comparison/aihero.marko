  <@step id="code-review" title="Code review" phrase="Standards and Spec, reviewed apart" group="check">
    <@what>
      Two fresh subagents review the diff, one against the repo standards, one against the spec. Their reports are never merged or reranked.
    </@what>
    <@starts>
      implement calls it once the work is done; <skill-ref of=aihero name="implement-spec" path="skills/engineering/implement-spec/SKILL.md"/> calls it on the integration branch once all tickets are complete.
      <skill-ref of=aihero name="implement" path="skills/engineering/implement/SKILL.md" line="15"/>
      <skill-ref of=aihero name="implement-spec" path="skills/engineering/implement-spec/SKILL.md" line="38"/>
