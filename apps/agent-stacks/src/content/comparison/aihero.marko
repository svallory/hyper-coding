      <skill-ref of=aihero name="implement" path="skills/engineering/implement/SKILL.md" line="13"/>
      <skill-ref of=aihero name="implement-spec" path="skills/engineering/implement-spec/SKILL.md" line="38"/>
    </@gate>
    <@back>Itself as tickets unblock</@back>

    <@row choice="the human types one of the two commands">
      <@row own kind="skill" name="implement" path="skills/engineering/implement/SKILL.md"
        gloss="one ticket, test-first, by the main agent; commits">
