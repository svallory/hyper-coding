              path="skills/engineering/codebase-design/DEEPENING.md" at="113"
              when="deepening a cluster given its dependencies"
              gloss="dependency categories, seam discipline"/>
            <@row kind="reference" name="DESIGN-IT-TWICE.md"
              path="skills/engineering/codebase-design/DESIGN-IT-TWICE.md" at="114"
              when="exploring alternative interfaces"
              gloss="parallel subagents design the interface several ways"/>
          </@row>
        </@row>
      </@row>
      <@row own kind="skill" name="implement-spec" path="skills/engineering/implement-spec/SKILL.md"
        gloss="orchestrator; implementer and merger subagents briefed inline">
        <@row kind="skill" name="setup-matt-pocock-skills"
          path="skills/engineering/setup-matt-pocock-skills/SKILL.md" at="9"
