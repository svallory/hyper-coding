    </@what>
    <@starts>
      The human types <skill-ref of=aihero name="retro" path="skills/engineering/retro/SKILL.md"/> in the session being reviewed, before clearing it.
      <skill-ref of=aihero name="ask-matt" path="skills/engineering/ask-matt/SKILL.md" line="34,38"/>
      <skill-ref of=aihero name="retro" path="skills/engineering/retro/SKILL.md" line="4"/>
