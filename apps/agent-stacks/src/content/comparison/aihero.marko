      <skill-ref of=aihero name="retro" path="skills/engineering/retro/SKILL.md" line="25"/>
      <file-ref of=aihero name="retro.md" path="docs/engineering/retro.md" line="35"/>
    </@gate>

    <@row own kind="skill" name="retro" path="skills/engineering/retro/SKILL.md"
      gloss="reads the session, proposes changes to the environment">
      <@row kind="skill" name="writing-for-agents"
