    <@actor>Main agent + two subagents</@actor>
    <@input>Diff, spec, repo standards</@input>
    <@output>Chat report with Standards and Spec sections</@output>
    <@gate>None stated; findings are reported</@gate>
    <@back>
      Implement, once, under <skill-ref of=aihero name="implement-spec" path="skills/engineering/implement-spec/SKILL.md"/> only
    </@back>

    <@row own kind="skill" name="code-review" path="skills/engineering/code-review/SKILL.md"
      gloss="two inline subagents: Standards and Spec, reported apart">
      <@row kind="skill" name="setup-matt-pocock-skills"
        path="skills/engineering/setup-matt-pocock-skills/SKILL.md" at="13"
        when="the issue tracker was not provided"
        manual="The skill does not run it: it tells the human to type /setup-matt-pocock-skills."
        gloss="writes the tracker commands, labels and domain rules into docs/agents"/>
    </@row>
  </@step>

  <@step id="pull-request" title="Pull request" phrase="Summary, evidence, merge danger" group="ship">
    <@what>
      Defines the PR body: summary, before/after evidence, and whether the merge can be undone. The skill never pushes or opens a PR, and <skill-ref of=aihero name="implement" path="skills/engineering/implement/SKILL.md"/> ends at a commit. Its place after code review comes from the docs only. How the PR is merged is not stated.
    </@what>
    <@starts>
      No skill calls it: the agent loads it from its description whenever it writes a PR body, or the human types <skill-ref of=aihero name="pr" path="skills/engineering/pr/SKILL.md"/>.
      <skill-ref of=aihero name="pr" path="skills/engineering/pr/SKILL.md" line="3"/>
      <skill-ref of=aihero name="ask-matt" path="skills/engineering/ask-matt/SKILL.md" line="32"/>
