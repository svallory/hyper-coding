        manual="The skill does not run it: it tells the human to type /setup-matt-pocock-skills."
        gloss="writes the tracker commands, labels and domain rules into docs/agents">
        <@row kind="reference" name="seed templates" path="skills/engineering/setup-matt-pocock-skills/"
          at="108-114" count=5
          gloss="tracker commands, labels, domain rules; copied into docs/agents"/>
      </@row>
    </@row>
  </@step>

  <@step id="implement" title="Implement" phrase="Test-first, one ticket or a graph" group="build">
    <@what>
      <skill-ref of=aihero name="implement" path="skills/engineering/implement/SKILL.md"/> builds one ticket test-first and commits. <skill-ref of=aihero name="implement-spec" path="skills/engineering/implement-spec/SKILL.md"/> runs the ticket graph: one implementer per ticket in its own worktree, mergers, an integration branch.
    </@what>
    <@starts>
