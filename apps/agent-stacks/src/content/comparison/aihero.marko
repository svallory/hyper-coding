<lane ...input id="aihero" name="AI Hero skills"
  by="Matt Pocock · any agent (Claude Code, Codex, Copilot, Gemini CLI)" source=aihero>
  <@summary>
    Small skills the human types. No orchestrator, no hooks, and no script runs in any step. A router skill, <skill-ref of=aihero name="ask-matt" path="skills/engineering/ask-matt/SKILL.md"/>, names the next command and stops.
  </@summary>
  <@order label="Order, per the author" lead="recommended in docs, conditional; refuses tools that own the process">
    "<skill-ref of=aihero name="grill-with-docs" path="skills/engineering/grill-with-docs/SKILL.md"/> → <skill-ref of=aihero name="to-spec" path="skills/engineering/to-spec/SKILL.md"/> → <skill-ref of=aihero name="to-tickets" path="skills/engineering/to-tickets/SKILL.md"/> → implement → <skill-ref of=aihero name="code-review" path="skills/engineering/code-review/SKILL.md"/> → <skill-ref of=aihero name="retro" path="skills/engineering/retro/SKILL.md"/>" (docs/engineering/implement.md). Spec and tickets are skipped for single-session work; <skill-ref of=aihero name="retro" path="skills/engineering/retro/SKILL.md"/> is optional after a smooth build; prototype and <skill-ref of=aihero name="pr" path="skills/engineering/pr/SKILL.md"/> sit outside the main flow. A static table of steps would "be wrong for most situations" (docs/engineering/ask-matt.md).
  </@order>
  <@owner from="grill" to="grill" name="grill-with-docs" note="skill"/>
  <@owner from="prototype" to="prototype" name="prototype"
    note="skill; /handoff carries the context out and back"/>
  <@owner from="to-spec" to="to-spec" name="to-spec" note="skill"/>
  <@owner from="to-tickets" to="to-tickets" name="to-tickets" note="skill"/>
  <@owner from="implement" to="implement" name="implement or implement-spec"
    note="one of two skills; the human picks"/>
  <@owner from="code-review" to="code-review" name="code-review"
    note="skill; called by implement or implement-spec"/>
  <@owner from="pull-request" to="pull-request" name="pr"
    note="skill; the agent loads it when writing a PR"/>
  <@owner from="retro" to="retro" name="retro" note="skill"/>
  <@cover col="req" level="explicit">spec issue with user stories; criteria per ticket</@cover>
  <@cover col="base" level="implicit">
    conditional, in <skill-ref of=aihero name="to-spec" path="skills/engineering/to-spec/SKILL.md"/> and <skill-ref of=aihero name="to-tickets" path="skills/engineering/to-tickets/SKILL.md"/>: "If you have not already explored the codebase, do so"
  </@cover>
  <@cover col="design" level="implicit">test seams and an Implementation Decisions section</@cover>
  <@cover col="tasks" level="explicit">
    <skill-ref of=aihero name="to-tickets" path="skills/engineering/to-tickets/SKILL.md"/>, approved by the human
  </@cover>
  <@cover col="verify" level="implicit">Spec axis of one review pass; no acceptance run</@cover>
  <@cover col="learn" level="explicit">
    <skill-ref of=aihero name="retro" path="skills/engineering/retro/SKILL.md"/>; advisory
  </@cover>
  <@take>
    Interview in rounds: all unblocked questions at once, each with a recommended answer.
  </@take>
  <@take>Test seams agreed with the human before any test exists.</@take>
  <@take>Standards review and spec review run apart and are never merged.</@take>
  <@gap>Nothing drives the order; the human types each command.</@gap>
  <@gap>Review is one pass with no stop condition.</@gap>
  <@gap>
    No dedicated current-state step (exploration is conditional), no acceptance check, merge not covered.
  </@gap>

  <@step id="grill" title="Grill" phrase="Relentless interview, glossary, ADRs" group="plan" human>
    <@what>
      The agent interviews the human in rounds: every question that is not blocked is asked together, each with a recommended answer. Facts are fetched by subagents.
    </@what>
    <@starts>
      The human types <skill-ref of=aihero name="grill-with-docs" path="skills/engineering/grill-with-docs/SKILL.md"/> with an idea, inside a repo; the model cannot start it.
      <skill-ref of=aihero name="ask-matt" path="skills/engineering/ask-matt/SKILL.md" line="19"/>
      <skill-ref of=aihero name="grill-with-docs" path="skills/engineering/grill-with-docs/SKILL.md" line="4"/>
    </@starts>
    <@via>
      <skill-ref of=aihero name="grill-with-docs" path="skills/engineering/grill-with-docs/SKILL.md"/> (grilling, <skill-ref of=aihero name="domain-modeling" path="skills/engineering/domain-modeling/SKILL.md"/>)
    </@via>
    <@actor>Human answers; main agent asks</@actor>
    <@input>Loose idea and the repo</@input>
    <@output>Shared understanding in the conversation; GLOSSARY.md; docs/adr/*.md</@output>
    <@gate>
      Human confirms shared understanding; no open questions left
      <skill-ref of=aihero name="grilling" path="skills/productivity/grilling/SKILL.md" line="30"/>
    </@gate>

    <@row own kind="skill" name="grill-with-docs" path="skills/engineering/grill-with-docs/SKILL.md"
      gloss="one line: load the two skills below">
      <@row kind="skill" name="grilling" path="skills/productivity/grilling/SKILL.md" at="7"
        gloss="question rounds; inline subagents look up facts"/>
      <@row kind="skill" name="domain-modeling" path="skills/engineering/domain-modeling/SKILL.md"
        at="7" gloss="challenges terms; writes GLOSSARY.md and ADRs">
        <@row kind="reference" name="GLOSSARY-FORMAT.md"
          path="skills/engineering/domain-modeling/GLOSSARY-FORMAT.md" at="62"
          when="a term is resolved" gloss="entry format and rules"/>
        <@row kind="reference" name="ADR-FORMAT.md"
          path="skills/engineering/domain-modeling/ADR-FORMAT.md" at="68-74"
          when="a decision passes all three ADR tests" gloss="template and numbering"/>
      </@row>
    </@row>
    <@row kind="skill" name="ask-matt" path="skills/engineering/ask-matt/SKILL.md"
      gloss="optional router: names the next command and stops">
      <@row kind="reference" name="PHASE-BOUNDARIES.md"
        path="skills/engineering/ask-matt/PHASE-BOUNDARIES.md" at="79"
        when="the question is what to do between two phases"
        gloss="continue, clear, hand off, subagent or compact"/>
    </@row>
  </@step>

  <@step id="prototype" title="Prototype" phrase="Throwaway code answers one question" group="plan" human>
    <@what>
      A detour to a new session: throwaway code settles a design question that talk cannot.
    </@what>
    <@starts>
      The human types <skill-ref of=aihero name="handoff" path="skills/productivity/handoff/SKILL.md"/>, opens a fresh session on the file it wrote and types <skill-ref of=aihero name="prototype" path="skills/engineering/prototype/SKILL.md"/> there; the model may also start prototype from its description.
      <skill-ref of=aihero name="ask-matt" path="skills/engineering/ask-matt/SKILL.md" line="20-23"/>
      <skill-ref of=aihero name="prototype" path="skills/engineering/prototype/SKILL.md" line="3"/>
    </@starts>
    <@via>
      <skill-ref of=aihero name="handoff" path="skills/productivity/handoff/SKILL.md"/>, <skill-ref of=aihero name="prototype" path="skills/engineering/prototype/SKILL.md"/> (the model can also start it), <skill-ref of=aihero name="handoff" path="skills/productivity/handoff/SKILL.md"/> back
    </@via>
    <@actor>Human and agent in a new session</@actor>
    <@input>An unresolved design question</@input>
    <@output>prototype/&lt;name> branch; verdict in the issue or a commit</@output>
    <@gate>
      The human judges
      <file-ref of=aihero name="LOGIC.md" path="skills/engineering/prototype/LOGIC.md" line="54"/>
      <file-ref of=aihero name="UI.md" path="skills/engineering/prototype/UI.md" line="96"/>
    </@gate>
    <@back>Grill</@back>

    <@row kind="skill" name="handoff" path="skills/productivity/handoff/SKILL.md"
      gloss="summary file for the next session; typed twice"/>
    <@row own kind="skill" name="prototype" path="skills/engineering/prototype/SKILL.md"
      gloss="throwaway code that answers one design question">
      <@row kind="reference" name="LOGIC.md" path="skills/engineering/prototype/LOGIC.md" at="14"
        when="the question is about logic or state"
        gloss="one HTML file that drives the state model"/>
      <@row kind="reference" name="UI.md" path="skills/engineering/prototype/UI.md" at="15"
        when="the question is what it should look like"
        gloss="several layouts on one route, with a switcher"/>
    </@row>
  </@step>

  <@step id="to-spec" title="To-spec" phrase="Conversation becomes a tracker spec" group="plan" human>
    <@what>
