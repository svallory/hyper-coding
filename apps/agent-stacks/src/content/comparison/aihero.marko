      <skill-ref of=aihero name="ask-matt" path="skills/engineering/ask-matt/SKILL.md" line="26-28"/>
    </@starts>
    <@via>
      <skill-ref of=aihero name="implement" path="skills/engineering/implement/SKILL.md"/> or <skill-ref of=aihero name="implement-spec" path="skills/engineering/implement-spec/SKILL.md"/> (<skill-ref of=aihero name="tdd" path="skills/engineering/tdd/SKILL.md"/>, <skill-ref of=aihero name="code-review" path="skills/engineering/code-review/SKILL.md"/>)
    </@via>
    <@actor>Main agent, or an orchestrator with implementer and merger subagents</@actor>
    <@input>Ticket or spec</@input>
    <@output>
      Commits, or an integration branch; a draft PR only if the tracker closes work through PRs or the human asks
    </@output>
    <@gate>
