            at="21" gloss="JSON lines or human text"/>
        </@row>
      </@row>
      <@row kind="reference" name="bugbot-triage.md"
        path="skills/poteto-mode/references/bugbot-triage.md" at="9" when="a review bot commented"
        gloss="check each bot claim against the code"/>
    </@row>
  </@step>

  <@step id="verify-and-land" title="Verify and land" phrase="Non-author verdict, bottom-up merge"
    group="ship" human>
    <@what>
      One fresh agent per PR proves the behaviour live. Verified PRs merge from the bottom of the stack. A verdict covers one patch: git patch-id is compared before trusting it, and a changed patch needs fresh checks unless only tests, docs or lint config changed.
    </@what>
    <@starts>
      The operator asks to land a green stack; <skill-ref of=pstack name="poteto-mode" path="skills/poteto-mode/SKILL.md"/> sends that to Shipping. Babysitting never authorizes a merge.
      <skill-ref of=pstack name="poteto-mode" path="skills/poteto-mode/SKILL.md" line="27"/>
      <playbook-ref of=pstack name="babysit" path="skills/poteto-mode/playbooks/babysit.md" line="10"/>
    </@starts>
    <@via><playbook-ref of=pstack name="shipping" path="skills/poteto-mode/playbooks/shipping.md"/>, <playbook-ref of=pstack name="autopilot"/> playbooks</@via>
    <@actor>Operator says land; verifier subagents; root agent merges</@actor>
    <@input>Merge-ready PRs</@input>
    <@output>PASS, PASS+NOTES or FAIL per PR; merged PRs</@output>
    <@gate>
      "Only a verdict from an agent that did not write the code counts"
      <playbook-ref of=pstack name="shipping" path="skills/poteto-mode/playbooks/shipping.md" line="5"/>
    </@gate>
    <@back>Build on FAIL (our inference; the source says only that new verdicts are needed)</@back>

    <@row own kind="playbook" name="shipping" path="skills/poteto-mode/playbooks/shipping.md"
      gloss="one non-author cloud verifier per PR; bottom-up merge">
      <@row kind="script" name="watch-pr" path="skills/poteto-mode/scripts/watch-pr/watch-pr" at="9"
        gloss="--queued-stack under /loop: reports until COMPLETE">
        <@row kind="script" name="bootstrap.ts" path="skills/poteto-mode/scripts/bootstrap.ts" at="2"
          gloss="installs dependencies once, then restarts"/>
        <@row kind="script" name="cli.ts" path="skills/poteto-mode/scripts/watch-pr/cli.ts" at="5"
          gloss="takes the frozen --stack-prs list">
          <@row kind="script" name="github.ts" path="skills/poteto-mode/scripts/watch-pr/github.ts"
            at="9-13" gloss="gh queries only; merges nothing"/>
          <@row kind="script" name="policy.ts" path="skills/poteto-mode/scripts/watch-pr/policy.ts"
            at="15-20" gloss="frontier poll, whole-stack sweep every 300 s"/>
          <@row kind="script" name="render.ts" path="skills/poteto-mode/scripts/watch-pr/render.ts"
            at="21" gloss="JSON lines or human text"/>
        </@row>
      </@row>
    </@row>
  </@step>

  <@step id="learn-and-encode" title="Learn and encode" phrase="Corrections become checks and rules"
    group="learn" human>
    <@what>
      Turns a repeated mistake into enforcement at the highest level that works: architecture, then types, lint, tests, docs last. Each new check is shown failing on a real past mistake. Separate commands, never a playbook step.
    </@what>
    <@starts>
      The human types <skill-ref of=pstack name="reflect" path="skills/reflect/SKILL.md"/> or <skill-ref of=pstack name="correct" path="skills/correct/SKILL.md"/>. No playbook names either skill.
      <skill-ref of=pstack name="reflect" path="skills/reflect/SKILL.md" line="3-4"/>
      <skill-ref of=pstack name="correct" path="skills/correct/SKILL.md" line="3-4"/>
    </@starts>
    <@via><skill-ref of=pstack name="reflect" path="skills/reflect/SKILL.md"/>, <skill-ref of=pstack name="correct" path="skills/correct/SKILL.md"/> skills</@via>
    <@actor>Main agent proposes; the human runs it and approves</@actor>
    <@input>
      reflect: the session transcript. correct: commits, reverts, review comments, instruction files
    </@input>
    <@output>Lint and CI checks, rule table, skill edits</@output>
    <@gate>
      Human approval before any skill edit
      <skill-ref of=pstack name="reflect" path="skills/reflect/SKILL.md" line="15"/>
    </@gate>

    <@row choice="the command the human types">
      <@row own kind="skill" name="reflect" path="skills/reflect/SKILL.md"
        gloss="transcript lessons become proposed skill edits"/>
      <@row own kind="skill" name="correct" path="skills/correct/SKILL.md"
        gloss="repeated mistakes become architecture, types, lints, tests"/>
    </@row>
  </@step>

  <@connector from="route-and-restate" to="understand-current-state" pick enforced="prompt">
    <@when>The model has matched the request to one playbook title.</@when>
    <@by>model</@by>
    <@how>
      <skill-ref of=pstack name="poteto-mode" path="skills/poteto-mode/SKILL.md"/> ends with a flat list of 22 titles and one rule: "Match the task to a playbook and open its steps at playbooks/&lt;title>.md … Copy its steps into the todolist tool first." There is no trigger table and no code. Large, cross-cutting or unattended work, or a task no playbook fits, goes to the <skill-ref of=pstack name="figure-it-out" path="skills/figure-it-out/SKILL.md"/> skill instead.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <skill-ref of=pstack name="poteto-mode" path="skills/poteto-mode/SKILL.md"/>, section Playbooks
    </@source>
  </@connector>

  <@connector from="understand-current-state" to="design-the-shape" enforced="prompt">
    <@when>
      Bug fix: the mechanism is confirmed with runtime evidence. Feature: the subsystem is traced. Refactoring: a behaviour pin is green.
    </@when>
    <@by>model</@by>
    <@how>
      Each playbook lists this as the step before design. "Type check and lint are not a pin."
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="bug-fix" path="skills/poteto-mode/playbooks/bug-fix.md"/> steps 1-2 · <playbook-ref of=pstack name="feature" path="skills/poteto-mode/playbooks/feature.md"/> step 1 · <file-ref of=pstack name="refactoring.md" path="skills/poteto-mode/playbooks/refactoring.md"/> step 1
    </@source>
  </@connector>

  <@connector from="design-the-shape" to="delegate-build" enforced="prompt">
    <@when>
      A shape is chosen. The <skill-ref of=pstack name="architect" path="skills/architect/SKILL.md"/> skill is required when the change crosses a function boundary; it sends a large or contested design to <skill-ref of=pstack name="arena" path="skills/arena/SKILL.md"/>. A multi-PR plan stops here until the operator says go.
    </@when>
    <@by>model; the operator for a multi-PR plan</@by>
    <@how>
      Feature then runs a four-item throughput checkpoint as todo items: blocking first steps, independent workstreams, shared mutable state, smallest safe decomposition.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="feature" path="skills/poteto-mode/playbooks/feature.md"/> steps 2-3 · <skill-ref of=pstack name="architect" path="skills/architect/SKILL.md"/> · <playbook-ref of=pstack name="multi-phase-plan" path="skills/poteto-mode/playbooks/multi-phase-plan.md"/>
    </@source>
  </@connector>

  <@connector from="delegate-build" to="verify-real-surface" enforced="prompt">
    <@when>The subagent has returned and the lead has reviewed the diff.</@when>
    <@by>model</@by>
    <@how>
      "do not advance until the current one is green". A fix round gets a fresh subagent with the original brief and the prior report.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <skill-ref of=pstack name="principle-sequence-verifiable-units" path="skills/principle-sequence-verifiable-units/SKILL.md"/> · <playbook-ref of=pstack name="feature" path="skills/poteto-mode/playbooks/feature.md"/> step 4
    </@source>
  </@connector>

  <@connector from="verify-real-surface" to="open-pr" enforced="prompt">
    <@when>
      The change is verified on the surface it touches. A contested change goes through <skill-ref of=pstack name="interrogate" path="skills/interrogate/SKILL.md"/> first.
    </@when>
    <@by>model</@by>
    <@how>
      "Inconclusive or wrong-surface is not a pass." Commits are rebased into small ordered ones, then the <playbook-ref of=pstack name="opening-a-pr" path="skills/poteto-mode/playbooks/opening-a-pr.md"/> playbook starts.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="feature" path="skills/poteto-mode/playbooks/feature.md"/> steps 5-8 · <playbook-ref of=pstack name="bug-fix" path="skills/poteto-mode/playbooks/bug-fix.md"/> steps 4-6
    </@source>
  </@connector>

  <@connector from="open-pr" to="babysit" manual enforced="prompt">
    <@when>
      The human asks for PR status or to <playbook-ref of=pstack name="babysit" path="skills/poteto-mode/playbooks/babysit.md"/>.
    </@when>
    <@by>human</@by>
    <@how>
      "Opening a PR does not start a babysit." The mode (drive, threads-only, check) comes from the request.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="opening-a-pr" path="skills/poteto-mode/playbooks/opening-a-pr.md"/> · <playbook-ref of=pstack name="babysit" path="skills/poteto-mode/playbooks/babysit.md"/>
    </@source>
  </@connector>

  <@connector from="babysit" to="verify-and-land" manual enforced="prompt">
    <@when>The operator says to land.</@when>
    <@by>human</@by>
    <@how>
      "Babysitting never authorizes merging." <script-ref of=pstack name="watch-pr" path="skills/poteto-mode/scripts/watch-pr/watch-pr"/> exiting 0 (ready) only reports: it does not require an approval and merges nothing.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="babysit" path="skills/poteto-mode/playbooks/babysit.md"/> · <playbook-ref of=pstack name="shipping" path="skills/poteto-mode/playbooks/shipping.md"/> · <file-ref of=pstack name="watch-pr/" path="skills/poteto-mode/scripts/watch-pr/"/>
    </@source>
  </@connector>

  <@connector from="verify-and-land" to="learn-and-encode" manual enforced="prompt">
    <@when>
      The human runs <skill-ref of=pstack name="reflect" path="skills/reflect/SKILL.md"/> or <skill-ref of=pstack name="correct" path="skills/correct/SKILL.md"/>. No playbook step leads here.
    </@when>
    <@by>human</@by>
    <@how>
      Both are separate commands and no playbook names them. The disable-model-invocation flag is not what keeps them out: 57 of the 58 skills carry it, and playbooks reach those by file path.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <skill-ref of=pstack name="reflect" path="skills/reflect/SKILL.md"/> · <skill-ref of=pstack name="correct" path="skills/correct/SKILL.md"/>
    </@source>
  </@connector>

  <@connector from="understand-current-state" to="understand-current-state" label="hypothesis refuted"
    enforced="prompt">
    <@when>Evidence refutes the current hypothesis.</@when>
    <@by>model</@by>
    <@how>
      "When evidence refutes a hypothesis, revert what it motivated." Then the next hypothesis.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="bug-fix" path="skills/poteto-mode/playbooks/bug-fix.md"/>
    </@source>
  </@connector>

  <@connector from="verify-real-surface" to="delegate-build" label="check fails" inferred enforced="prompt">
    <@when>A check fails.</@when>
    <@by>model</@by>
    <@how>
      Our inference. The playbooks say a failed or inconclusive check is not a pass; none names the route back.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="feature" path="skills/poteto-mode/playbooks/feature.md"/> step 5
    </@source>
  </@connector>

  <@connector from="babysit" to="delegate-build" label="CI or review finding" inferred enforced="prompt">
    <@when>CI fails or a review thread holds a real finding.</@when>
    <@by>model</@by>
    <@how>
      Our inference. Babysit fixes in place and pushes each wave before replying; it never says a fix returns to a build step.
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="babysit" path="skills/poteto-mode/playbooks/babysit.md"/>
    </@source>
  </@connector>

  <@connector from="verify-and-land" to="delegate-build" label="verifier FAIL" inferred enforced="prompt">
    <@when>A verifier posts FAIL.</@when>
    <@by>model</@by>
    <@how>
      Our inference. Shipping says only that a changed patch needs a fresh verdict (git patch-id is compared).
    </@how>
    <@bound>none stated</@bound>
    <@source>
      <playbook-ref of=pstack name="shipping" path="skills/poteto-mode/playbooks/shipping.md"/>
    </@source>
  </@connector>

  <@connector from="learn-and-encode" to="route-and-restate" label="new checks and edited skills" inferred
    outer enforced="prompt">
    <@when>A later session loads the edited skills and the new checks run in CI.</@when>
    <@by>human approves each skill edit</@by>
    <@how>Our inference from what reflect and correct produce.</@how>
    <@bound>none stated</@bound>
    <@source>
      <skill-ref of=pstack name="reflect" path="skills/reflect/SKILL.md"/>
    </@source>
  </@connector>
</lane>
