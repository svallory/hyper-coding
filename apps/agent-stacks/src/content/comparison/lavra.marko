  <@connector from="review-goal-verify" to="execute-beads" label="fix, max 3 (prompt only)" enforced="prompt">
    <@when>Review or goal verification fails.</@when>
    <@by>model</@by>
    <@how>
      The bead goes back to implementation. The limit is prompt text and differs by path: <skill-ref of=lavra name="lavra-work-single" path="plugins/lavra/skills/lavra-work-single/SKILL.md"/> allows 3 rounds; <skill-ref of=lavra name="lavra-work-multi" path="plugins/lavra/skills/lavra-work-multi/SKILL.md"/> allows 3 test-fix iterations, its subagents 3 self-review rounds, and it closes a bead reopened twice as wont_fix; the sequential route reviews once, after the last bead; <skill-ref of=lavra name="lavra-review" path="plugins/lavra/skills/lavra-review/SKILL.md"/> states none. No code counts rounds.
    </@how>
    <@bound>3 rounds; counted differently on each path</@bound>
    <@source>
      <skill-ref of=lavra name="lavra-work-single" path="plugins/lavra/skills/lavra-work-single/SKILL.md" line="390"/> · <skill-ref of=lavra name="lavra-work-multi" path="plugins/lavra/skills/lavra-work-multi/SKILL.md" line="485,501"/> · <agent-ref of=lavra name="subagent-prompt.md" path="plugins/lavra/skills/lavra-work-multi/references/subagent-prompt.md" line="94"/> · <skill-ref of=lavra name="lavra-work" path="plugins/lavra/skills/lavra-work/SKILL.md" line="128-165"/>
