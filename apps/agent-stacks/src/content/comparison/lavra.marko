      <@row own kind="skill" name="lavra-work" path="plugins/lavra/skills/lavra-work/SKILL.md"
        gloss="sequential route: one review after the last bead">
        <@row kind="skill" name="lavra-work-single"
          path="plugins/lavra/skills/lavra-work-single/SKILL.md" at="131-134"
          gloss="per bead: self-review and goal check only">
