    </@what>
    <@starts>
      The human types <command-ref of=lavra name="lavra-ship" path="plugins/lavra/commands/lavra-ship.md"/>; the sequential work summary names it as the next step.
      <file-ref of=lavra name="README.md" path="README.md" line="72-76"/>
      <skill-ref of=lavra name="lavra-work" path="plugins/lavra/skills/lavra-work/SKILL.md" line="192"/>
    </@starts>
    <@via>
      <command-ref of=lavra name="lavra-ship" path="plugins/lavra/commands/lavra-ship.md"/>
    </@via>
    <@actor>Main agent</@actor>
    <@input>Feature branch</@input>
    <@output>PR; closed beads; beads backup</@output>
    <@gate>
      Tests pass; no CRITICAL finding; at least one knowledge comment before a bead closes
      <command-ref of=lavra name="lavra-ship" path="plugins/lavra/commands/lavra-ship.md" line="112,135-138,162,234-244"/>
    </@gate>
    <@back>Itself after the user fixes a halt</@back>

    <@row own kind="command" name="lavra-ship" path="plugins/lavra/commands/lavra-ship.md"
      gloss="tests, secret scan, PR, closes beads via bd">
      <@row kind="agent" name="goal-verifier" path="plugins/lavra/agents/review/goal-verifier.md"
