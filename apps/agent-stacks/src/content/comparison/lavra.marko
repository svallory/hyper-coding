  <@step id="browser-qa" title="Browser QA" phrase="Optional browser test of changed routes"
    group="check" human>
    <@what>Drives the changed routes in a browser. Web apps only.</@what>
    <@starts>
      The human types <command-ref of=lavra name="lavra-qa" path="plugins/lavra/commands/lavra-qa.md"/> between work and ship, when the change has a web UI.
      <file-ref of=lavra name="README.md" path="README.md" line="78"/>
    </@starts>
    <@via>
      <command-ref of=lavra name="lavra-qa" path="plugins/lavra/commands/lavra-qa.md"/>, using the agent-browser CLI
    </@via>
    <@actor>Main agent with the human</@actor>
    <@input>Diff or bead</@input>
    <@output>PASS, WARN or FAIL per route; screenshots</@output>
    <@gate>
      Per failure the human picks Fix now, Create bead or Skip
      <command-ref of=lavra name="lavra-qa" path="plugins/lavra/commands/lavra-qa.md" line="251-260"/>
    </@gate>
    <@back>Itself: on Fix now, QA fixes the problem and re-tests the route</@back>

    <@row own kind="command" name="lavra-qa" path="plugins/lavra/commands/lavra-qa.md"
      gloss="changed files to routes; drives the agent-browser CLI"/>
