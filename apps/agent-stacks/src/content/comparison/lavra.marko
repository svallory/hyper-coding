        gloss="exists or substantive failure halts the ship"/>
    </@row>
  </@step>

  <@step id="knowledge-capture" title="Knowledge capture" phrase="Hooks log and recall typed knowledge"
    group="learn">
    <@what>
      Hooks copy typed comments into a git-tracked memory file and recall the 10 best-matching entries at session start. The lavra-knowledge skill that describes capture is loaded by no command: its own text says /lavra-work and <skill-ref of=lavra name="lavra-review" path="plugins/lavra/skills/lavra-review/SKILL.md"/> call it, and neither does. It also disagrees with the hook it describes: the skill rotates the file at 1000 lines, <script-ref of=lavra name="memory-capture.sh" path="plugins/lavra/hooks/memory-capture.sh"/> at 5000. If the skill does run, it appends the entry itself and then adds the bead comment that makes the hook append it again; nothing removes the duplicate (read from the code, not run).
    </@what>
    <@starts>
      Nothing invokes it: the harness fires the four events in hooks.json during every other step. <command-ref of=lavra name="lavra-learn" path="plugins/lavra/commands/lavra-learn.md"/> and <command-ref of=lavra name="lavra-retro" path="plugins/lavra/commands/lavra-retro.md"/> are typed by the human.
      <file-ref of=lavra name="hooks.json" path="plugins/lavra/hooks/hooks.json" line="3,14,26,36"/>
    </@starts>
    <@via>
      Hooks <script-ref of=lavra name="auto-recall.sh" path="plugins/lavra/hooks/auto-recall.sh"/>, <script-ref of=lavra name="memory-capture.sh" path="plugins/lavra/hooks/memory-capture.sh"/>, <script-ref of=lavra name="subagent-wrapup.sh" path="plugins/lavra/hooks/subagent-wrapup.sh"/>; <command-ref of=lavra name="lavra-learn" path="plugins/lavra/commands/lavra-learn.md"/>, <command-ref of=lavra name="lavra-retro" path="plugins/lavra/commands/lavra-retro.md"/>
    </@via>
    <@actor>Hooks and agents</@actor>
    <@input>Bead comments</@input>
    <@output>.lavra/memory/knowledge.jsonl</@output>
    <@gate>
      <script-ref of=lavra name="subagent-wrapup.sh" path="plugins/lavra/hooks/subagent-wrapup.sh"/> blocks a subagent from stopping whenever its transcript has a BEAD_ID line; it has no ask-once guard and never checks that a comment was logged, although docs/hooks.md says it does. <script-ref of=lavra name="teammate-idle-check.sh" path="plugins/lavra/hooks/teammate-idle-check.sh"/> blocks a teammate from stopping while bd ready lists work. These two hooks are the only code in Lavra that blocks anything
      <script-ref of=lavra name="subagent-wrapup.sh" path="plugins/lavra/hooks/subagent-wrapup.sh" line="14-27"/>
      <script-ref of=lavra name="teammate-idle-check.sh" path="plugins/lavra/hooks/teammate-idle-check.sh" line="16-22"/>
    </@gate>

    <@row own kind="hook" name="PostToolUse" path="plugins/lavra/hooks/hooks.json"
      gloss="async, after every Bash call">
      <@row kind="script" name="memory-capture.sh" path="plugins/lavra/hooks/memory-capture.sh" at="20"
        gloss="a prefixed bd comment becomes a knowledge.jsonl entry">
        <@row kind="script" name="knowledge-db.sh" path="plugins/lavra/hooks/knowledge-db.sh"
          at="136-137" gloss="same entry into the SQLite index"/>
        <@row kind="script" name="memory-sanitize.sh" path="plugins/lavra/hooks/memory-sanitize.sh"
          at="164-165" gloss="background pass: rebuilds the curated active copy">
          <@row kind="binary" name="memorysanitize" path="plugins/lavra/hooks/memorysanitize/main.go"
            at="17,118" word="GO_HELPER_DIR" when="Go is installed; otherwise a jq fallback"
            gloss="dedupes, drops noise, checks file anchors"/>
        </@row>
      </@row>
    </@row>
    <@row own kind="hook" name="SessionStart" path="plugins/lavra/hooks/hooks.json"
      gloss="async, when a session opens">
      <@row kind="script" name="auto-recall.sh" path="plugins/lavra/hooks/auto-recall.sh" at="8"
        gloss="injects entries matching open beads and branch">
        <@row kind="script" name="provision-memory.sh" path="plugins/lavra/hooks/provision-memory.sh"
          at="45,73" when=".lavra/memory is missing or from an older version"
          gloss="creates .lavra/, installs recall.sh there"/>
        <@row kind="script" name="knowledge-db.sh" path="plugins/lavra/hooks/knowledge-db.sh"
          at="153-154" gloss="syncs the index, full-text search"/>
      </@row>
    </@row>
    <@row own kind="hook" name="SubagentStop" path="plugins/lavra/hooks/hooks.json"
      gloss="when any subagent tries to stop">
      <@row kind="script" name="subagent-wrapup.sh" path="plugins/lavra/hooks/subagent-wrapup.sh"
        at="31" gloss="blocks if the transcript has a BEAD_ID line"/>
    </@row>
    <@row own kind="hook" name="TeammateIdle" path="plugins/lavra/hooks/hooks.json"
      gloss="when a teammate tries to go idle">
      <@row kind="script" name="teammate-idle-check.sh"
        path="plugins/lavra/hooks/teammate-idle-check.sh" at="41"
        gloss="blocks while bd ready lists work"/>
    </@row>
    <@row kind="command" name="lavra-learn" path="plugins/lavra/commands/lavra-learn.md"
      manual="The human types /lavra-learn." gloss="raw comments become tagged entries">
      <@row kind="script" name="recall.sh" path="plugins/lavra/hooks/recall.sh" at="82"
        gloss="existing entries, to deduplicate against"/>
    </@row>
    <@row kind="command" name="lavra-retro" path="plugins/lavra/commands/lavra-retro.md"
      manual="The human types /lavra-retro." gloss="weekly report, adds PATTERN entries"/>
  </@step>

