export interface Input {
  /** Unique on the page: it names the radio group and builds the ids. */
  name: string;
  tab: Marko.AttrTag<{ label: string; content?: Marko.Body }>;
}

<const/tabs=[...input.tab]/>
<div class="panel-tabs">
  <for|tab, i| of=tabs>
    <input class="tab-radio" type="radio" name=`${input.name}:tab` id=`${input.name}:tab:${i}`
      data-tab=tab.label.toLowerCase() data-i=i checked=i === 0>
    <label class="tab-label" for=`${input.name}:tab:${i}`>${tab.label}</label>
  </for>
  <for|tab, i| of=tabs>
    <div class="tab-pane" data-pane=i><${tab.content}/></div>
  </for>
</div>

<style>
  .panel-tabs {
    display: flex;
    flex-wrap: wrap;
    column-gap: 1.25rem;
    margin: 0.25rem 0 1rem;
  }
  .tab-radio {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  /* Word tabs on one rule; the chosen one is underlined in ink. */
  .tab-label {
    margin: 0 0 -1px;
    padding: 0.375rem 0;
    border-bottom: 2px solid transparent;
    color: var(--muted);
    font-stretch: var(--cond);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    cursor: pointer;
  }
  .tab-label:hover {
    color: var(--fg);
  }
  .tab-radio:checked + .tab-label {
    color: var(--fg);
    border-bottom-color: var(--fg);
  }
  .tab-radio:focus-visible + .tab-label {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .tab-pane {
    display: none;
    flex-basis: 100%;
    order: 2;
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }
  .panel-tabs:has(> .tab-radio[data-i="0"]:checked) > .tab-pane[data-pane="0"],
  .panel-tabs:has(> .tab-radio[data-i="1"]:checked) > .tab-pane[data-pane="1"],
  .panel-tabs:has(> .tab-radio[data-i="2"]:checked) > .tab-pane[data-pane="2"] {
    display: block;
  }
</style>
