import type { Lane, Step } from "../../model/types";

export interface Input {
  lane: Lane;
  step: Step;
}

static const LABELS = {
  what: "What",
  via: "Via",
  actor: "Actor",
  input: "Input",
  output: "Output",
  starts: "Starts",
  gate: "Gate",
  back: "Back",
} as const;
static const ORDER = ["what", "via", "actor", "input", "output", "starts", "gate", "back"] as const;

<const/lane=input.lane/>
<const/step=input.step/>
<const/id=`${lane.id}/${step.id}`/>
<const/position=lane.steps.findIndex((s) => s.id === step.id) + 1/>
<section class="panel" id=id data-panel="step" data-group=step.group aria-label=step.title>
  <header class="panel-head">
    <h3 class="panel-title">${step.title}</h3>
    <p class="panel-sub">${lane.name}, step ${position} of ${lane.steps.length}, ${step.group}<if=step.human>. A human decides here.</if></p>
    <p class="panel-phrase">${step.phrase}</p>
  </header>
  <panel-tabs name=id>
    <@tab label="Step">
      <dl class="panel-fields">
        <for|name| of=ORDER>
          <if=step.fields[name]>
            <panel-field label=LABELS[name]><${step.fields[name]}/></panel-field>
          </if>
        </for>
        <if=step.handoffs.length>
          <panel-field label="Hands off to">
            <for|to, i| of=step.handoffs>
              <if=i>, </if>
              <a data-handoff=to href=`#${to}`>${to}</a>
            </for>
          </panel-field>
        </if>
      </dl>
      <if=step.warning>
        <callout title=step.warning.title><${step.warning.content}/></callout>
      </if>
    </@tab>
    <@tab label="Anatomy">
      <anatomy-tree rows=step.rows of=lane.source/>
    </@tab>
  </panel-tabs>
</section>

<style>
  .panel-head {
    margin-bottom: 0.5rem;
  }
  .panel-title {
    margin: 0;
    font-size: 1.625rem;
    line-height: 1.08;
  }
  .panel-sub {
    margin: 0.125rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .panel-phrase {
    margin: 0 0 0.875rem;
    font-size: 0.9375rem;
  }
  .panel-fields {
    margin: 0;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.35rem 0.875rem;
  }
</style>
