import type { Lane, Step } from "../../model/types";

export interface Input {
  lane: Lane;
  step: Step;
}

static const LABELS = {
  via: "Runs via",
  actor: "Who",
  input: "Input",
  output: "Output",
  starts: "Starts",
  gate: "Gate",
  back: "Loops back",
} as const;
// v13's order. A step with a "starts" line is a flow step: v13 leaves Via out there, so it follows Who.
static const ORDER = ["starts", "actor", "via", "input", "output", "gate", "back"] as const;
static const PLAIN = ["via", "actor", "input", "output", "gate", "back"] as const;
static const ENFORCED = {
  code: "code: a program checks it",
  harness: "the harness",
  prompt: "prompt text only; nothing checks",
} as const;

<const/lane=input.lane/>
<const/step=input.step/>
<const/id=`${lane.id}/${step.id}`/>
<const/leaves=lane.connectors.filter((c) => lane.steps[c.from] === step)/>
<const/position=lane.steps.findIndex((s) => s.id === step.id) + 1/>
<section class="panel" id=id data-panel="step" data-group=step.group aria-label=step.title>
  <header class="panel-head">
    <h3 class="panel-title">${step.title}</h3>
    <p class="panel-sub">${lane.name}, step ${position} of ${lane.steps.length}, ${step.group}<if=step.human>. A human decides here.</if></p>
  </header>
  <panel-tabs name=id>
    <@tab label="Step">
      <if=step.fields.what><p class="panel-what"><${step.fields.what}/></p></if>
      <if=step.warning>
        <callout title=step.warning.title><${step.warning.content}/></callout>
      </if>
      <dl class="panel-fields">
        <for|name| of=(step.fields.starts ? ORDER : PLAIN)>
          <if=step.fields[name]>
            <panel-field label=LABELS[name]><${step.fields[name]}/></panel-field>
          </if>
        </for>
        <if=step.handoffs.length>
          <panel-field label="Hands off to">
            <for|to, i| of=step.handoffs>
              <if=i>, </if>
              <a data-handoff=to href=`#${to}`>${to}</a>
            </for>
          </panel-field>
        </if>
      </dl>
      <if=leaves.length>
        <h4 class="panel-h">Leaves to</h4>
        <ul class="leaves" data-leaves>
          <for|c| of=leaves>
            <li class="leave">
              <b>${c.from === c.to ? "itself" : lane.steps[c.to].title}<if=c.label> · ${c.label}</if></b>
              <if=c.details.when>: <${c.details.when}/></if>
              <if=c.manual><span class="by"> Manual: the operator has to start it.</span></if>
              <if=c.details.by>
                <span class="by"> Decided by <${c.details.by}/><if=c.enforced>; enforced by ${ENFORCED[c.enforced]}</if>.</span>
              </if>
            </li>
          </for>
        </ul>
      </if>
    </@tab>
    <@tab label="Anatomy">
      <anatomy-tree rows=step.rows of=lane.source/>
    </@tab>
  </panel-tabs>
</section>

<style>
  .panel-head {
    margin-bottom: 0.5rem;
  }
  .panel-title {
    margin: 0;
    font-size: 1.625rem;
    line-height: 1.08;
  }
  .panel-sub {
    margin: 0.125rem 0 0.75rem;
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .panel-what {
    margin: 0 0 0.75rem;
    font-size: 0.9375rem;
  }
  .panel-h {
    margin: 1rem 0 0.375rem;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  .leaves {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
  }
  .leave .by {
    color: var(--muted);
  }
  .panel-fields {
    margin: 0;
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: 0.35rem 0.875rem;
  }
</style>
