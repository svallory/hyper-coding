  <dt class="field-label">${input.label}</dt>
  <dd class="field-body"><${input.content}/></dd>
</div>

<style>
  .panel-field {
    display: contents;
  }
  .field-label {
    color: var(--muted);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .field-body {
    margin: 0;
    overflow-wrap: anywhere;
  }
</style>
