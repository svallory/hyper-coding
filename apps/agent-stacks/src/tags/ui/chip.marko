export interface Input {
  content?: Marko.Body;
  /** An optional kind of chip, written as a data attribute for styling and tests. */
  tone?: "manual" | "when";
}

<span class="chip" data-chip=input.tone><${input.content}/></span>

<style>
  .chip {
    display: inline-block;
    padding: 0 0.45rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--sunk);
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.5;
    white-space: nowrap;
  }
  .chip[data-chip="manual"] {
    border-color: var(--when-bg);
    color: var(--fg);
  }
</style>
