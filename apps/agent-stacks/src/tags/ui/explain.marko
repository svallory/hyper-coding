export interface Input {
  /** The text on hover and the label for assistive technology. */
  title: string;
  content?: Marko.Body;
}

<id/uid/>
<span/wrap class="explain">
  <button/button class="explain-trigger" type="button" popovertarget=`${uid}-pop`
    aria-label=input.title title=input.title style=`anchor-name: --${uid}`>
    <ui-icon id="help"/>
  </button>
  <div/pop id=`${uid}-pop` class="explain-pop" popover style=`position-anchor: --${uid}`>
    <${input.content}/>
  </div>
</span>

<script>
  // Hover opens it for a real mouse only; a tap or a click opens and keeps it through the native popover.
  let byHover = false;
  wrap().addEventListener("pointerenter", (e) => {
    if ((e as PointerEvent).pointerType !== "mouse" || pop().matches(":popover-open")) return;
    pop().showPopover();
    byHover = true;
  });
  wrap().addEventListener("pointerleave", (e) => {
    if ((e as PointerEvent).pointerType !== "mouse") return;
    if (byHover && pop().matches(":popover-open")) pop().hidePopover();
    byHover = false;
  });
  // A click after hovering pins the popover open instead of toggling it closed.
  button().addEventListener("click", (e) => {
    if (!byHover) return;
    e.preventDefault();
    byHover = false;
  });
  pop().addEventListener("toggle", (e) => {
    if ((e as ToggleEvent).newState === "closed") byHover = false;
  });
</script>

<style>
  .explain {
    display: inline-block;
  }
  .explain-trigger {
    display: inline-flex;
    padding: 0;
    border: 0;
    background: none;
    color: var(--muted);
    cursor: help;
    font: inherit;
  }
  .explain-trigger:hover,
  .explain-trigger:focus-visible {
    color: var(--fg);
  }
  /* Bridges the gap to the trigger, so the pointer stays over the popover on its way in. */
  .explain-pop::before {
    content: "";
    position: absolute;
    inset: -0.5rem 0 auto 0;
    height: 0.5rem;
  }
  .explain-pop {
    position: fixed;
    inset: auto;
    top: calc(anchor(bottom) + 0.4rem);
    left: anchor(left);
    margin: 0;
    max-width: min(22rem, calc(100vw - 32px));
    padding: 0.5rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: var(--surface);
    color: var(--fg);
    font-size: 0.875rem;
    position-try-fallbacks: flip-block, flip-inline;
  }
</style>
