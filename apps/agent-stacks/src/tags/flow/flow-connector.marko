import { BAND_BASE, BAND_LANE, SLOT_FIRST, SLOT_STEP } from "../../model/layout";
import type { Connector, Lane } from "../../model/types";

export interface Input {
  lane: Lane;
  /** A connector after `layoutLane`: its shape, lane and slots are filled. */
  connector: Connector;
}

/** A self loop is this wide, centred on its step. */
<const/LOOP_HALF=16/>
<const/lane=input.lane/>
<const/c=input.connector/>
<const/from=lane.steps[c.from]/>
<const/to=lane.steps[c.to]/>
<const/ends=`${from.id}~${to.id}`/>
<const/linked=(Object.keys(c.details).length > 0)/>
<const/href=linked ? `#${lane.id}/${ends}` : undefined/>
<const/tag=linked ? "a" : "div"/>
<const/lo=Math.min(c.from, c.to)/>
<const/hi=Math.max(c.from, c.to)/>
<const/span=hi - lo + 1/>
<const/above=c.shape === "above"/>
<const/loSlot=c.from < c.to ? c.slotFrom : c.slotTo/>
<const/hiSlot=c.from < c.to ? c.slotTo : c.slotFrom/>
<const/place=(
  c.shape === "adjacent"
    ? `grid-row: 3; grid-column: ${c.from + 1} / ${c.from + 3}`
    : c.shape === "self"
      ? `grid-row: 4; grid-column: ${c.from + 1}; margin: 2px calc(50% - ${LOOP_HALF}px) 0; height: ${BAND_BASE - 2 + c.lane * BAND_LANE}px`
      : `grid-row: ${above ? 2 : 4}; grid-column: ${lo + 1} / ${hi + 2}; margin: ${above ? "0 " : "2px "}calc(50% / ${span} + ${SLOT_FIRST + SLOT_STEP * hiSlot}px) ${above ? "2px" : "0"} calc(50% / ${span} + ${SLOT_FIRST + SLOT_STEP * loSlot}px); height: ${BAND_BASE - 2 + c.lane * BAND_LANE}px`
)/>
<const/label=c.label ?? ""/>
<const/name=`${from.title} to ${to.title}`/>
<div class="conn" data-shape=c.shape data-toward=(c.to > c.from ? "right" : "left") style=place>
  <if=c.shape === "adjacent">
    <${tag} class="conn-edge" data-connector=ends data-manual=c.manual data-inferred=c.inferred
      data-outer=c.outer href=href aria-label=`${name}${c.label ? `: ${c.label}` : ""}`>
      <if=c.label><span class="conn-label">${c.label}</span></if>
    </>
    <if=c.pick><span class="conn-pick" title="The model picks one of several" aria-hidden="true"/></if>
    <if=c.manual>
      <span class="conn-extra">
        <span class="conn-man" data-manual-marker aria-hidden="true"><ui-icon id="manual"/></span>
        <explain title="Manual: a person triggers this">
          <if=c.details.when><${c.details.when}/></if>
          <else>A person triggers this step by hand.</else>
        </explain>
      </span>
    </if>
  </if>
  <else>
    <span class="conn-path" aria-hidden="true"/>
    <if=linked>
      <a class="conn-hit" data-side="left" href=href tabindex="-1" aria-hidden="true"/>
      <a class="conn-hit" data-side="top" href=href tabindex="-1" aria-hidden="true"/>
      <a class="conn-hit" data-side="right" href=href tabindex="-1" aria-hidden="true"/>
    </if>
    <span class="conn-mid">
      <if=c.manual><span class="conn-man" data-manual-marker aria-hidden="true"><ui-icon id="manual"/></span></if>
      <if=c.pick><span class="conn-pick" title="The model picks one of several" aria-hidden="true"/></if>
      <${tag} class="conn-label" data-connector=ends data-manual=c.manual data-inferred=c.inferred
        data-outer=c.outer href=href aria-label=name>${c.manual ? (label ? `manual: ${label}` : "manual") : label}</>
      <if=c.manual>
        <explain title="Manual: a person triggers this">
          <if=c.details.when><${c.details.when}/></if>
          <else>A person triggers this step by hand.</else>
        </explain>
      </if>
    </span>
  </else>
</div>

<style>
  .conn {
    --c: var(--edge);
    position: relative;
    z-index: 1;
    pointer-events: none;
  }
  .conn:has([data-manual]) { --c: var(--when-bg); }
  .conn:has([data-outer]) { --c: var(--accent); }

  /* ---- Next step: a short line with an arrowhead, in the gap between two nodes. ---- */
  .conn[data-shape="adjacent"] {
    align-self: center;
    justify-self: center;
    width: 26px;
    height: 3.5rem;
    z-index: 3;
  }
  .conn-edge {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: auto;
    text-decoration: none;
  }
  .conn-edge::before {
    content: "";
    position: absolute;
    top: 50%;
    left: 0;
    right: 5px;
    border-top: 2px solid var(--c);
  }
  .conn-edge::after {
    content: "";
    position: absolute;
    top: calc(50% - 4px);
    right: 0;
    border-left: 7px solid var(--c);
    border-top: 5px solid transparent;
    border-bottom: 5px solid transparent;
    margin-top: -1px;
  }
  .conn:has([data-inferred]) .conn-edge::before { border-top-style: dashed; }
  .conn[data-shape="adjacent"] .conn-label {
    position: absolute;
    top: calc(50% + 0.6rem);
    left: 50%;
    transform: translateX(-50%);
  }
  .conn[data-shape="adjacent"] .conn-pick {
    position: absolute;
    top: calc(50% - 5px);
    left: calc(50% - 6px);
  }
  .conn-extra {
    position: absolute;
    top: 0;
    left: 50%;
    bottom: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: space-between;
    transform: translateX(-50%);
    pointer-events: auto;
  }
  .conn-extra .explain { margin-top: auto; }

  /* ---- A skip or a back edge: a box whose top (or bottom) border is the line, its sides the legs. ---- */
  .conn-path {
    position: absolute;
    inset: 0;
    border: 0 solid var(--c);
    border-width: 2px 2px 0;
    border-radius: 8px 8px 0 0;
  }
  .conn[data-shape="below"] .conn-path,
  .conn[data-shape="self"] .conn-path {
    border-width: 0 2px 2px;
    border-radius: 0 0 8px 8px;
  }
  .conn:has([data-inferred]) .conn-path { border-style: dashed; }
  .conn:has([data-outer]) .conn-path { border-width: 0 3px 3px; }
  /* The arrowhead sits on the leg that arrives at the step. */
  .conn-path::after {
    content: "";
    position: absolute;
    border: 4px solid transparent;
  }
  .conn[data-shape="above"] .conn-path::after {
    bottom: -1px;
    right: -5px;
    border-top: 8px solid var(--c);
    border-bottom: 0;
  }
  .conn[data-shape="below"] .conn-path::after,
  .conn[data-shape="self"] .conn-path::after {
    top: -1px;
    border-bottom: 8px solid var(--c);
    border-top: 0;
  }
  .conn[data-shape="below"][data-toward="right"] .conn-path::after { right: -5px; }
  .conn[data-shape="below"][data-toward="left"] .conn-path::after,
  .conn[data-shape="self"] .conn-path::after { left: -5px; }
  .conn[data-shape="above"][data-toward="left"] .conn-path::after { right: auto; left: -5px; }

  /* Only the label and three thin strips take the pointer, so nested arcs stay reachable. */
  .conn-hit {
    position: absolute;
    pointer-events: auto;
  }
  .conn-hit[data-side="left"] { top: 0; bottom: 0; left: -6px; width: 12px; }
  .conn-hit[data-side="right"] { top: 0; bottom: 0; right: -6px; width: 12px; }
  .conn-hit[data-side="top"] { left: 0; right: 0; top: -6px; height: 12px; }
  .conn[data-shape="below"] .conn-hit[data-side="top"],
  .conn[data-shape="self"] .conn-hit[data-side="top"] { top: auto; bottom: -6px; }

  .conn-mid {
    position: absolute;
    top: 0;
    left: 50%;
    display: flex;
    align-items: center;
    gap: 0.25rem;
    transform: translate(-50%, -50%);
    white-space: nowrap;
  }
  .conn[data-shape="below"] .conn-mid { top: 100%; }
  .conn[data-shape="self"] .conn-mid { top: calc(100% + 0.7rem); }
  .conn-label {
    padding: 0 0.35rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--surface);
    color: var(--fg);
    font-size: 0.6875rem;
    line-height: 1.35;
    text-decoration: none;
    pointer-events: auto;
  }
  /* A connector without a label gets a small dot to point at, and no invented words. */
  .conn-label:empty {
    width: 0.8rem;
    height: 0.8rem;
    padding: 0;
  }
  .conn[data-shape="above"] { align-self: end; }
  .conn:has([data-inferred]) .conn-label { font-style: italic; border-style: dashed; }
  .conn:has([data-outer]) .conn-label { border-color: var(--accent); }
  .conn:has([data-manual]) .conn-label { border-color: var(--when-bg); }
  a.conn-label:hover,
  .conn-edge:hover .conn-label { border-color: var(--fg); }
  .conn-mid .explain { pointer-events: auto; }

  /* ---- Markers ---- */
  .conn-man {
    display: inline-grid;
    place-items: center;
    width: 1.1rem;
    height: 1.1rem;
    border-radius: 999px;
    background: var(--when-bg);
    color: var(--when-fg);
    font-size: 0.75rem;
  }
  .conn-pick {
    display: inline-block;
    width: 0.65rem;
    height: 0.65rem;
    flex: none;
    border: 2px solid var(--c);
    background: var(--surface);
    transform: rotate(45deg) scale(0.8);
  }
</style>
