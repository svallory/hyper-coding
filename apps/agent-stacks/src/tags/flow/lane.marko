import { normalizeLane } from "../../model/normalize";
import { validateLane } from "../../model/validate";
import type { LaneViewInput } from "../../model/types";

export type Input = LaneViewInput;

<const/lane=normalizeLane(input)/>
<const/problems=validateLane(lane)/>
<const/view=input.view ?? "flow"/>
<const/linkText=input.label ?? lane.name/>

<if=problems.length>
  <for|p| of=problems>
    <pre data-content-error>${p.message}</pre>
  </for>
</if>
<else-if=view === "flow">
  <lane-flow lane=lane/>
</else-if>
<else-if=view === "panels">
  <for|step| of=lane.steps>
    <step-panel lane=lane step=step/>
  </for>
  <for|c| of=lane.connectors>
    <if=Object.keys(c.details).length>
      <connector-panel lane=lane connector=c/>
    </if>
  </for>
</else-if>
<else-if=view === "nav">
  <a data-lane-link=lane.id href=`#${lane.id}`>${linkText}</a>
</else-if>
<else-if=view === "cover">
  <tr data-lane-row=lane.id>
    <th scope="row"><a href=`#${lane.id}`>${linkText}</a></th>
    <for|col| of=input.cols ?? []>
      <td data-col=col data-level=lane.cover[col]?.level ?? "absent">
        <if=lane.cover[col]?.content><${lane.cover[col].content}/></if>
      </td>
    </for>
  </tr>
</else-if>
<else-if=view === "takeaways">
  <tr data-lane-row=lane.id>
    <th scope="row"><a href=`#${lane.id}`>${linkText}</a></th>
    <td>
      <ul>
        <for|t| of=lane.takes><li><${t}/></li></for>
      </ul>
    </td>
    <td>
      <ul>
        <for|g| of=lane.gaps><li><${g}/></li></for>
      </ul>
    </td>
  </tr>
</else-if>
