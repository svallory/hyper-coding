import type { Kind, Lane, Row, Step } from "../../model/types";

export interface Input {
  lane: Lane;
  step: Step;
}

static const GROUPS = { plan: "Plan", build: "Build", check: "Check", ship: "Ship", learn: "Learn" } as const;

/** What runs a step, in the two groups the legend names: what the model reads, and code that ships with the stack. */
static const BADGES = {
  read: { title: "Skills and Files", icon: "reference" as Kind, kinds: ["skill", "command", "agent", "reference", "playbook", "rule"] },
  code: { title: "Tools and Hooks", icon: "script" as Kind, kinds: ["script", "binary", "harness-code", "hook", "tool"] },
} as const;

static interface Part { kind: Kind; name: string; count: number; manual: boolean; rid: string }

/**
 * The parts a step's tree names, once each by kind and path, nested rows included, in tree order.
 * `rid` is the id of the part's first row in the Anatomy tree, built as `anatomy-tree` and `tree-row` build it.
 */
static function parts(rows: Row[], base: string): Part[] {
  const seen = new Set<string>();
  const out: Part[] = [];
  const walk = (list: Row[], prefix: string) => {
    list.forEach((row, i) => {
      const rid = prefix ? `${prefix}.${i}` : `${base}:row:${i}`;
      if (row.kind) {
        const key = `${row.kind}:${row.path ?? row.name ?? ""}`;
        if (!seen.has(key)) {
          seen.add(key);
          out.push({ kind: row.kind, name: row.name ?? row.path ?? row.kind, count: row.count ?? 1, manual: !!row.manual, rid });
        }
      }
      walk(row.rows, rid);
    });
  };
  walk(rows, "");
  return out;
}

<const/lane=input.lane/>
<const/step=input.step/>
<const/href=`#${lane.id}/${step.id}`/>
<const/all=parts(step.rows, href.slice(1))/>
<const/badges=(Object.entries(BADGES) as [keyof typeof BADGES, (typeof BADGES)[keyof typeof BADGES]][])
  .map(([key, def]) => {
    const list = all.filter((p) => (def.kinds as readonly string[]).includes(p.kind));
    return { key, ...def, list, total: list.reduce((n, p) => n + p.count, 0) };
  })
  .filter((b) => b.list.length)/>
<id/uid/>
<div/node class="node" data-group=step.group data-human=step.human style=`grid-row: 3; grid-column: ${step.index + 1}`>
  <a class="node-link" data-step=step.id data-group=step.group href=href>
    <span class="node-head">
      <span class="node-num">${step.index + 1}</span>
      <span class="node-group">${GROUPS[step.group]}</span>
      <if=step.human>
        <span class="node-human" data-human-marker title="A human decides here"><ui-icon id="manual"/></span>
      </if>
      <if=step.warning>
        <span class="node-warn" title=`Warning: ${step.warning.title}`><ui-icon id="warning"/></span>
      </if>
    </span>
    <span class="node-title">${step.title}</span>
    <span class="node-phrase">${step.phrase}</span>
  </a>
  <if=badges.length>
    <span class="node-parts">
      <for|b, i| of=badges>
        <a class="badge" data-badge=b.key href=href style=`anchor-name: --${uid}-${i}`
          data-open-tab="anatomy" aria-label=`${b.title}: ${b.total}. Open ${step.title}` aria-describedby=`${uid}-${i}`>
          <kind-icon kind=b.icon/>
          <if=(b.total > 1)><span class="badge-n">${b.total}</span></if>
        </a>
        <div class="badge-pop" id=`${uid}-${i}` popover="manual" data-badge-list=b.key role="dialog"
          aria-label=`${b.title} in the step ${step.title}` style=`position-anchor: --${uid}-${i}`>
          <div class="badge-pop-title">${b.title} <span class="badge-pop-count">${b.total}</span></div>
          <ul>
            <for|p| of=b.list>
              <li>
                <a class="badge-pop-item" href=href data-row=p.rid>
                  <kind-icon kind=p.kind/><span class="badge-pop-name">${p.name}</span><if=(p.count > 1)><span class="badge-pop-n">×${p.count}</span></if><if=p.manual><span class="badge-pop-man">manual</span></if>
                </a>
              </li>
            </for>
          </ul>
        </div>
      </for>
    </span>
  </if>
</div>

<script>
  // Pointing at or focusing a badge shows its list; a click pins it, a second click or Esc closes it.
  // One badge list is open at a time. Without script the badge and each item are links to the step's panel.
  // The state is shared by every step on the page: one list at a time, one click and one key listener.
  // Leaving the badge or the list waits a short grace delay, then fades the list out; coming back cancels.
  type Shared = { open: HTMLElement | null; pinned: boolean; bound: boolean; grace: number; fade: number };
  const GRACE_MS = 150;
  const FADE_MS = 300;
  const w = window as unknown as { __badgeList?: Shared };
  const g: Shared = (w.__badgeList ??= { open: null, pinned: false, bound: false, grace: 0, fade: 0 });
  const popOf = (badge: Element) => document.getElementById(badge.getAttribute("aria-describedby") ?? "");
  const cancelClose = () => {
    clearTimeout(g.grace);
    clearTimeout(g.fade);
    if (g.open) popOf(g.open)?.classList.remove("is-closing");
  };
  const show = (badge: HTMLElement) => {
    const pop = popOf(badge);
    if (!pop) return;
    if (g.open && g.open !== badge) hide();
    cancelClose();
    if (!pop.matches(":popover-open")) pop.showPopover();
    badge.classList.add("is-open");
    g.open = badge;
  };
  const hide = () => {
    cancelClose();
    if (!g.open) return;
    popOf(g.open)?.hidePopover();
    g.open.classList.remove("is-open");
    g.open = null;
    g.pinned = false;
  };
  const scheduleClose = () => {
    cancelClose();
    const open = g.open;
    if (!open) return;
    g.grace = window.setTimeout(() => {
      popOf(open)?.classList.add("is-closing");
      g.fade = window.setTimeout(() => {
        if (g.open === open) hide();
      }, FADE_MS);
    }, GRACE_MS);
  };
  const badgeAt = (t: EventTarget | null) => (t as Element | null)?.closest?.<HTMLElement>(".badge") ?? null;
  const popAt = (t: EventTarget | null) => (t as Element | null)?.closest?.<HTMLElement>(".badge-pop") ?? null;
  const onOpen = (t: EventTarget | null) => !!g.open && (badgeAt(t) === g.open || popAt(t) === popOf(g.open));
  node().addEventListener("pointerover", (e) => {
    if ((e as PointerEvent).pointerType !== "mouse") return;
    if (g.pinned) return;
    const b = badgeAt(e.target);
    if (b) show(b);
    else if (onOpen(e.target)) cancelClose();
  });
  node().addEventListener("pointerout", (e) => {
    if ((e as PointerEvent).pointerType !== "mouse" || !g.open || g.pinned) return;
    if (!onOpen(e.target)) return;
    // Moving between the badge and its list is not leaving.
    if (onOpen((e as PointerEvent).relatedTarget)) return;
    scheduleClose();
  });
  node().addEventListener("focusin", (e) => {
    const b = badgeAt(e.target);
    if (b && !g.pinned) show(b);
  });
  node().addEventListener("focusout", (e) => {
    const to = (e as FocusEvent).relatedTarget as Node | null;
    // Only this step's own list: focus leaving another step must not close a list the pointer opened.
    if (!g.pinned && g.open && node().contains(g.open) && (!to || !node().contains(to))) hide();
  });
  node().addEventListener("click", (e) => {
    const item = (e.target as Element | null)?.closest?.<HTMLElement>(".badge-pop-item");
    if (item) {
      // The side panel pins the step, opens its Anatomy tab and shows the row.
      e.preventDefault();
      e.stopPropagation();
      hide();
      item.dispatchEvent(new CustomEvent("panel-row", { bubbles: true, detail: { href: item.getAttribute("href"), row: item.dataset.row } }));
      return;
    }
    const b = badgeAt(e.target);
    if (!b) return;
    e.preventDefault();
    e.stopPropagation();
    if (g.open === b && g.pinned) hide();
    else {
      show(b);
      g.pinned = true;
      b.dispatchEvent(new CustomEvent("panel-row", { bubbles: true, detail: { href: b.getAttribute("href"), row: null } }));
    }
  });
  if (!g.bound) {
    g.bound = true;
    document.addEventListener("click", (e) => {
      if (g.open && g.pinned && !badgeAt(e.target) && !popAt(e.target)) hide();
    }, true);
    // Capture phase: the first Esc closes the list and does not reach the side panel.
    document.addEventListener("keydown", (e) => {
      if (e.key !== "Escape" || !g.open) return;
      e.stopImmediatePropagation();
      hide();
    }, true);
  }
</script>

<style>
  .node {
    --g: var(--surface);
    --gl: var(--edge);
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin: 0 13px;
    border: 1px solid color-mix(in srgb, var(--gl) 70%, var(--line));
    border-left: 4px solid var(--gl);
    border-radius: 4px;
    background: var(--g);
  }
  .node[data-group="plan"] { --g: var(--plan); --gl: var(--plan-l); }
  .node[data-group="build"] { --g: var(--build); --gl: var(--build-l); }
  .node[data-group="check"] { --g: var(--check); --gl: var(--check-l); }
  .node[data-group="ship"] { --g: var(--ship); --gl: var(--ship-l); }
  .node[data-group="learn"] { --g: var(--learn); --gl: var(--learn-l); }
  .node[data-human] {
    border-top-color: var(--fg);
    border-right-color: var(--fg);
    border-bottom-color: var(--fg);
  }
  .node:hover {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  /* The step the panel is pinned on. */
  .node:has(> .node-link[aria-current]) {
    box-shadow: 0 0 0 3px var(--accent);
  }
  .node-link {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 3px;
    padding: 6px 9px 4px;
    color: var(--fg);
    text-decoration: none;
  }
  .node-link:hover {
    color: var(--fg);
  }
  .node-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .node-head {
    display: flex;
    align-items: center;
    gap: 5px;
    color: var(--gl);
    font-size: 11.5px;
    font-weight: 650;
    line-height: 1.3;
  }
  .node-num {
    color: var(--muted);
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .node-human,
  .node-warn {
    display: inline-flex;
    width: 13px;
    height: 13px;
    margin-left: auto;
    color: var(--fg);
  }
  .node-human .ui-icon,
  .node-warn .ui-icon {
    width: 13px;
    height: 13px;
    vertical-align: baseline;
  }
  .node-human ~ .node-warn {
    margin-left: 4px;
  }
  .node-warn {
    color: var(--warning);
  }
  .node-title {
    font-stretch: 84%;
    font-weight: 700;
    font-size: 15.5px;
    line-height: 1.12;
  }
  .node-phrase {
    color: var(--muted);
    font-size: 12.5px;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .node-parts {
    display: flex;
    flex-wrap: wrap;
    gap: 3px;
    padding: 2px 9px 8px;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 3px;
    padding: 1px 4px 1px 2px;
    border: 1px solid var(--edge);
    border-radius: 3px;
    background: var(--surface);
    color: var(--fg);
    font-size: 10.5px;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    font-variant-numeric: tabular-nums;
  }
  .badge:hover {
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 40%, transparent);
  }
  .badge.is-open {
    box-shadow: 0 0 0 2px var(--accent);
  }
  .badge:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* The list behind a badge: in the top layer, placed under the badge and flipped when it does not fit. */
  .badge-pop {
    position: fixed;
    inset: auto;
    top: calc(anchor(bottom) + 6px);
    left: anchor(left);
    position-try-fallbacks: flip-block, flip-inline;
    width: max-content;
    min-width: 11rem;
    max-width: min(20rem, calc(100vw - 16px));
    max-height: min(380px, 60dvh);
    margin: 0;
    padding: 0.5rem;
    overflow-y: auto;
    overscroll-behavior: contain;
    border: 1px solid var(--fg);
    border-radius: 6px;
    background: var(--surface);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.22);
    color: var(--fg);
    font-size: 0.875rem;
    line-height: 1.3;
    opacity: 1;
    transition: opacity 300ms ease-out;
  }
  /* The grace delay is over: the list fades out, and coming back over it or its badge cancels the close. */
  .badge-pop.is-closing {
    opacity: 0;
  }
  /* Bridges the gap to the badge, so the pointer stays over the list on its way in. */
  .badge-pop::before {
    content: "";
    position: absolute;
    inset: -8px 0 auto 0;
    height: 8px;
  }
  .badge-pop-title {
    display: flex;
    align-items: baseline;
    gap: 8px;
    margin-bottom: 0.3rem;
    padding: 0.125rem 0.375rem 0.4rem;
