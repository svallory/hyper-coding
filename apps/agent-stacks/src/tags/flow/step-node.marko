    font-stretch: var(--cond);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.2;
  }
  .badge-pop-count {
    color: var(--muted);
    font-stretch: normal;
    font-size: 0.8125rem;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }
  .badge-pop ul {
    display: flex;
    flex-direction: column;
    gap: 1px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .badge-pop li {
    margin: 0;
  }
  .badge-pop-item {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0.3rem 0.375rem;
    border-radius: 3px;
    color: var(--fg);
    font-weight: 600;
    overflow-wrap: anywhere;
    text-decoration: none;
  }
  .badge-pop-item:hover {
    background: color-mix(in srgb, var(--accent) 16%, transparent);
  }
  .badge-pop-item:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -2px;
  }
  .badge-pop-n {
    color: var(--muted);
    font-size: 0.75rem;
    font-weight: 500;
  }
  .badge-pop-man {
    margin-left: auto;
    padding: 0 6px;
    border: 1px solid var(--manual);
    border-radius: 999px;
    color: var(--manual);
    font-size: 0.6875rem;
    font-weight: 650;
    line-height: 1.45;
  }
</style>
