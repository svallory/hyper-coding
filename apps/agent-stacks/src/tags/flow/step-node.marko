import { KINDS } from "../../model/kinds";
import type { Kind, Lane, Row, Step } from "../../model/types";

export interface Input {
  lane: Lane;
  step: Step;
}

static const GROUPS = { plan: "Plan", build: "Build", check: "Check", ship: "Ship", learn: "Learn" } as const;

/** The parts a step's tree names, counted by icon (one badge per icon), nested rows included. */
static function badges(rows: Row[]): { icon: string; kind: Kind; count: number }[] {
  const seen = new Set<string>();
  const out = new Map<string, { icon: string; kind: Kind; count: number }>();
  const walk = (list: Row[]) => {
    for (const row of list) {
      if (row.kind) {
        const key = `${row.kind}:${row.path ?? row.name ?? ""}`;
        if (!seen.has(key)) {
          seen.add(key);
          const icon = KINDS[row.kind].icon;
          const entry = out.get(icon);
          if (entry) entry.count += row.count ?? 1;
          else out.set(icon, { icon, kind: row.kind, count: row.count ?? 1 });
        }
      }
      walk(row.rows);
    }
  };
  walk(rows);
  return [...out.values()];
}

<const/lane=input.lane/>
<const/step=input.step/>
<const/href=`#${lane.id}/${step.id}`/>
<const/parts=badges(step.rows)/>
<div class="node" data-node data-group=step.group data-human=step.human style=`grid-row: 3; grid-column: ${step.index + 1}`>
  <a class="node-link" data-step=step.id data-group=step.group href=href>
    <span class="node-head">
      <span class="node-num">${step.index + 1}</span>
      <span class="node-group">${GROUPS[step.group]}</span>
      <if=step.human>
        <span class="node-human" data-human-marker title="A human decides here"><ui-icon id="manual"/> human</span>
      </if>
      <if=step.warning>
        <span class="node-warn" title=`Warning: ${step.warning.title}`><ui-icon id="warning"/></span>
      </if>
    </span>
    <span class="node-title">${step.title}</span>
    <span class="node-phrase">${step.phrase}</span>
  </a>
  <if=parts.length>
    <span class="node-parts">
      <for|part| of=parts>
        <a class="badge" data-badge=part.icon href=href
          title=`${part.count} ${KINDS[part.kind].label.toLowerCase()}${(part.count > 1) ? "s" : ""}: open the Anatomy of ${step.title}`>
          <kind-icon kind=part.kind/>
          <if=(part.count > 1)><span class="badge-n">${part.count}</span></if>
        </a>
      </for>
    </span>
  </if>
</div>

