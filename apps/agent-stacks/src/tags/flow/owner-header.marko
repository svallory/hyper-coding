import type { Lane } from "../../model/types";

export interface Input {
  owner: Lane["owners"][number];
}

<const/owner=input.owner/>
<const/span=`${owner.from + 1} / ${owner.to + 2}`/>
<div class="owner-col" data-first=owner.from === 0 style=`grid-row: 1 / -1; grid-column: ${span}`></div>
<div class="owner" style=`grid-row: 1; grid-column: ${span}`>
  <span class="owner-name">${owner.name}</span>
  <if=owner.note><span class="owner-note">${owner.note}</span></if>
</div>

<style>
  /* A divider between the groups of steps; a column starts at the card edge, in the middle of the gap. */
  .owner-col {
    pointer-events: none;
    border-left: 1px solid var(--line);
  }
  .owner-col[data-first] {
    border-left: 0;
  }
  .owner {
    display: flex;
    flex-direction: column;
    gap: 1px;
    min-width: 0;
    padding: 0.75rem 13px 0;
  }
  .owner-name {
    font-stretch: var(--cond);
    font-weight: 700;
    font-size: 1rem;
    line-height: 1.12;
    overflow-wrap: anywhere;
  }
  .owner-note {
    color: var(--muted);
    font-size: 0.75rem;
    line-height: 1.25;
  }
</style>
