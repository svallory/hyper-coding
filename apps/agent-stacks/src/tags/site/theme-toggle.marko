import Icon from "../../components/ui/icon/icon.marko";
import Button from "../../components/ui/button/button.marko";
<id/toggleId/>
<Button id=toggleId class="theme-toggle" variant="outline" size="icon-sm" type="button" aria-label="Switch to dark theme" title="Switch to dark theme">
  <Icon name="Moon" unsized aria-hidden="true" class="toggle-moon"/>
  <Icon name="Sun" unsized aria-hidden="true" class="toggle-sun"/>
</Button>

<script>
  const root = document.documentElement;
  const mq = matchMedia("(prefers-color-scheme: dark)");
  const isDark = () => (root.dataset.theme ? root.dataset.theme === "dark" : mq.matches);
  // The icon shows what a click switches to: a sun in the dark theme, a moon in the light one.
  const button = () => document.getElementById(toggleId) as HTMLButtonElement;
  const sync = () => {
    const dark = isDark();
    const label = `Switch to ${dark ? "light" : "dark"} theme`;
    button().setAttribute("aria-label", label);
    button().title = label;
  };
  sync();
  button().addEventListener("click", () => {
    const next = isDark() ? "light" : "dark";
    root.dataset.theme = next;
    try {
      localStorage.setItem("theme", next);
    } catch {}
    sync();
  }, { signal: $signal });
  const watch = new MutationObserver(sync);
  watch.observe(root, { attributes: true, attributeFilter: ["data-theme"] });
  $signal.addEventListener("abort", () => watch.disconnect());
  mq.addEventListener("change", sync, { signal: $signal });
</script>

<style>
  .theme-toggle {
    flex: none;
    width: 30px;
    height: 30px;
    margin: 0;
    background: none;
    border-radius: 6px;
    color: var(--fg);
    cursor: pointer;
  }
  .theme-toggle:hover {
    color: var(--fg);
    border-color: var(--fg);
    background: var(--surface);
  }
  .theme-toggle svg {
    width: 16px;
    height: 16px;
  }
  .theme-toggle .toggle-sun,
  :root[data-theme="dark"] .theme-toggle .toggle-moon {
    display: none;
  }
  :root[data-theme="dark"] .theme-toggle .toggle-sun {
    display: block;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme]) .theme-toggle .toggle-moon {
      display: none;
    }
    :root:not([data-theme]) .theme-toggle .toggle-sun {
      display: block;
    }
  }
</style>
