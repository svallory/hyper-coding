export interface Input {
  /** Names the bar for assistive technology. */
  label?: string;
  /** Which page this bar is on; the bar links to the other one. */
  page?: "comparison" | "playbooks";
  /** The page's section links. */
  content?: Marko.Body;
}

<const/other=input.page === "playbooks" ? { href: "/", label: "Comparison" } : { href: "/pstack/playbooks/", label: "pstack playbooks" }/>

<nav class="site-nav" id="top" aria-label=input.label>
  <div class="top-in">
    <a class="tb" href="/">Agent stacks</a>
    <div class="tl"><${input.content}/></div>
    <a class="other" href=other.href data-other-page>${other.label}</a>
    <theme-toggle/>
  </div>
</nav>

<script>
  // The link of the section in view is underlined. Sections are the ids the bar's own links point at.
  const strip = document.querySelector<HTMLElement>(".site-nav .tl") as HTMLElement;
  const links = Array.from(strip.querySelectorAll<HTMLAnchorElement>("a[href^='#']"))
    .map((a) => ({ a, el: document.getElementById(decodeURIComponent((a.getAttribute("href") as string).slice(1))) }))
    .filter((x): x is { a: HTMLAnchorElement; el: HTMLElement } => !!x.el);
  let cur: HTMLAnchorElement | null = null;
  const spy = () => {
    let hit: HTMLAnchorElement | null = null;
    const line = Math.max(90, innerHeight * 0.4);
    for (const { a, el } of links) if (el.getBoundingClientRect().top <= line) hit = a;
    if (hit === cur) return;
    cur?.removeAttribute("aria-current");
    cur = hit;
    if (!cur) return;
    cur.setAttribute("aria-current", "true");
    const r = cur.getBoundingClientRect();
    const t = strip.getBoundingClientRect();
    if (r.left < t.left || r.right > t.right) strip.scrollLeft += r.left - t.left - t.width / 2 + r.width / 2;
  };
  addEventListener("scroll", spy, { passive: true, signal: $signal });
  addEventListener("resize", spy, { signal: $signal });
  // The panel opening or closing moves the sections without a scroll.
  const watch = new ResizeObserver(spy);
  watch.observe(document.body);
  $signal.addEventListener("abort", () => watch.disconnect());
  spy();
</script>

