import Button from "../../components/ui/button/button.marko";
import Kbd from "../../components/ui/kbd/kbd.marko";

export interface Input {
  /** The panels. Each shows when it is the one pointed at or pinned (or, with no script, the page's target). */
  content?: Marko.Body;
}

<aside/root class="side-panel" id="side" aria-label="Details of the selected step or connector">
  <div class="side-resize" role="separator" tabindex="0" aria-orientation="vertical"
    aria-label="Resize details panel. Drag, or use the arrow keys; double-click to reset."
    aria-valuemin=280 aria-valuemax=960 aria-valuenow=380></div>
  <div class="side-in">
    <div class="side-h">
      <small class="side-k">Details</small>
      <Button class="side-close" variant="outline" size="sm" href="#side" role="button" aria-label="Close details panel">Close <Kbd>esc</Kbd></Button>
    </div>
    <div class="side-pop"><${input.content}/></div>
  </div>
</aside>

<script>
  const KEYS = { tab: "panel-tab", size: "aside-size" };
  const read = (key: string): string | null => {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  };
  const write = (key: string, value: string) => {
    try {
      localStorage.setItem(key, value);
    } catch {}
  };
  const aside = root() as HTMLElement;
  const pop = aside.querySelector<HTMLElement>(".side-pop") as HTMLElement;
  const label = aside.querySelector<HTMLElement>(".side-k") as HTMLElement;

  const panelFor = (href: string | null): HTMLElement | null => {
    if (!href || href[0] !== "#") return null;
    let id: string;
    try {
      id = decodeURIComponent(href.slice(1));
    } catch {
      return null;
    }
    const el = document.getElementById(id);
    return el && el.classList.contains("panel") && aside.contains(el) ? el : null;
  };
  // What the pointer or the keyboard is on: any link outside the panel that goes to one of its panels.
  const targetOf = (node: EventTarget | null): { link: HTMLAnchorElement; panel: HTMLElement } | null => {
    const link = (node as Element | null)?.closest?.("a[href^='#']") as HTMLAnchorElement | null;
    if (!link) return null;
    const panel = panelFor(link.getAttribute("href"));
    return panel ? { link, panel } : null;
  };

  // One item at a time: `shown` fills the panel, `pinned` is the id it is held on.
  // Pointing fills it while nothing is pinned; a click pins; a click on the pinned item releases it
  // (the panel stays open); Close or Esc shut it and it stays shut until the next click.
  let shown: HTMLElement | null = null;
  let pinned: string | null = null;
  let dismissed = false;

  const addressFor = (id: string | null) => {
    const path = location.pathname + location.search;
    try {
      history.replaceState(history.state, "", id ? `${path}#${id}` : path);
    } catch {}
  };
  const render = () => {
    for (const p of Array.from(pop.querySelectorAll<HTMLElement>(".panel"))) {
      if (p === shown) p.setAttribute("data-shown", "");
      else p.removeAttribute("data-shown");
    }
    aside.toggleAttribute("data-open", !!shown);
    aside.toggleAttribute("data-pinned", !!pinned);
    (aside as HTMLElement & { inert: boolean }).inert = !shown;
    label.textContent = pinned ? "Pinned. Unselect node to release." : "Following the pointer. Click to pin.";
    // Only the links that open panels carry aria-current; the top bar's scroll spy owns its own.
    const want = pinned ? `#${pinned}` : null;
    for (const a of Array.from(document.querySelectorAll<HTMLAnchorElement>("a[data-step], a[data-connector]"))) {
      if (want && a.getAttribute("href") === want) a.setAttribute("aria-current", "true");
      else a.removeAttribute("aria-current");
    }
  };
  const fill = (panel: HTMLElement, force?: string) => {
    shown = panel;
    pop.scrollTop = 0;
    // A badge asks for its tab (Anatomy); that is not the reader's choice, so it is not remembered.
    const tab = force ?? read(KEYS.tab);
    const radio = tab && panel.querySelector<HTMLInputElement>(`input[data-tab="${tab}"]`);
    if (radio) radio.checked = true;
  };
  const release = () => {
    pinned = null;
    addressFor(null);
  };
  // A click that lets go of the pinned item: anywhere outside the panel and outside the pinned node itself.
  const outsideRelease = (node: EventTarget | null): boolean => {
    const el = node as Element | null;
    if (!el?.closest || aside.contains(el)) return false;
    for (const a of Array.from(document.querySelectorAll(`a[href="#${CSS.escape(pinned ?? "")}"]`))) {
      if (aside.contains(a)) continue;
      if (a.contains(el) || a.closest(".node")?.contains(el)) return false;
    }
    return true;
  };
  const peek = (panel: HTMLElement, tab?: string) => {
    if (pinned || dismissed) return;
    if (shown === panel && aside.hasAttribute("data-open")) return;
    fill(panel, tab);
    render();
  };
  const pin = (panel: HTMLElement, tab?: string) => {
    const was = pinned === panel.id;
    release();
    dismissed = false;
    if (!was) {
      fill(panel, tab);
      pinned = panel.id;
      addressFor(panel.id);
    }
    render();
  };
  const close = () => {
    // Keep a keyboard user's place: the aside goes inert, so focus moves back to the item's own link.
    if (shown && aside.contains(document.activeElement)) {
      document.querySelector<HTMLElement>(`a[href="#${CSS.escape(shown.id)}"]:not(.side-panel a)`)?.focus({ preventScroll: true });
    }
    release();
    shown = null;
    dismissed = true;
    render();
  };

  document.addEventListener("pointerover", (e) => {
    if ((e as PointerEvent).pointerType && (e as PointerEvent).pointerType !== "mouse") return;
    const t = targetOf(e.target);
    if (t && !aside.contains(t.link)) peek(t.panel, t.link.dataset.openTab);
  }, { signal: $signal });
  document.addEventListener("focusin", (e) => {
    const t = targetOf(e.target);
    if (t && !aside.contains(t.link)) peek(t.panel, t.link.dataset.openTab);
  }, { signal: $signal });
  document.addEventListener("click", (e) => {
    const me = e as MouseEvent;
    if (me.defaultPrevented || me.button !== 0 || me.metaKey || me.ctrlKey || me.shiftKey || me.altKey) return;
    if ((e.target as Element).closest?.(".side-close")) {
      e.preventDefault();
      close();
      return;
    }
    const t = targetOf(e.target);
    if (!t) {
      if (pinned && !outsideRelease(e.target)) return;
      if (pinned) {
        release();
        render();
      }
      return;
    }
    e.preventDefault();
    // A link inside the panel (a hand-off) pins its step without releasing it.
    if (aside.contains(t.link)) {
      if (pinned !== t.panel.id) pin(t.panel);
    } else pin(t.panel);
  }, { signal: $signal });
  // A step card's badge or one of its list items: show the step on its Anatomy tab, pinned (never released
  // by this), and for an item open the rows above its row, scroll it into view and highlight it.
  const hitTimers = new WeakMap<Element, number>();
  document.addEventListener("panel-row", (e) => {
    const { href, row } = (e as CustomEvent<{ href: string | null; row: string | null }>).detail;
    const panel = panelFor(href);
    if (!panel) return;
    if (pinned !== panel.id) pin(panel, "anatomy");
    else {
      const radio = panel.querySelector<HTMLInputElement>("input[data-tab='anatomy']");
      if (radio) radio.checked = true;
    }
    const target = row ? document.getElementById(row) : null;
    if (!target || !panel.contains(target)) return;
    for (let d = target.parentElement?.closest("details"); d; d = d.parentElement?.closest("details")) d.open = true;
    const box = pop.getBoundingClientRect();
    const at = target.getBoundingClientRect();
    pop.scrollTop += at.top - box.top - Math.max(0, (pop.clientHeight - at.height) / 3);
    target.classList.remove("is-hit");
    void target.offsetWidth;
    target.classList.add("is-hit");
    // One timer per row, the length of the highlight; it also covers reduced motion, where nothing animates.
    clearTimeout(hitTimers.get(target));
    hitTimers.set(target, window.setTimeout(() => target.classList.remove("is-hit"), 1500));
    // The list that held the focus is gone: keep the keyboard user's place on the row.
    const focusable = target.matches("details")
      ? target.querySelector<HTMLElement>(":scope > summary")
      : (target.querySelector<HTMLElement>("a, summary") ?? target);
    if (focusable === target && !target.hasAttribute("tabindex")) {
      target.setAttribute("tabindex", "-1");
      target.addEventListener("blur", () => target.removeAttribute("tabindex"), { once: true });
    }
    focusable?.focus({ preventScroll: true });
  }, { signal: $signal });
  // A link is not a button: Space presses it too.
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      if (shown) close();
      return;
    }
    if (e.key !== " ") return;
    if ((e.target as Element).closest?.(".side-close")) {
      e.preventDefault();
      close();
      return;
    }
    const t = targetOf(e.target);
    if (!t || (e.target as Element).tagName !== "A") return;
    e.preventDefault();
    (e.target as HTMLElement).click();
  }, { signal: $signal });

  // An address that names a panel pins it, on load and when the fragment changes.
  const fromAddress = (scroll: boolean) => {
    const panel = panelFor(location.hash);
    if (!panel) {
      // The fragment moved elsewhere (a section link): the pin has no address any more, so let it go.
      if (pinned) {
        pinned = null;
        render();
      }
      return;
    }
    dismissed = false;
    if (pinned !== panel.id) {
      fill(panel);
      pinned = panel.id;
      render();
    }
    if (scroll) {
      document.querySelector<HTMLElement>("a[aria-current]:is([data-step], [data-connector])")?.scrollIntoView({ block: "nearest", inline: "nearest" });
    }
  };
  fromAddress(true);
  addEventListener("hashchange", () => fromAddress(true), { signal: $signal });
  render();

  aside.addEventListener("change", (e) => {
    const t = e.target as HTMLInputElement;
    if (t.matches?.("input[data-tab]") && t.checked) write(KEYS.tab, t.dataset.tab as string);
  }, { signal: $signal });

  // Resize: the left edge of the aside, or the top edge of the sheet at 820 px or narrower.
  const handle = aside.querySelector<HTMLElement>(".side-resize") as HTMLElement;
  const sheet = matchMedia("(max-width: 820px)");
  const clamp = (n: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, n));
  const limits = () =>
    sheet.matches
      ? [160, Math.max(200, innerHeight - 96)]
      : [280, Math.max(320, Math.min(960, innerWidth - 380))];
  const current = () => Math.round(sheet.matches ? aside.getBoundingClientRect().height : aside.getBoundingClientRect().width);
  const describe = (px: number) => {
    const [lo, hi] = limits();
    handle.setAttribute("aria-valuemin", String(Math.round(lo)));
    handle.setAttribute("aria-valuemax", String(Math.round(hi)));
    handle.setAttribute("aria-orientation", sheet.matches ? "horizontal" : "vertical");
    handle.setAttribute("aria-valuenow", String(px));
  };
  const apply = (size: number) => {
    const [lo, hi] = limits();
    const px = clamp(Math.round(size), lo, hi);
    // On the root, so the page's own padding sees it too.
    document.documentElement.style.setProperty(sheet.matches ? "--sheet-h" : "--side-w", `${px}px`);
    describe(px);
    return px;
  };
  const stored = (): { w?: number; h?: number } => {
    try {
      return JSON.parse(read(KEYS.size) ?? "{}");
    } catch {
      return {};
    }
  };
  const save = (px: number) => write(KEYS.size, JSON.stringify({ ...stored(), [sheet.matches ? "h" : "w"]: px }));
  const initial = () => {
    for (const v of ["--side-w", "--sheet-h"]) document.documentElement.style.removeProperty(v);
    const s = stored();
    const saved = sheet.matches ? s.h : s.w;
    if (saved) apply(saved);
    else describe(current());
  };
  initial();
  sheet.addEventListener("change", initial, { signal: $signal });
  handle.addEventListener("pointerdown", (e) => {
    handle.setPointerCapture(e.pointerId);
    document.documentElement.setAttribute("data-resizing", "");
    let last = current();
    const move = (m: PointerEvent) => {
      last = apply(sheet.matches ? innerHeight - m.clientY : innerWidth - m.clientX);
    };
    const up = () => {
      handle.removeEventListener("pointermove", move);
      handle.removeEventListener("pointerup", up);
      handle.removeEventListener("pointercancel", up);
      handle.removeEventListener("lostpointercapture", up);
      document.documentElement.removeAttribute("data-resizing");
      save(last);
    };
    handle.addEventListener("pointermove", move);
    handle.addEventListener("pointerup", up);
    handle.addEventListener("pointercancel", up);
    handle.addEventListener("lostpointercapture", up);
  }, { signal: $signal });
  handle.addEventListener("dblclick", () => {
    document.documentElement.style.removeProperty(sheet.matches ? "--sheet-h" : "--side-w");
    const s = stored();
    delete s[sheet.matches ? "h" : "w"];
    write(KEYS.size, JSON.stringify(s));
    describe(current());
  }, { signal: $signal });
  handle.addEventListener("keydown", (e) => {
    const grow = sheet.matches ? "ArrowUp" : "ArrowLeft";
    const shrink = sheet.matches ? "ArrowDown" : "ArrowRight";
    if (e.key !== grow && e.key !== shrink) return;
    e.preventDefault();
    save(apply(current() + (e.key === grow ? 24 : -24)));
  }, { signal: $signal });
</script>

<style>
  .side-panel {
    position: fixed;
    z-index: 25;
    top: 0;
    right: 0;
    bottom: 0;
    width: var(--side-w);
    transform: translateX(100%);
    visibility: hidden;
    transition: transform 0.2s ease, visibility 0s linear 0.2s;
  }
  /* Open: by script (data-open), or with no script when the page's target is one of the panels. */
  .side-panel[data-open],
  :root:not(.js) .side-panel:has(.panel:target) {
    transform: none;
    visibility: visible;
    transition: transform 0.2s ease, visibility 0s;
  }
  :root:has(.side-panel[data-open]) body,
  :root:not(.js):has(.side-panel .panel:target) body {
    padding-right: var(--side-w);
  }
  body {
    transition: padding 0.2s ease;
  }
  .side-in {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border-left: 2px solid var(--fg);
  }
  .side-h {
    flex: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0.5rem 1.125rem;
    border-bottom: 1px solid var(--line);
  }
  .side-k {
    color: var(--muted);
    line-height: 1.3;
    font-size: 0.8125rem;
  }
  .side-panel[data-pinned] .side-k {
    color: var(--fg);
    font-weight: 700;
  }
  .side-close {
    flex: none;
    height: 28px;
    padding: 0 0.7rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    color: var(--fg);
    text-decoration: none;
  }
  .side-close:hover {
    color: var(--fg);
    border-color: var(--fg);
    background: var(--sunk);
  }
  .side-pop {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.125rem 1.125rem 2rem;
    font-size: 0.875rem;
    line-height: 1.5;
  }
  /* Only the panel on show is displayed. */
  .panel {
    display: none;
  }
  .panel[data-shown],
  :root:not(.js) .panel:target {
    display: block;
  }
  .side-resize {
    position: absolute;
    z-index: 2;
    left: 0;
    top: 0;
    bottom: 0;
    width: 11px;
    cursor: col-resize;
    touch-action: none;
    outline: 0;
  }
  .side-resize::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 4px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.12s;
  }
  .side-resize:hover::after,
  .side-resize:focus-visible::after,
  :root[data-resizing] .side-resize::after {
    opacity: 1;
  }
  :root[data-resizing] .side-panel,
  :root[data-resizing] body {
    transition: none;
  }
  :root[data-resizing],
  :root[data-resizing] * {
    user-select: none;
    -webkit-user-select: none;
  }
  @media (max-width: 820px) {
    .side-panel {
      top: auto;
      left: 0;
      width: auto;
      height: var(--sheet-h);
      transform: translateY(104%);
    }
    .side-panel[data-open],
    :root:not(.js) .side-panel:has(.panel:target) {
      transform: none;
    }
    :root:has(.side-panel[data-open]) body,
    :root:not(.js):has(.side-panel .panel:target) body {
      padding-right: 0;
      padding-bottom: var(--sheet-h);
    }
    :root:has(.side-panel[data-open]) .site-nav,
    :root:not(.js):has(.side-panel .panel:target) .site-nav {
      right: 0;
    }
    .side-in {
      border-left: 0;
      border-top: 2px solid var(--fg);
      box-shadow: 0 -8px 24px rgba(0, 0, 0, 0.2);
      overflow: hidden;
    }
    .side-resize {
      left: 0;
      right: 0;
      top: -12px;
      bottom: auto;
      width: auto;
      height: 26px;
      cursor: row-resize;
    }
    .side-resize::after {
      left: 50%;
      top: 19px;
      bottom: auto;
      width: 40px;
      height: 4px;
      margin-left: -20px;
      border-radius: 2px;
      background: var(--muted);
      opacity: 1;
    }
    .side-resize:hover::after,
    .side-resize:focus-visible::after,
    :root[data-resizing] .side-resize::after {
      background: var(--accent);
    }
    .side-h {
      padding-top: 0.75rem;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .side-panel,
    body {
      transition: none;
    }
  }
</style>
