import TreeRow from "./tree-row.marko";
import { COLLAPSE_FROM_DEPTH } from "../../model/constants";
import type { Row, Source } from "../../model/types";

export interface Input {
  row: Row;
  of?: Source;
  /** The row's id, which a step card's badge list links to; children take `<id>.<index>`. Without it the row has none. */
  rid?: string;
}

<const/row=input.row/>
<const/rid=input.rid/>
<const/child=(i: number) => (rid === undefined ? undefined : `${rid}.${i}`)/>
<if=row.choice !== undefined>
  <tree-choice label=row.choice>
    <for|alt, i| of=row.rows>
      <TreeRow row=alt of=input.of rid=child(i)/>
    </for>
  </tree-choice>
</if>
<else-if=row.rows.length>
  <li class=`tree-item${row.depth === 0 ? " tree-root" : ""}`>
    <details data-row id=rid data-depth=row.depth data-kind=row.kind data-manual=!!row.manual
      open=row.depth < COLLAPSE_FROM_DEPTH - 1>
      <summary><tree-row-line row=row of=input.of/></summary>
      <if=row.note><div class="row-note"><${row.note}/></div></if>
      <if=row.warning><callout title=row.warning.title><${row.warning.content}/></callout></if>
      <ul class="tree-children">
        <for|kid, i| of=row.rows>
          <TreeRow row=kid of=input.of rid=child(i)/>
        </for>
      </ul>
    </details>
  </li>
</else-if>
<else>
  <li class=`tree-item${row.depth === 0 ? " tree-root" : ""}`>
    <div data-row id=rid data-depth=row.depth data-kind=row.kind data-manual=!!row.manual>
      <tree-row-line row=row of=input.of/>
      <if=row.note><div class="row-note"><${row.note}/></div></if>
      <if=row.warning><callout title=row.warning.title><${row.warning.content}/></callout></if>
    </div>
  </li>
</else>

<style>
  /* The disclosure marker is drawn here, so the row's line stays on one line with it. */
  .tree-item > details > summary {
    display: flex;
    gap: 0.35rem;
    align-items: baseline;
    list-style: none;
    cursor: pointer;
  }
  .tree-item > details > summary::-webkit-details-marker {
    display: none;
  }
  .tree-item > details > summary::before {
    content: "\25B8";
    flex: none;
    width: 1ch;
    color: var(--muted);
    font-size: 0.75rem;
  }
  .tree-item > details[open] > summary::before {
    content: "\25BE";
  }
  /* A row with no children keeps the marker's width, so names line up. */
  .tree-item > div[data-row] {
    padding-left: calc(1ch + 0.35rem);
  }
  /* The row a badge list's item led to: a background only, fading back (no border, no outline). */
  @keyframes row-hit {
    from { background-color: color-mix(in srgb, var(--accent) 28%, transparent); }
    to { background-color: transparent; }
  }
  .tree-item > details.is-hit > summary,
  .tree-item > div[data-row].is-hit {
    border-radius: 3px;
    animation: row-hit 1.5s ease-out;
  }
  .row-note {
    margin: 0.2rem 0 0 3.6ch;
    font-size: 0.8125rem;
    color: var(--muted);
  }
</style>
