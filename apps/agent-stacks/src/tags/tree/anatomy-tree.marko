import type { Kind, Row, Source } from "../../model/types";

export interface Input {
  rows: Row[];
  /** The stack the rows' files belong to; without it the rows are not linked. */
  of?: Source;
  /** Gives each row an id, `<id>:row:<index path>`, for the links in a step card's badge lists. */
  idBase?: string;
}

static const KEY: { kind: Kind; label: string }[] = [
  { kind: "skill", label: "skill" },
  { kind: "reference", label: "file" },
  { kind: "agent", label: "subagent prompt" },
  { kind: "script", label: "tool" },
  { kind: "hook", label: "hook" },
];

<if=input.rows.length>
  <ul class="tree">
    <for|row, i| of=input.rows>
      <tree-row row=row of=input.of rid=(input.idBase === undefined ? undefined : `${input.idBase}:row:${i}`)/>
    </for>
  </ul>
  <p class="tree-key" data-tree-key>
    <for|k| of=KEY>
      <span class="tree-key-item"><kind-icon kind=k.kind/> ${k.label}</span>
    </for>
  </p>
</if>
<else>
  <p class="tree-empty">No parts are listed for this step.</p>
</else>

<style>
  .tree,
  .tree-children {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tree {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }
  .tree-item {
    margin: 0;
    padding: 0.3rem 0 0;
  }
  /* Each root group is a box of its own. */
  .tree-root {
    padding: 0.625rem 0.75rem 0.75rem;
    border: 1px solid var(--edge);
    border-radius: 6px;
    background: var(--surface);
  }
  /* A child hangs from its parent: a vertical line down the parent, a short stroke to each child. */
  .tree-children {
    margin-left: 0.5rem;
  }
  .tree-children > .tree-item {
    position: relative;
    padding-left: 0.9rem;
  }
  .tree-children > .tree-item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    border-left: 1px solid var(--edge);
  }
  .tree-children > .tree-item:last-child::before {
    bottom: auto;
    height: 0.95rem;
  }
  .tree-children > .tree-item::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0.95rem;
    width: 0.7rem;
    border-top: 1px solid var(--edge);
  }
  .tree-empty {
    color: var(--muted);
    font-size: 0.875rem;
  }
  .tree-key {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.3rem 0.875rem;
    max-width: none;
    margin: 1.25rem 0 0;
    padding-top: 0.75rem;
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.75rem;
  }
  .tree-key-item {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
</style>
