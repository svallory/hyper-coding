import type { Row, Source } from "../../model/types";

export interface Input {
  row: Row;
  of?: Source;
}

<const/row=input.row/>
<const/cite=row.cite?.path ? row.cite : undefined/>
<span class="row-line">
  <span class="row-at">
    <if=cite && input.of>
      <source-link of=input.of kind=row.kind as any name=row.name as string
        path=cite.path line=cite.lines variant="slot"/>
    </if>
  </span>
  <span class=`row-name${row.own ? " row-own" : ""}` data-row-name>
    <if=input.of>
      <source-link of=input.of kind=row.kind as any name=row.name as string
        path=row.path word=row.word variant="name"/>
    </if>
    <else>
      <kind-icon kind=row.kind as any/> <span class="ref-name">${row.name}</span>
    </else>
  </span>
  <if=row.count !== undefined><span class="row-count">×${row.count}</span></if>
  <if=row.when><chip tone="when">when</chip> <span class="row-when">${row.when}</span></if>
  <if=row.manual>
    <chip tone="manual">manual</chip> <span class="row-manual">${row.manual}</span>
  </if>
  <if=row.gloss><span class="row-gloss">${row.gloss}</span></if>
  <if=row.by><span class="row-by">by ${row.by}</span></if>
</span>

<style>
  .row-line {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.1rem 0.5rem;
    min-width: 0;
  }
  /* The slot for the line-number link: the same place on every row. */
  .row-at {
    display: inline-block;
    min-width: 3.6ch;
    font-family: var(--mono);
    font-size: 0.6875rem;
    text-align: right;
  }
  .row-at a {
    color: var(--muted);
    text-decoration: none;
  }
  .row-at a:hover,
  .row-at a:focus-visible {
    color: var(--link);
    text-decoration: underline;
  }
  .row-name {
    font-weight: 650;
    overflow-wrap: anywhere;
  }
  .row-name a {
    color: var(--fg);
  }
  .row-own {
    font-stretch: var(--cond);
    font-size: 1.0625rem;
    font-weight: 700;
  }
  .row-count,
  .row-gloss,
  .row-by {
    color: var(--muted);
    font-size: 0.8125rem;
  }
  .row-when,
  .row-manual {
    font-size: 0.8125rem;
  }
</style>
