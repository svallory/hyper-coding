import "./section-table.css";

export interface Input {
  id: string;
  title: string;
  laneHeading: string;
  note?: Marko.AttrTag<{ content?: Marko.Body }>;
  /** One per column, in the order the columns are shown. */
  col?: Marko.AttrTag<{ key: string; content?: Marko.Body }>;
  /** The rows: each lane's `view="cover"`. */
  content?: Marko.Body;
}

<section class="cover-table" id=input.id data-cover-table>
  <h2>${input.title}</h2>
  <if=input.note><p class="defn"><${input.note.content}/></p></if>
  <div class="table-box">
    <table class="cov">
      <thead>
        <tr>
          <th scope="col">${input.laneHeading}</th>
          <for|c| of=input.col><th scope="col" data-col=c.key><${c.content}/></th></for>
        </tr>
      </thead>
      <tbody><${input.content}/></tbody>
    </table>
  </div>
</section>

<style>
  .cov td {
    min-width: 132px;
  }
  .cov td::before {
    content: attr(data-level);
    display: inline-block;
    margin-bottom: 3px;
    padding: 0 8px;
    border: 1px solid var(--fg);
    border-radius: 999px;
    font-size: 0.75rem;
    font-weight: 600;
    line-height: 1.5;
  }
  .cov td[data-level="explicit"]::before {
    background: var(--fg);
    color: var(--surface);
  }
  .cov td[data-level="absent"]::before {
    border-style: dashed;
    border-color: var(--line);
    color: var(--muted);
    font-weight: 500;
  }
  .cov td[data-level] > :first-child {
    display: block;
    color: var(--muted);
    font-size: 0.8125rem;
  }
</style>
