export interface Input {
  /** Names the bar for assistive technology. */
  label: string;
  /** Which page this is; the bar links to the other one. */
  page?: "comparison" | "playbooks";
  /** Lane entries outside any group (each lane's `view="nav"`). */
  content?: Marko.Body;
  /** Titled groups of lane entries; a group with no body renders nothing. */
  group?: Marko.AttrTag<{ title: string; content?: Marko.Body }>;
  /** An entry for a section of the same page. */
  section?: Marko.AttrTag<{ to: string; content?: Marko.Body }>;
}

<const/groups=[...(input.group ?? [])].filter((g) => g.content)/>
<const/sections=[...(input.section ?? [])]/>

<site-nav page=input.page label=input.label>
  <for|g, i| of=groups>
    <if=i><span class="sep" aria-hidden="true"/></if>
    <div class="nav-group" data-nav-group=g.title role="group" aria-label=g.title>
      <${g.content}/>
    </div>
  </for>
  <if=input.content>
    <if=groups.length><span class="sep" aria-hidden="true"/></if>
    <${input.content}/>
  </if>
  <if=sections.length>
    <if=groups.length || input.content><span class="sep" aria-hidden="true"/></if>
    <for|s| of=sections>
      <a data-section-link=s.to href=`#${s.to}`><${s.content}/></a>
    </for>
  </if>
</site-nav>

<style>
  .nav-group {
    display: flex;
    align-items: stretch;
    gap: 1.125rem;
  }
  :root:has(.side-panel[data-open]) .nav-group {
    gap: 0.75rem;
  }
  .site-nav .sep {
    flex: none;
    width: 1px;
    background: var(--line);
    margin-block: 13px;
  }
</style>
