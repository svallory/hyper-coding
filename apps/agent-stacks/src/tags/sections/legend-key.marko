import Icon from "../../components/ui/icon/icon.marko";
import type { Kind } from "../../model/types";

export interface Item {
  swatch?: "plan" | "build" | "check" | "ship" | "learn" | "human";
  icon?: "human" | "warning" | "file" | "code";
  line?: "solid" | "dashed" | "dotted" | "manual";
  marker?: "pick";
  sample?: string;
  content?: Marko.Body;
}

export interface Input {
  label: string;
  /** Titled groups of items. */
  group?: Marko.AttrTag<{ title: string; item?: Marko.AttrTag<Item> }>;
  /** Items outside any group. */
  item?: Marko.AttrTag<Item>;
}

static const ICON_KIND: Record<"file" | "code", Kind> = { file: "reference", code: "script" };

<const/groups=[
  ...[...(input.group ?? [])].map((g) => ({ title: g.title as string | undefined, items: [...(g.item ?? [])] })),
  ...(input.item ? [{ title: undefined as string | undefined, items: [...input.item] }] : []),
]/>

<section class="legend-key" aria-label=input.label>
  <for|g| of=groups>
    <div class=(g.title ? "key-group" : "key-group key-flat")>
      <if=g.title><b>${g.title}</b></if>
      <div class="key-items">
        <for|it| of=g.items>
          <span class="key-entry" data-key-entry>
            <if=it.swatch === "human">
              <i class="key-sw key-sw-human" data-swatch="human"></i>
            </if>
            <else-if=it.swatch>
              <i class="key-sw" data-swatch=it.swatch
                style=`background: var(--${it.swatch}); border-color: var(--${it.swatch}-l)`></i>
            </else-if>
            <if=it.icon === "human">
              <i class="key-human" data-icon="human">
                <Icon name="User" unsized aria-hidden="true"/>
              </i>
            </if>
            <if=it.icon === "warning"><ui-icon id="warning"/></if>
            <if=it.icon === "file" || it.icon === "code"><kind-icon kind=ICON_KIND[it.icon]/></if>
            <if=it.line><i class="key-ln" data-line=it.line></i></if>
            <if=it.line === "manual"><i class="key-man" data-icon="manual"><ui-icon id="manual"/></i></if>
            <if=it.marker === "pick"><i class="key-pick" data-marker="pick"></i></if>
            <if=it.sample><i class="key-sample">${it.sample}</i></if>
            <span><${it.content}/></span>
          </span>
        </for>
      </div>
    </div>
  </for>
</section>

<style>
  .legend-key {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 1rem 2.25rem;
    padding: 1rem 1.125rem;
    margin: 0 0 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 6px;
    font-size: 0.8438rem;
  }
  .key-group {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }
  .key-group > b {
    font-stretch: var(--cond);
    font-weight: 700;
    font-size: 1rem;
    color: var(--fg);
  }
  .key-items {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 1rem;
  }
  .key-flat {
    grid-column: 1 / -1;
  }
  .key-flat .key-items {
    gap: 8px 18px;
    align-items: center;
  }
  .key-entry {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--muted);
  }
  .key-sw {
    flex: none;
    width: 15px;
    height: 14px;
    border-radius: 3px;
    border: 1px solid;
    border-left-width: 4px;
  }
  .key-sw-human {
    border-width: 2px;
    background: var(--surface);
    border-color: var(--fg);
  }
  .key-human {
    flex: none;
    width: 16px;
    height: 16px;
    color: var(--fg);
  }
  .key-human svg {
    width: 16px;
    height: 16px;
    display: block;
  }
  .key-ln {
    flex: none;
    width: 26px;
    height: 0;
    border-top: 1.5px solid var(--edge);
  }
  .key-ln[data-line="dashed"] {
    border-top-style: dashed;
  }
  .key-ln[data-line="dotted"] {
    border-top-style: dotted;
    border-top-width: 2px;
  }
  .key-ln[data-line="manual"] {
    border-top-style: dashed;
    border-top-color: var(--manual);
  }
  /* The manual mark: the person in an orange circle, as on the connector. */
  .key-man {
    display: inline-grid;
    flex: none;
    place-items: center;
    width: 14px;
    height: 14px;
    margin-left: -3px;
    border-radius: 50%;
    background: var(--manual);
    color: var(--when-fg);
  }
  .key-man .ui-icon {
    width: 10px;
    height: 10px;
    vertical-align: baseline;
  }
  .key-pick {
    flex: none;
    width: 8px;
    height: 8px;
    background: var(--accent);
    transform: rotate(45deg);
    margin: 0 3px;
  }
  .key-sample {
    flex: none;
    font-style: normal;
    font-stretch: var(--cond);
    font-weight: 700;
    font-size: 0.8125rem;
    color: var(--fg);
    border-left: 1px solid var(--edge);
    padding-left: 5px;
    line-height: 1.1;
  }
</style>
