export interface Input {
  title: string;
  lede?: Marko.AttrTag<{ content?: Marko.Body }>;
  meta?: Marko.AttrTag<{ content?: Marko.Body }>;
  how?: Marko.AttrTag<{ content?: Marko.Body }>;
}

<header class="page-header" data-page-header>
  <h1>${input.title}</h1>
  <if=input.lede><p class="lede"><${input.lede.content}/></p></if>
  <if=input.meta><p class="meta"><${input.meta.content}/></p></if>
</header>
<if=input.how><p class="how" data-how><${input.how.content}/></p></if>

<style>
  .page-header {
    margin-bottom: 2rem;
  }
  .page-header .meta {
    color: var(--muted);
    font-size: 0.8125rem;
    max-width: 100ch;
    margin: 0;
  }
  .how {
    font-size: 0.9375rem;
    max-width: 80ch;
    margin: 0 0 1rem;
  }
  .how kbd {
    padding: 0 0.35em;
    border-radius: 3px;
    background: var(--fg);
    color: var(--surface);
  }
</style>
